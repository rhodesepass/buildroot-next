// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Copyright (C) 2025 Lukas Schmid <lukas.schmid@netcube.li>
 *
 * Common layer for every ePass Next revision. What varies between boards --
 * key GPIOs, the backlight PWM channel, the panel reset line -- lives in
 * base/devicetree-<rev>.dts instead, and the panel itself in screen/.
 *
 * The mainboard uses EA3036 fixed rails, including 1.8V DDR2 supply.
 */

#include "sun20i-d1s.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/clock/sun20i-d1-ccu.h>
#include <dt-bindings/reset/sun20i-d1-ccu.h>

/ {
	compatible = "rhodesisland,epass-next", "allwinner,sun20i-d1s";

	aliases {
		serial3 = &uart3;
	};

	chosen {
		stdout-path = "serial3:115200n8";
		/*
		 * this bootargs will not work. change bootargs in uboot env!
		 */
		bootargs = "i luv mostima, and paparus maybe?";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x4000000>;	/* 64M in-package DDR2 */
	};

	reg_vcc5v: regulator-5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc-5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	reg_vcc3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		vin-supply = <&reg_vcc5v>;
	};

	reg_vcc_core: regulator-core {
		compatible = "regulator-fixed";
		regulator-name = "vcc-core";
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		vin-supply = <&reg_vcc3v3>;
	};
};

/*
 * Nodes the upstream D1/D1s dtsi does not carry yet. Addresses and interrupt
 * numbers are from the D1-H user manual (sec. 3.1 memory map and the interrupt
 * source table): VE 0x01c0e000/8K irq 81, IOMMU 0x02010000/64K irq 80,
 * PWM 0x02000c00/1K irq 34.
 */
&{/soc} {
	pwm: pwm@2000c00 {
		compatible = "allwinner,sun20i-d1-pwm";
		reg = <0x2000c00 0x400>;
		interrupts = <SOC_PERIPHERAL_IRQ(34) IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&ccu CLK_BUS_PWM>, <&dcxo>, <&ccu CLK_APB0>;
		clock-names = "bus", "hosc", "apb";
		resets = <&ccu RST_BUS_PWM>;
		#pwm-cells = <3>;
		status = "disabled";
	};

	/*
	 * The C906 CLINT lives in M-mode, so Linux never touches it and the
	 * mainline SoC dtsi does not describe it. OpenSBI does need it: without
	 * a node it finds no timer device ("Platform Timer Device: --- @ 0Hz"),
	 * SBI_SET_TIMER silently does nothing, and the kernel loses its tick a
	 * second into boot -- jiffies freeze and every msleep() never returns.
	 */
	clint: timer@14000000 {
		compatible = "thead,c900-clint";
		reg = <0x14000000 0x04000000>;
		interrupts-extended = <&cpu0_intc 3>, <&cpu0_intc 7>;
	};

	/*
	 * No iommu node. The D1 has one, but with DE translated the picture
	 * collapses into full-screen vertical stripes as soon as a second
	 * mixer channel starts fetching -- no fault ever raised, and no
	 * prefetch/OOO/wbuf/auto-gating knob changes it. The vendor kernels
	 * for both D1 and T113 pin DE to bypass (iommus flag 0), so DE behind
	 * the IOMMU is a configuration nobody has ever validated on this
	 * silicon. With DE stuck on physical addresses the VE must stay on
	 * them too (its frames are scanned out directly), which makes the
	 * IOMMU useless here; scanout memory comes from CMA instead.
	 */

	ve: video-codec@1c0e000 {
		compatible = "allwinner,sun20i-d1-video-engine";
		reg = <0x1c0e000 0x2000>;
		/*
		 * PLIC 82 (D1-H manual 中断源表: 80=IOMMU, 81=保留, 82=VE;
		 * BSP 的 sun20iw1p1.dtsi 同样是 <&plic0 82>)。
		 * SOC_PERIPHERAL_IRQ(nr) = nr + 16, 所以这里要写 66 而不是 82 ——
		 * 填 81 会注册到 PLIC 97 那个空号上, 中断永远不来: VE 每帧都解完
		 * 但驱动收不到完成通知, 全靠 cedrus watchdog 2s 后 reset, 表现为
		 * "frame processing timed out!" + 每帧 src/dst 双 ERROR。
		 */
		interrupts = <SOC_PERIPHERAL_IRQ(66) IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&ccu CLK_BUS_VE>, <&ccu CLK_VE>, <&ccu CLK_MBUS_VE>;
		clock-names = "ahb", "mod", "ram";
		resets = <&ccu RST_BUS_VE>;
		status = "disabled";
	};

	/*
	 * The rotate engine sitting inside G2D at +0x28000. This is the very
	 * same IP the mainline sun8i-rotate driver already handles on A83T and
	 * A64, where it lives in the DE instead; the register map is identical
	 * field for field and is documented in the DE2.0 spec section 5.13.
	 * The D1 DE does not have it -- its DE2 clock controller exposes no
	 * CLK_ROT/RST_ROT, and the vendor DE driver rotates framebuffers by
	 * calling into G2D (disp2/disp/fb_g2d_rot.c).
	 *
	 * The second reg range is the G2D TOP block. Only bit 1 there is ours
	 * (rotate gating and soft reset); bit 0 is the G2D mixer, which has no
	 * driver and is deliberately left in reset.
	 *
	 * PLIC 105 = G2D (D1-H manual interrupt vector table; BSP
	 * sun20iw1p1.dtsi agrees). SOC_PERIPHERAL_IRQ(nr) = nr + 16, hence 89 --
	 * same trap as the ve node above.
	 *
	 * No iommus: G2D has no scatter-gather, buffers must be physically
	 * contiguous, which is what CMA gives us.
	 */
	g2d_rotate: rotate@5438000 {
		compatible = "allwinner,sun20i-d1-g2d-rotate";
		reg = <0x5438000 0x1000>,	/* rotate engine */
		      <0x5410000 0x10>;		/* G2D TOP */
		interrupts = <SOC_PERIPHERAL_IRQ(89) IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&ccu CLK_BUS_G2D>, <&ccu CLK_G2D>, <&ccu CLK_MBUS_G2D>;
		clock-names = "bus", "mod", "mbus";
		resets = <&ccu RST_BUS_G2D>;
		/*
		 * 300 MHz is what the vendor driver picks. g2d_clk has no
		 * CLK_SET_RATE_PARENT (ccu-sun20i-d1.c), so this only selects a
		 * divider and will not disturb the video PLL driving the panel:
		 * pll-periph0-2x is 1200 MHz, M=4 lands exactly on 300 MHz.
		 */
		assigned-clocks = <&ccu CLK_G2D>;
		assigned-clock-rates = <300000000>;
		status = "disabled";
	};

	/*
	 * The audio codec is one IP with two halves at adjacent addresses:
	 * the digital DAC/ADC and FIFOs at 0x2030000, and the analog side
	 * -- PGA, headphone amp, mic bias -- at 0x2030300. They are two
	 * nodes because they are two drivers, sun4i-codec and
	 * sun20i-d1-codec-analog, tied together by the phandle below.
	 *
	 * Unlike the older SoCs the analog half is plain MMIO here, not the
	 * ADDA-PR indirect register bus, which is why sun8i-codec-analog
	 * does not drive it.
	 *
	 * Both DMA names point at DRQ 7: the codec has one request line and
	 * the direction is chosen by which FIFO the channel is pointed at.
	 */
	codec: codec@2030000 {
		#sound-dai-cells = <0>;
		compatible = "allwinner,sun20i-d1-codec";
		reg = <0x2030000 0x300>;
		interrupts = <SOC_PERIPHERAL_IRQ(25) IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&ccu CLK_BUS_AUDIO>, <&ccu CLK_AUDIO_ADC>,
			 <&ccu CLK_AUDIO_DAC>;
		clock-names = "apb", "adc", "dac";
		resets = <&ccu RST_BUS_AUDIO>;
		dmas = <&dma 7>, <&dma 7>;
		dma-names = "rx", "tx";
		allwinner,codec-analog-controls = <&codec_analog>;
		status = "disabled";
	};

	codec_analog: codec-analog@2030300 {
		compatible = "allwinner,sun20i-d1-codec-analog";
		reg = <0x2030300 0xd00>;
		status = "disabled";
	};
};

&cpu0 {
	cpu-supply = <&reg_vcc_core>;
};

&dcxo {
	clock-frequency = <24000000>;
};

&pio {
	vcc-pb-supply = <&reg_vcc3v3>;
	vcc-pc-supply = <&reg_vcc3v3>;
	vcc-pd-supply = <&reg_vcc3v3>;
	vcc-pe-supply = <&reg_vcc3v3>;
	vcc-pf-supply = <&reg_vcc3v3>;
	vcc-pg-supply = <&reg_vcc3v3>;

	dsi_3lane_pins: dsi-3lane-pins {
		pins = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7";
		function = "dsi";
		drive-strength = <30>;
	};
	uart3_pg_pins: uart3-pg-pins {
		pins = "PG8", "PG9";
		function = "uart3";
	};
	/omit-if-no-ref/
	i2c2_pg_pins: i2c2-pg-pins {
		pins = "PG6", "PG7";
		function = "i2c2";
	};

	/omit-if-no-ref/
	pwm5_pg_pin: pwm5-pg-pin {
		pins = "PG4";
		function = "pwm5";
	};

	/* CS, WP and HOLD need pull-ups while the bus is idle. */
	spi1_quad_pins: spi1-quad-pins {
		pins = "PD11", "PD12", "PD13";
		function = "spi1";
		drive-strength = <20>;
	};

	spi1_quad_pu_pins: spi1-quad-pu-pins {
		pins = "PD10", "PD15", "PD14";
		function = "spi1";
		drive-strength = <20>;
		bias-pull-up;
	};
};

/* n0.2 selects GPIO I2C to match the FPC SCL/SDA pin order. */
&i2c2 {
	pinctrl-0 = <&i2c2_pg_pins>;
	pinctrl-names = "default";
	clock-frequency = <100000>;
	status = "okay";
};

&pwm {
	pinctrl-0 = <&pwm5_pg_pin>;
	pinctrl-names = "default";
	status = "okay";
};

/* --- display: DE2.0 -> mixer0 -> tcon_top -> tcon_lcd0 -> dsi --- */
&de {
	status = "okay";
};

&tcon_top {
	status = "okay";
};

&tcon_lcd0 {
	status = "okay";
};

&dphy {
	status = "okay";
};

&dsi {
	/* DSI is a bus: the panel's reg is a virtual channel, not an address */
	#address-cells = <1>;
	#size-cells = <0>;

	pinctrl-0 = <&dsi_3lane_pins>;
	pinctrl-names = "default";
	status = "okay";

};

/* --- video decode --- */
&ve {
	status = "okay";
};

&g2d_rotate {
	status = "okay";
};

/* --- audio --- */
&codec {
	/*
	 * "Headphone" is the card-level jack widget, "HP" the analog half's
	 * output. Everything else on the codec -- line in, mic2, the DMICs --
	 * is not wired on this board, and fully_routed keeps those paths
	 * powered down.
	 */
	allwinner,audio-routing = "Headphone", "HP";
	status = "okay";
};

&codec_analog {
	status = "okay";
};

&mmc0 {
	pinctrl-0 = <&mmc0_pins>;
	pinctrl-names = "default";
	vmmc-supply = <&reg_vcc3v3>;
	/*
	 * broken-cd rather than cd-gpios: the slot's detect pin is not wired
	 * to the SoC, so the core has to poll for a card instead.
	 */
	broken-cd;
	disable-wp;
	bus-width = <4>;
	status = "okay";
};

&spi1 {
	pinctrl-0 = <&spi1_quad_pins>, <&spi1_quad_pu_pins>;
	pinctrl-names = "default";
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		/*
		 * The board is intentionally back on its 100MHz QIO baseline.
		 * Intermittent UBIFS read corruption and the follow-up tests are
		 * recorded in docs/ubifs-transient-read-followup.md.
		 * Keep this file in sync with the kernel tree board dts -- THIS
		 * copy is what mkdt.sh builds into the flashed dtbs.itb.
		 */
		spi-max-frequency = <100000000>;

		/*
		 * Without these the bus width never leaves 1: spi->mode gets
		 * SPI_RX_QUAD/SPI_TX_QUAD from nowhere else, spi_mem_supports_op
		 * then rejects every x2/x4 entry in the chip's variant table,
		 * and spinand silently settles on the 1S-1S-1S read. The
		 * controller has had the QUAD_EN bit wired up all along.
		 */
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;

		/*
		 * 128MB, 2K page, 128K erase block; every boundary below is a
		 * whole number of erase blocks.
		 *
		 * rootfs and data are deliberately separate MTD partitions
		 * rather than two volumes of one UBI device: reflashing writes
		 * rootfs and never touches data, which is what makes an upgrade
		 * keep the user's data. rootfs carries a read-only UBIFS that
		 * is the overlay lower; data carries the writable upper and
		 * work directories. See preinit.
		 *
		 * Keep this table identical to the one in the U-Boot board dts
		 * -- nothing checks that they agree.
		 */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "boot0";
				reg = <0x0 0x40000>;	/* 256K */
				read-only;
			};

			partition@40000 {
				label = "uboot";
				/* u-boot.itb: OpenSBI fw_dynamic + U-Boot */
				reg = <0x40000 0x100000>;	/* 1M */
				read-only;
			};

			partition@140000 {
				/* one erase block, holding env.txt */
				label = "bootenv";
				reg = <0x140000 0x20000>;	/* 128K */
			};

			partition@160000 {
				/*
				 * One partition holding two FITs, the way the
				 * F1C boards do it and the way the flasher
				 * expects: dtbs.itb in a 1M slot at the start,
				 * kernel.itb right after it. Keeping them in
				 * one partition means one DFU alt setting and
				 * one image to hand the flasher.
				 */
				label = "boot";
				reg = <0x160000 0xa00000>;	/* 10M */
			};

			partition@b60000 {
				/* ubi0, one 24M volume: the read-only system */
				label = "rootfs";
				reg = <0xb60000 0x1c00000>;	/* 28M */
			};

			partition@2760000 {
				/* ubi1, rootfs_data: overlay upper + work */
				label = "data";
				reg = <0x2760000 0x58a0000>;	/* 88.6M */
			};
		};
	};
};

&uart3 {
	pinctrl-0 = <&uart3_pg_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&usb_otg {
	dr_mode = "peripheral";
	status = "okay";
};

&usbphy {
	usb0_vbus-supply = <&reg_vcc5v>;
	status = "okay";
};

&ehci1 {
	status = "disabled";
};

&ohci1 {
	status = "disabled";
};

&wdt {
	status = "okay";
};

/*
 * The sunxi timer's clockevent outranks the riscv/SBI one (350 vs 100), so it
 * wins the tick device -- but it sits on PLIC irq 59, which never fires on this
 * board. jiffies then freeze a second into boot and every msleep() hangs, with
 * no oops and no hung-task report to show for it. Use SBI_SET_TIMER instead.
 */
&timer {
	status = "disabled";
};
