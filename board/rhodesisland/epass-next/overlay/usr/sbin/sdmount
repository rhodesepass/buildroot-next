#!/bin/sh
#
# /sd 挂载唯一入口: S01app 与 mdev 热插拔都走这里, flock 串行化
# 用法: sdmount mount|umount|remount
#
# 从 F1C 板原样搬来。本板目前只有 NAND 启动这一条路径成立(root 恒为 ubi),
# 卡槽是插着能用的外置卡 —— mmc0 使能且 broken-cd 轮询。SD 启动那一支的
# 分区约定照抄 F1C, 等本板真做 SD 启动时按实际分区表复核。

LOCK=/var/run/sdmount.lock
[ "$SDMOUNT_LOCKED" ] || { SDMOUNT_LOCKED=1 exec flock "$LOCK" "$0" "$@"; }

# NAND 启动时外置 SD 卡是 mmcblk0p1;
# SD 启动时系统本身在 SD 上, /sd 对应第四个 share 分区
# (p3 是 overlay 数据分区, 归 preinit 管)
sd_dev() {
    if grep -q 'root=/dev/mmcblk0p2' /proc/cmdline; then
        echo /dev/mmcblk0p4
    else
        echo /dev/mmcblk0p1
    fi
}

# 拔卡后的死挂载可能叠了多层, 循环 lazy umount, 上限防死循环
do_umount() {
    n=0
    while grep -q ' /sd ' /proc/mounts && [ $n -lt 10 ]; do
        umount -l /sd 2> /dev/null || break
        n=$((n + 1))
    done
    umount -l "$(sd_dev)" 2> /dev/null
    return 0
}

do_mount() {
    DEV=$(sd_dev)
    mkdir -p /sd
    [ -b "$DEV" ] || return 1
    mount -o iocharset=utf8 "$DEV" /sd && mkdir -p /sd/app /sd/assets
}

case "$1" in
    mount) do_mount ;;
    umount) do_umount ;;
    remount)
        do_umount
        do_mount
        ;;
    *)
        echo "Usage: $0 {mount|umount|remount}"
        exit 1
        ;;
esac
