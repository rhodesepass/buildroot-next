From: Shirogane Tsumugi <artoriapendragon123@gmail.com>
Subject: [PATCH] spi: sun6i: run spi-mem read ops as a single burst

Reading one 2048 byte NAND page takes ~1.8ms on the D1s, of which only
~130us is spent moving data on the wire (quad, 40MHz SCLK). Counting the
SPI interrupts over a bulk read shows why: about twelve per page. The
generic spi-mem path emits every op as separate cmd/addr/dummy/data
transfers, each costing a full XCH plus an interrupt round trip, and the
D1 pays a second toll the F1C never did: with the divider in the CCU
(has_clk_ctl unset) every one of those transfers goes through
clk_set_rate() and the clk framework's global prepare mutex.

The controller can do a whole read op in one exchange, which is what the
MTC/STC fields exist for: it sends STC bytes on a single line, then turns
the bus around and clocks in the remainder, over two or four lines when
DRM/QUAD_EN is set. This is the same scheme the F1C port has shipped for
a while (0026-spi-sun6i-mem-exec-op there) and the same one the vendor
driver builds every wide transfer from (spi_set_bc_tc_stc()); the D1
additions are the QUAD_EN path, a supports_op that steers the upper
layers away from wide-address variants (1S-4S-4S) the single-line header
cannot express -- otherwise spinand selects them and every read falls
back to the slow path -- and a cached mod-clock rate so repeated ops at
the same speed skip the clk framework entirely.

The dummy cycles are emitted as ordinary header bytes rather than through
BCC.DBC. DHB discards MTC bytes of echo, so folding the dummy into the
header keeps the discarded count equal to the full header and leaves the
RX FIFO holding the payload alone.

Both the new path and transfer_one now also check the RX FIFO overflow
flag, which the driver used to ignore entirely. An overflow drops bytes
and shifts everything after them, which no ECC downstream can catch --
the flash streamed correct data and passed its own ECC, the FIFO lost
bytes on the way to memory. Under MBUS contention (VE decode plus DE
scanout against a 32-byte FIFO slack) this is silent data corruption;
now it fails the transfer with -EIO and a warning instead.

Writes stay on the generic path: a written payload would have to share
the TX FIFO with the header, transfer_one already drives QUAD_EN for
them, and NAND program throughput is bounded by tPROG anyway. Ops that
do not fit return -EOPNOTSUPP and the core falls back.

Signed-off-by: Shirogane Tsumugi <artoriapendragon123@gmail.com>

---
diff --git a/drivers/spi/spi-sun6i.c b/drivers/spi/spi-sun6i.c
index 5ac73d324..53fecd0b3 100644
--- a/drivers/spi/spi-sun6i.c
+++ b/drivers/spi/spi-sun6i.c
@@ -21,12 +21,16 @@
 #include <linux/dmaengine.h>
 
 #include <linux/spi/spi.h>
+#include <linux/spi/spi-mem.h>
 
 #define SUN6I_AUTOSUSPEND_TIMEOUT	2000
 
 #define SUN6I_FIFO_DEPTH		128
 #define SUN8I_FIFO_DEPTH		64
 
+/* Longest cmd + addr + dummy an op may have and still be run as one burst */
+#define SUN6I_OP_HDR_MAX		16
+
 #define SUN6I_GBL_CTL_REG		0x04
 #define SUN6I_GBL_CTL_BUS_ENABLE		BIT(0)
 #define SUN6I_GBL_CTL_MASTER			BIT(1)
@@ -112,6 +116,15 @@ struct sun6i_spi {
 	u8			*rx_buf;
 	int			len;
 	const struct sun6i_spi_cfg *cfg;
+
+	/*
+	 * On the SoCs whose divider lives in the CCU, clk_set_rate() takes the
+	 * global prepare mutex and rewrites the mod clock on every transfer.
+	 * A NAND page read is four ops at the same rate, so remember what the
+	 * clock was last asked for and skip the framework when it matches.
+	 */
+	unsigned int		cached_speed_hz;
+	unsigned int		cached_effective_hz;
 };
 
 static inline u32 sun6i_spi_read(struct sun6i_spi *sspi, u32 reg)
@@ -201,6 +214,79 @@ static size_t sun6i_spi_max_transfer_size(struct spi_device *spi)
 	return SUN6I_MAX_XFER_SIZE - 1;
 }
 
+static unsigned int sun6i_spi_setup_clock(struct sun6i_spi *sspi,
+					  unsigned int speed_hz)
+{
+	unsigned int effective_speed_hz;
+	u32 reg;
+
+	if (sspi->cfg->has_clk_ctl) {
+		unsigned int div, div_cdr1, div_cdr2;
+		unsigned int mclk_rate = clk_get_rate(sspi->mclk);
+
+		/* Ensure that we have a parent clock fast enough */
+		if (mclk_rate < (2 * speed_hz)) {
+			clk_set_rate(sspi->mclk, 2 * speed_hz);
+			mclk_rate = clk_get_rate(sspi->mclk);
+		}
+
+		/*
+		 * Setup clock divider.
+		 *
+		 * We have two choices there. Either we can use the clock
+		 * divide rate 1, which is calculated thanks to this formula:
+		 * SPI_CLK = MOD_CLK / (2 ^ cdr)
+		 * Or we can use CDR2, which is calculated with the formula:
+		 * SPI_CLK = MOD_CLK / (2 * (cdr + 1))
+		 * Wether we use the former or the latter is set through the
+		 * DRS bit.
+		 *
+		 * First try CDR2, and if we can't reach the expected
+		 * frequency, fall back to CDR1.
+		 */
+		div_cdr1 = DIV_ROUND_UP(mclk_rate, speed_hz);
+		div_cdr2 = DIV_ROUND_UP(div_cdr1, 2);
+		if (div_cdr2 <= (SUN6I_CLK_CTL_CDR2_MASK + 1)) {
+			reg = SUN6I_CLK_CTL_CDR2(div_cdr2 - 1) | SUN6I_CLK_CTL_DRS;
+			effective_speed_hz = mclk_rate / (2 * div_cdr2);
+		} else {
+			div = min(SUN6I_CLK_CTL_CDR1_MASK, order_base_2(div_cdr1));
+			reg = SUN6I_CLK_CTL_CDR1(div);
+			effective_speed_hz = mclk_rate / (1 << div);
+		}
+
+		sun6i_spi_write(sspi, SUN6I_CLK_CTL_REG, reg);
+	} else {
+		if (speed_hz != sspi->cached_speed_hz) {
+			clk_set_rate(sspi->mclk, speed_hz);
+			sspi->cached_effective_hz = clk_get_rate(sspi->mclk);
+			sspi->cached_speed_hz = speed_hz;
+		}
+		effective_speed_hz = sspi->cached_effective_hz;
+
+		/*
+		 * Configure work mode.
+		 *
+		 * There are three work modes depending on the controller clock
+		 * frequency:
+		 * - normal sample mode           : CLK <= 24MHz SDM=1 SDC=0
+		 * - delay half-cycle sample mode : CLK <= 40MHz SDM=0 SDC=0
+		 * - delay one-cycle sample mode  : CLK >= 80MHz SDM=0 SDC=1
+		 */
+		reg = sun6i_spi_read(sspi, SUN6I_TFR_CTL_REG);
+		reg &= ~(SUN6I_TFR_CTL_SDM | SUN6I_TFR_CTL_SDC);
+
+		if (effective_speed_hz <= 24000000)
+			reg |= SUN6I_TFR_CTL_SDM;
+		else if (effective_speed_hz >= 80000000)
+			reg |= SUN6I_TFR_CTL_SDC;
+
+		sun6i_spi_write(sspi, SUN6I_TFR_CTL_REG, reg);
+	}
+
+	return effective_speed_hz;
+}
+
 static void sun6i_spi_dma_rx_cb(void *param)
 {
 	struct sun6i_spi *sspi = param;
@@ -277,7 +363,6 @@ static int sun6i_spi_transfer_one(struct spi_controller *host,
 				  struct spi_transfer *tfr)
 {
 	struct sun6i_spi *sspi = spi_controller_get_devdata(host);
-	unsigned int div, div_cdr1, div_cdr2;
 	unsigned long time_left;
 	unsigned int start, end, tx_time;
 	unsigned int trig_level;
@@ -369,64 +454,7 @@ static int sun6i_spi_transfer_one(struct spi_controller *host,
 
 	sun6i_spi_write(sspi, SUN6I_TFR_CTL_REG, reg);
 
-	if (sspi->cfg->has_clk_ctl) {
-		unsigned int mclk_rate = clk_get_rate(sspi->mclk);
-
-		/* Ensure that we have a parent clock fast enough */
-		if (mclk_rate < (2 * tfr->speed_hz)) {
-			clk_set_rate(sspi->mclk, 2 * tfr->speed_hz);
-			mclk_rate = clk_get_rate(sspi->mclk);
-		}
-
-		/*
-		 * Setup clock divider.
-		 *
-		 * We have two choices there. Either we can use the clock
-		 * divide rate 1, which is calculated thanks to this formula:
-		 * SPI_CLK = MOD_CLK / (2 ^ cdr)
-		 * Or we can use CDR2, which is calculated with the formula:
-		 * SPI_CLK = MOD_CLK / (2 * (cdr + 1))
-		 * Wether we use the former or the latter is set through the
-		 * DRS bit.
-		 *
-		 * First try CDR2, and if we can't reach the expected
-		 * frequency, fall back to CDR1.
-		 */
-		div_cdr1 = DIV_ROUND_UP(mclk_rate, tfr->speed_hz);
-		div_cdr2 = DIV_ROUND_UP(div_cdr1, 2);
-		if (div_cdr2 <= (SUN6I_CLK_CTL_CDR2_MASK + 1)) {
-			reg = SUN6I_CLK_CTL_CDR2(div_cdr2 - 1) | SUN6I_CLK_CTL_DRS;
-			tfr->effective_speed_hz = mclk_rate / (2 * div_cdr2);
-		} else {
-			div = min(SUN6I_CLK_CTL_CDR1_MASK, order_base_2(div_cdr1));
-			reg = SUN6I_CLK_CTL_CDR1(div);
-			tfr->effective_speed_hz = mclk_rate / (1 << div);
-		}
-
-		sun6i_spi_write(sspi, SUN6I_CLK_CTL_REG, reg);
-	} else {
-		clk_set_rate(sspi->mclk, tfr->speed_hz);
-		tfr->effective_speed_hz = clk_get_rate(sspi->mclk);
-
-		/*
-		 * Configure work mode.
-		 *
-		 * There are three work modes depending on the controller clock
-		 * frequency:
-		 * - normal sample mode           : CLK <= 24MHz SDM=1 SDC=0
-		 * - delay half-cycle sample mode : CLK <= 40MHz SDM=0 SDC=0
-		 * - delay one-cycle sample mode  : CLK >= 80MHz SDM=0 SDC=1
-		 */
-		reg = sun6i_spi_read(sspi, SUN6I_TFR_CTL_REG);
-		reg &= ~(SUN6I_TFR_CTL_SDM | SUN6I_TFR_CTL_SDC);
-
-		if (tfr->effective_speed_hz <= 24000000)
-			reg |= SUN6I_TFR_CTL_SDM;
-		else if (tfr->effective_speed_hz >= 80000000)
-			reg |= SUN6I_TFR_CTL_SDC;
-
-		sun6i_spi_write(sspi, SUN6I_TFR_CTL_REG, reg);
-	}
+	tfr->effective_speed_hz = sun6i_spi_setup_clock(sspi, tfr->speed_hz);
 
 	/* Finally enable the bus - doing so before might raise SCK to HIGH */
 	reg = sun6i_spi_read(sspi, SUN6I_GBL_CTL_REG);
@@ -516,6 +544,18 @@ static int sun6i_spi_transfer_one(struct spi_controller *host,
 		ret = -ETIMEDOUT;
 	}
 
+	/*
+	 * An RX FIFO overflow silently drops bytes: everything after the drop
+	 * arrives shifted, and no ECC downstream can tell -- the slave sent
+	 * the right data, the FIFO lost it. Fail the transfer instead.
+	 */
+	if (rx_len &&
+	    sun6i_spi_read(sspi, SUN6I_INT_STA_REG) & SUN6I_INT_CTL_RF_OVF) {
+		dev_warn(&host->dev, "%s: RX FIFO overflow, %u byte transfer",
+			 dev_name(&spi->dev), tfr->len);
+		ret = -EIO;
+	}
+
 	sun6i_spi_write(sspi, SUN6I_INT_CTL_REG, 0);
 
 	if (ret && use_dma) {
@@ -526,6 +566,290 @@ static int sun6i_spi_transfer_one(struct spi_controller *host,
 	return ret;
 }
 
+/*
+ * set_cs() is the callback the SPI core drives, and the core hands it the
+ * inverted level (see spi_set_cs()). exec_op() owns the chip select itself,
+ * so it has to reproduce that inversion rather than call set_cs() directly.
+ */
+static void sun6i_spi_mem_set_cs(struct spi_device *spi, bool activate)
+{
+	bool level = !!(spi->mode & SPI_CS_HIGH);
+
+	sun6i_spi_set_cs(spi, activate ? level : !level);
+}
+
+/*
+ * A read op maps onto a single burst: the controller sends STC bytes on one
+ * line, then turns the bus around and clocks the rest in, over two or four
+ * lines when DRM/QUAD_EN is set. Letting the generic spi-mem path split that
+ * into four transfers costs four interrupt round trips, which on these SoCs
+ * dwarfs the time actually spent on the wire, so drive the whole op from one
+ * exchange instead.
+ *
+ * The dummy cycles are emitted as ordinary header bytes rather than through
+ * BCC.DBC: that keeps the count discarded by DHB (which is MTC) equal to the
+ * whole header, so the RX FIFO ends up holding the payload and nothing else.
+ */
+static int sun6i_spi_exec_op_once(struct spi_mem *mem,
+				  const struct spi_mem_op *op,
+				  const u8 *hdr, unsigned int hdr_len,
+				  unsigned int rx_len, unsigned int speed_hz,
+				  bool use_dma, struct sg_table *sgt)
+{
+	struct spi_device *spi = mem->spi;
+	struct spi_controller *host = spi->controller;
+	struct sun6i_spi *sspi = spi_controller_get_devdata(host);
+	struct dma_async_tx_descriptor *rxdesc;
+	unsigned int tx_time;
+	unsigned long time_left;
+	int i, ret = 0;
+	u32 reg;
+
+	reinit_completion(&sspi->done);
+	reinit_completion(&sspi->dma_rx_done);
+	sspi->tx_buf = NULL;
+	sspi->rx_buf = rx_len ? op->data.buf.in : NULL;
+	sspi->len = 0;
+
+	/* Clear pending interrupts */
+	sun6i_spi_write(sspi, SUN6I_INT_STA_REG, ~0);
+
+	/* Reset FIFO */
+	sun6i_spi_write(sspi, SUN6I_FIFO_CTL_REG,
+			SUN6I_FIFO_CTL_RF_RST | SUN6I_FIFO_CTL_TF_RST);
+
+	reg = 0;
+	if (use_dma)
+		reg |= (1 << SUN6I_FIFO_CTL_RF_RDY_TRIG_LEVEL_BITS) |
+		       SUN6I_FIFO_CTL_RF_DRQ_EN;
+	sun6i_spi_write(sspi, SUN6I_FIFO_CTL_REG, reg);
+
+	reg = sun6i_spi_read(sspi, SUN6I_TFR_CTL_REG);
+
+	if (spi->mode & SPI_CPOL)
+		reg |= SUN6I_TFR_CTL_CPOL;
+	else
+		reg &= ~SUN6I_TFR_CTL_CPOL;
+
+	if (spi->mode & SPI_CPHA)
+		reg |= SUN6I_TFR_CTL_CPHA;
+	else
+		reg &= ~SUN6I_TFR_CTL_CPHA;
+
+	if (spi->mode & SPI_LSB_FIRST)
+		reg |= SUN6I_TFR_CTL_FBS;
+	else
+		reg &= ~SUN6I_TFR_CTL_FBS;
+
+	/* Drop what the slave echoed back while the header went out */
+	reg |= SUN6I_TFR_CTL_DHB | SUN6I_TFR_CTL_CS_MANUAL;
+
+	sun6i_spi_write(sspi, SUN6I_TFR_CTL_REG, reg);
+
+	sun6i_spi_setup_clock(sspi, speed_hz);
+
+	/* Finally enable the bus - doing so before might raise SCK to HIGH */
+	reg = sun6i_spi_read(sspi, SUN6I_GBL_CTL_REG);
+	reg |= SUN6I_GBL_CTL_BUS_ENABLE;
+	sun6i_spi_write(sspi, SUN6I_GBL_CTL_REG, reg);
+
+	sun6i_spi_write(sspi, SUN6I_BURST_CNT_REG, hdr_len + rx_len);
+	sun6i_spi_write(sspi, SUN6I_XMIT_CNT_REG, hdr_len);
+
+	reg = FIELD_PREP(SUN6I_BURST_CTL_CNT_STC_MASK, hdr_len);
+	if (rx_len && op->data.buswidth == 2)
+		reg |= SUN6I_BURST_CTL_CNT_DRM;
+	else if (rx_len && op->data.buswidth == 4)
+		reg |= SUN6I_BURST_CTL_CNT_QUAD_EN;
+	sun6i_spi_write(sspi, SUN6I_BURST_CTL_CNT_REG, reg);
+
+	for (i = 0; i < hdr_len; i++)
+		writeb(hdr[i], sspi->base_addr + SUN6I_TXDATA_REG);
+
+	if (use_dma) {
+		struct dma_slave_config rxconf = {
+			.direction = DMA_DEV_TO_MEM,
+			.src_addr = sspi->dma_addr_rx,
+			.src_addr_width = DMA_SLAVE_BUSWIDTH_1_BYTE,
+			.src_maxburst = 1,
+		};
+
+		dmaengine_slave_config(host->dma_rx, &rxconf);
+
+		rxdesc = dmaengine_prep_slave_sg(host->dma_rx, sgt->sgl,
+						 sgt->nents, DMA_DEV_TO_MEM,
+						 DMA_PREP_INTERRUPT);
+		if (!rxdesc)
+			return -EINVAL;
+
+		rxdesc->callback_param = sspi;
+		rxdesc->callback = sun6i_spi_dma_rx_cb;
+		dmaengine_submit(rxdesc);
+		dma_async_issue_pending(host->dma_rx);
+	}
+
+	sun6i_spi_write(sspi, SUN6I_INT_CTL_REG, SUN6I_INT_CTL_TC);
+
+	sun6i_spi_mem_set_cs(spi, true);
+
+	reg = sun6i_spi_read(sspi, SUN6I_TFR_CTL_REG);
+	sun6i_spi_write(sspi, SUN6I_TFR_CTL_REG, reg | SUN6I_TFR_CTL_XCH);
+
+	tx_time = max((hdr_len + rx_len) * 8 * 2 /
+		      (speed_hz / 1000), 100U);
+	time_left = wait_for_completion_timeout(&sspi->done,
+						msecs_to_jiffies(tx_time));
+
+	if (use_dma && time_left && rx_len) {
+		/*
+		 * Even though RX on the peripheral side has finished
+		 * RX DMA might still be in flight
+		 */
+		time_left = wait_for_completion_timeout(&sspi->dma_rx_done,
+							time_left);
+		if (!time_left)
+			dev_warn(&host->dev, "RX DMA timeout\n");
+	}
+
+	if (!use_dma && time_left)
+		sun6i_spi_drain_fifo(sspi);
+
+	if (!time_left) {
+		dev_warn(&host->dev, "%s: timeout on %u byte op %#02x",
+			 dev_name(&spi->dev), hdr_len + rx_len, op->cmd.opcode);
+		ret = -ETIMEDOUT;
+	}
+
+	/*
+	 * A dropped byte shifts everything after it, and the flash's ECC
+	 * cannot catch that -- the chip streamed the right data, the FIFO
+	 * lost it. Turn it into a hard error instead of corrupt payload.
+	 */
+	if (!ret &&
+	    sun6i_spi_read(sspi, SUN6I_INT_STA_REG) & SUN6I_INT_CTL_RF_OVF) {
+		dev_warn(&host->dev, "%s: RX FIFO overflow on op %#02x",
+			 dev_name(&spi->dev), op->cmd.opcode);
+		ret = -EIO;
+	}
+
+	sun6i_spi_mem_set_cs(spi, false);
+	sun6i_spi_write(sspi, SUN6I_INT_CTL_REG, 0);
+
+	if (ret && use_dma)
+		dmaengine_terminate_sync(host->dma_rx);
+
+	return ret;
+}
+
+static int sun6i_spi_exec_op(struct spi_mem *mem, const struct spi_mem_op *op)
+{
+	struct spi_device *spi = mem->spi;
+	struct spi_controller *host = spi->controller;
+	struct sun6i_spi *sspi = spi_controller_get_devdata(host);
+	unsigned int hdr_len, rx_len = 0, speed_hz;
+	struct sg_table sgt = { };
+	u8 hdr[SUN6I_OP_HDR_MAX];
+	bool use_dma = false;
+	int i, attempt, ret;
+
+	/*
+	 * Only the read direction can be folded into one burst: there is no
+	 * way to widen the header, and a written payload would have to share
+	 * the TX FIFO with it. Everything else falls back to the generic
+	 * path, which handles wide writes through transfer_one() already.
+	 */
+	if (op->cmd.buswidth != 1 || op->data.dir == SPI_MEM_DATA_OUT)
+		return -EOPNOTSUPP;
+	if (op->addr.nbytes && op->addr.buswidth != 1)
+		return -EOPNOTSUPP;
+	if (op->dummy.nbytes && op->dummy.buswidth != 1)
+		return -EOPNOTSUPP;
+
+	hdr_len = 1 + op->addr.nbytes + op->dummy.nbytes;
+	if (hdr_len > sizeof(hdr))
+		return -EOPNOTSUPP;
+
+	if (op->data.dir == SPI_MEM_DATA_IN) {
+		if (op->data.buswidth != 1 && op->data.buswidth != 2 &&
+		    op->data.buswidth != 4)
+			return -EOPNOTSUPP;
+		rx_len = op->data.nbytes;
+	}
+
+	if (hdr_len + rx_len > SUN6I_MAX_XFER_SIZE)
+		return -EOPNOTSUPP;
+
+	/*
+	 * Without DMA the payload would need the RX_RDY watermark interrupts
+	 * the generic path already implements, so leave those ops to it.
+	 */
+	if (rx_len > sspi->cfg->fifo_depth) {
+		if (!host->dma_rx)
+			return -EOPNOTSUPP;
+
+		ret = spi_controller_dma_map_mem_op_data(host, op, &sgt);
+		if (ret)
+			return -EOPNOTSUPP;
+
+		use_dma = true;
+	}
+
+	hdr[0] = op->cmd.opcode;
+	for (i = 0; i < op->addr.nbytes; i++)
+		hdr[i + 1] = op->addr.val >> (8 * (op->addr.nbytes - i - 1));
+	memset(hdr + 1 + op->addr.nbytes, 0xff, op->dummy.nbytes);
+
+	speed_hz = spi->max_speed_hz;
+	if (op->max_freq && op->max_freq < speed_hz)
+		speed_hz = op->max_freq;
+
+	/*
+	 * A read has no side effect on the flash, so an attempt lost to an
+	 * RX FIFO overflow can simply be run again from a clean FIFO.
+	 */
+	for (attempt = 0; attempt < 3; attempt++) {
+		ret = sun6i_spi_exec_op_once(mem, op, hdr, hdr_len, rx_len,
+					     speed_hz, use_dma, &sgt);
+		if (ret != -EIO)
+			break;
+	}
+
+	if (use_dma)
+		spi_controller_dma_unmap_mem_op_data(host, op, &sgt);
+
+	return ret;
+}
+
+/*
+ * The single-burst path can only emit the header on one line. Turning the
+ * wide-address read variants down here (e.g. 1S-4S-4S) makes the upper
+ * layers settle on their 1S-1S-xS equivalents, which run as one burst
+ * instead of falling back to the four-transfer generic path -- same wire
+ * throughput on the payload, a fraction of the op overhead.
+ */
+static bool sun6i_spi_supports_op(struct spi_mem *mem,
+				  const struct spi_mem_op *op)
+{
+	if (!spi_mem_default_supports_op(mem, op))
+		return false;
+
+	if (op->data.dir == SPI_MEM_DATA_IN) {
+		if (op->cmd.buswidth != 1)
+			return false;
+		if (op->addr.nbytes && op->addr.buswidth != 1)
+			return false;
+		if (op->dummy.nbytes && op->dummy.buswidth != 1)
+			return false;
+	}
+
+	return true;
+}
+
+static const struct spi_controller_mem_ops sun6i_spi_mem_ops = {
+	.supports_op		= sun6i_spi_supports_op,
+	.exec_op		= sun6i_spi_exec_op,
+};
+
