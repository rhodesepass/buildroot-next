From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shirogane <artoriapendragon123@gmail.com>
Subject: [PATCH 10/13] drm/sun4i: support indexed (C8) layers on the D1/T113
 DE2

The D1/T113 generation of DE2 can treat a UI layer's framebuffer as
indices into a 256-entry ARGB8888 palette, which quarters the scanout
bandwidth and the buffer size against ARGB8888 and gives every index its
own alpha. Neither the DE2.0 spec nor the D1-H manual documents the
registers -- the spec predates the feature and the manual only lists
"palette" among the input formats -- so the following was established by
poking the hardware and watching the panel:

  - layer attribute FBFMT 27 (0x1b) selects 8-bit indices;
  - the palette RAM is 256 words at channel base + 0x400, ARGB8888;
  - it is write-only, always reading back as zero;
  - attribute bit 3 opens the CPU's write port to it. It is a
    channel-level switch living in overlay 0's word, and it gates writes
    only: leaving it set disturbs neither indexed nor ordinary scanout;
  - writes are also dropped unless that overlay is enabled -- and the
    enable that counts is the one the last dbuff cycle *latched*, not
    what a commit just put in the shadow registers. A readback cannot
    tell the two apart (it returns the shadow value), and with the RAM
    write-only a swallowed upload is undetectable after the fact. This
    is presumably why the vendor driver only ever touches the RAM from
    its vsync-synchronised update path.

Since the palette belongs to the channel and not to any one plane -- the
four UI overlays index the same table -- it is a device attribute rather
than a plane property, which also means four planes sharing one table is
simply what the hardware is, not a conflict to arbitrate. Userspace
writes 1024 bytes of little-endian ARGB8888 to

  /sys/devices/platform/soc/5100000.mixer/palette

The latched-enable gating dictates the vendor BSP's structure: a single
writer. Writes to the sysfs file only update a shadow copy (which also
answers reads) and mark it dirty; every hardware access happens in
sun8i_mixer_commit(), where the atomic framework's stall on the previous
commit's flip_done guarantees that "overlay 0 was enabled going into
this commit" is exactly "the write port is open now". The commit that
turns the overlay on therefore cannot land the upload itself -- writing
palette-then-enable in one go, which is the natural userspace order,
used to lose the palette right here -- so the upload stays pending and a
worker replays it by running an empty atomic commit once the enable has
latched. The worker never touches the hardware directly either: firing
dbuff from outside the commit path can latch a concurrent commit's
half-programmed frame.

C8 is offered only where sun8i_layer_cfg.has_palette says the hardware
has it: the vendor driver enables this for sun20i/sun8iw20 alone, so the
older DE2 SoCs must not advertise it even though they share de_type.
Scaling an indexed layer is refused -- an interpolated index is an
unrelated colour rather than an intermediate one.
---
diff --git a/drivers/gpu/drm/sun4i/sun8i_mixer.c b/drivers/gpu/drm/sun4i/sun8i_mixer.c
index b33fc0f10..f93be6208 100644
--- a/drivers/gpu/drm/sun4i/sun8i_mixer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_mixer.c
@@ -9,6 +9,9 @@
 
 #include <linux/component.h>
 #include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/sysfs.h>
+#include <linux/unaligned.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/of_device.h>
@@ -23,6 +26,7 @@
 #include <drm/drm_gem_dma_helper.h>
 #include <drm/drm_print.h>
 #include <drm/drm_probe_helper.h>
+#include <drm/drm_vblank.h>
 
 #include "sun4i_drv.h"
 #include "sun8i_mixer.h"
@@ -236,6 +240,14 @@ static const struct de2_fmt_info de2_formats[] = {
 		.drm_fmt = DRM_FORMAT_P210,
 		.de2_fmt = SUN8I_MIXER_FBFMT_P210_YUV,
 	},
+	{
+		/*
+		 * Reachable only where sun8i_layer_cfg.has_palette let the
+		 * plane advertise C8 in the first place.
+		 */
+		.drm_fmt = DRM_FORMAT_C8,
+		.de2_fmt = SUN8I_MIXER_FBFMT_PALETTE8,
+	},
 };
 
 int sun8i_mixer_drm_format_to_hw(u32 format, u32 *hw_format)
@@ -251,6 +263,330 @@ int sun8i_mixer_drm_format_to_hw(u32 format, u32 *hw_format)
 	return -EINVAL;
 }
 
+static bool sun8i_mixer_has_palette(struct sun8i_mixer *mixer)
+{
+	/*
+	 * Only the first UI channel is wired up: nothing with a palette has
+	 * more than one, and the VI channels' own palettes are untried.
+	 */
+	return mixer->cfg->lay_cfg.has_palette && mixer->cfg->ui_num == 1;
+}
+
+/*
+ * How long a staged palette may sit before palette_work forces a commit for
+ * it. An app that pairs a palette write with its own commit gets that long
+ * to make the swap ride its frame; a bare sysfs writer is delayed by this
+ * much, which does not matter.
+ */
+#define SUN8I_MIXER_PALETTE_WORK_DELAY	msecs_to_jiffies(20)
+
+/*
+ * Journal a register write for the vblank interrupt to perform. See the
+ * comment at struct sun8i_mixer::stage -- the D1 has no working register
+ * double buffering, so a write from process context lands mid-scanout and
+ * tears the frame. A later write to the same offset just replaces the
+ * journaled value.
+ *
+ * Writes go into the build journal first, which only the (per-CRTC
+ * serialised) commit path touches, so no lock is needed here. The commit
+ * hands the finished set over as one atomic merge in stage_arm() -- the
+ * interrupt must never see a commit's writes piecemeal: it can fire
+ * between two plane updates, and flushing that half-built state programs
+ * inconsistent geometry the DE can hang on.
+ */
+void sun8i_mixer_stage_write(struct sun8i_mixer *mixer, u32 offset, u32 value)
+{
+	unsigned int i;
+
+	for (i = 0; i < mixer->build_n; i++)
+		if (mixer->build[i].offset == offset)
+			break;
+
+	if (i == mixer->build_n) {
+		if (WARN_ON_ONCE(i >= SUN8I_MIXER_STAGE_MAX)) {
+			/* Overflow: a torn frame beats a lost write. */
+			regmap_write(mixer->engine.regs, offset, value);
+			return;
+		}
+		mixer->build[i].offset = offset;
+		mixer->build_n++;
+	}
+	mixer->build[i].value = value;
+}
+
+/* Look up a journaled write, newest first, for checks against pending state. */
+bool sun8i_mixer_stage_peek(struct sun8i_mixer *mixer, u32 offset, u32 *value)
+{
+	unsigned long flags;
+	unsigned int i;
+	bool hit = false;
+
+	for (i = 0; i < mixer->build_n; i++)
+		if (mixer->build[i].offset == offset) {
+			*value = mixer->build[i].value;
+			return true;
+		}
+
+	spin_lock_irqsave(&mixer->palette_hw_lock, flags);
+	for (i = 0; i < mixer->stage_n; i++)
+		if (mixer->stage[i].offset == offset) {
+			*value = mixer->stage[i].value;
+			hit = true;
+			break;
+		}
+	spin_unlock_irqrestore(&mixer->palette_hw_lock, flags);
+
+	return hit;
+}
+
+/* Caller holds palette_hw_lock. */
+static void sun8i_mixer_stage_merge(struct sun8i_mixer *mixer)
+{
+	unsigned int i, j;
+
+	for (i = 0; i < mixer->build_n; i++) {
+		for (j = 0; j < mixer->stage_n; j++)
+			if (mixer->stage[j].offset == mixer->build[i].offset)
+				break;
+		if (j == mixer->stage_n) {
+			if (WARN_ON_ONCE(j >= SUN8I_MIXER_STAGE_MAX))
+				continue;
+			mixer->stage[j].offset = mixer->build[i].offset;
+			mixer->stage_n++;
+		}
+		mixer->stage[j].value = mixer->build[i].value;
+	}
+	mixer->build_n = 0;
+}
+
+/* Caller holds palette_hw_lock (or the display is not scanning out). */
+static void sun8i_mixer_stage_flush(struct sun8i_mixer *mixer)
+{
+	unsigned int i;
+
+	for (i = 0; i < mixer->stage_n; i++)
+		writel(mixer->stage[i].value,
+		       mixer->palette_regs + mixer->stage[i].offset);
+	mixer->stage_n = 0;
+}
+
+/*
+ * Publish the commit's build journal to the interrupt side in one go and
+ * arm the flush. Falls back to writing directly when the CRTC cannot
+ * deliver an interrupt -- then nothing is being scanned out and there is
+ * no frame to tear.
+ */
+static void sun8i_mixer_stage_arm(struct sun8i_mixer *mixer,
+				  struct drm_crtc *crtc)
+{
+	unsigned long flags;
+	bool armed = false;
+
+	if (!mixer->build_n)
+		return;
+
+	if (drm_crtc_vblank_get(crtc) == 0) {
+		spin_lock_irqsave(&mixer->palette_hw_lock, flags);
+		sun8i_mixer_stage_merge(mixer);
+		if (mixer->stage_pending)
+			armed = true;	/* previous arm's reference stands */
+		else
+			mixer->stage_pending = true;
+		mixer->stage_crtc = crtc;
+		spin_unlock_irqrestore(&mixer->palette_hw_lock, flags);
+
+		/* The quirk puts exactly one reference per flush. */
+		if (armed)
+			drm_crtc_vblank_put(crtc);
+	} else {
+		spin_lock_irqsave(&mixer->palette_hw_lock, flags);
+		sun8i_mixer_stage_merge(mixer);
+		sun8i_mixer_stage_flush(mixer);
+		spin_unlock_irqrestore(&mixer->palette_hw_lock, flags);
+	}
+}
+
+/*
+ * Perform an armed palette upload from the TCON vblank interrupt.
+ *
+ * The palette RAM is the one thing a commit touches that is not latched by
+ * dbuff: writes take effect the moment they land. Writing it from process
+ * context therefore races the scanout -- the write can overlap the active
+ * area and corrupt that frame's palette fetches for *every* overlay
+ * sharing the channel (one grey frame), and even a clean write recolours
+ * the frame that is already on screen rather than the one the commit is
+ * building. At the vblank interrupt the frame has been fully pushed out to
+ * the panel, so this is the only spot where the RAM can be rewritten
+ * without a visible artefact -- the same "safe zone" the BSP uses in
+ * sync_event_proc().
+ *
+ * The mixer regmap locks with a mutex, so the upload uses the raw mapping.
+ * The access bit is read-modify-written one step at a time to keep the
+ * window where a concurrent regmap write to ATTR could be clobbered as
+ * small as possible (the ATTR readback returns the shadow register).
+ */
+static void sun8i_mixer_vblank_quirk(struct sunxi_engine *engine)
+{
+	struct sun8i_mixer *mixer = engine_to_sun8i_mixer(engine);
+	struct drm_crtc *crtc = NULL, *stage_crtc = NULL;
+	void __iomem *attr_reg, *pal_reg;
+	unsigned int i;
+	u32 ch_base;
+
+	spin_lock(&mixer->palette_hw_lock);
+
+	/*
+	 * The journal goes first: it carries the overlay attributes this
+	 * commit decided on, and the palette write port is gated by overlay
+	 * 0's live EN bit.
+	 */
+	if (mixer->stage_pending) {
+		sun8i_mixer_stage_flush(mixer);
+		mixer->stage_pending = false;
+		stage_crtc = mixer->stage_crtc;
+	}
+
+	if (mixer->palette_pending) {
+		/* The UI channels follow the VI ones. */
+		ch_base = DE2_CH_BASE + mixer->cfg->vi_num * DE2_CH_SIZE;
+		attr_reg = mixer->palette_regs +
+			   SUN8I_MIXER_CHAN_UI_LAYER_ATTR(ch_base, 0);
+		pal_reg = mixer->palette_regs +
+			  SUN8I_MIXER_CHAN_UI_PALETTE(ch_base);
+
+		/* The write window needs a fresh rising edge every time. */
+		writel(readl(attr_reg) &
+		       ~SUN8I_MIXER_CHAN_UI_LAYER_ATTR_PALETTE_ACCESS,
+		       attr_reg);
+		writel(readl(attr_reg) |
+		       SUN8I_MIXER_CHAN_UI_LAYER_ATTR_PALETTE_ACCESS,
+		       attr_reg);
+
+		for (i = 0; i < SUN8I_MIXER_PALETTE_ENTRIES; i++)
+			writel(mixer->palette_hw[i], pal_reg + 4 * i);
+
+		writel(readl(attr_reg) &
+		       ~SUN8I_MIXER_CHAN_UI_LAYER_ATTR_PALETTE_ACCESS,
+		       attr_reg);
+
+		mixer->palette_pending = false;
+		crtc = mixer->palette_crtc;
+	}
+
+	spin_unlock(&mixer->palette_hw_lock);
+
+	/* Drop the references the arming commits took to keep the IRQ on. */
+	if (stage_crtc)
+		drm_crtc_vblank_put(stage_crtc);
+	if (crtc)
+		drm_crtc_vblank_put(crtc);
+}
+
+/*
+ * Arm a palette upload for the vblank interrupt to perform, so that it
+ * lands in the same safe zone where this commit's dbuff-latched state takes
+ * effect instead of racing the scanout (see sun8i_mixer_vblank_quirk).
+ *
+ * The RAM only accepts writes while overlay 0's *live* EN bit is set --
+ * with the layer off they are silently dropped, and the RAM cannot be
+ * read back to check. The commit that brings the layer up journals the
+ * EN write, and the interrupt flushes the journal before the upload, so
+ * by the time the upload runs the port is open; palette_work replaying
+ * through a second commit remains as a belt-and-braces fallback.
+ */
+static void sun8i_mixer_palette_arm(struct sun8i_mixer *mixer,
+				    struct drm_crtc *crtc)
+{
+	unsigned long flags;
+	u32 ch_base, attr;
+	bool enabled, armed = false;
+
+	lockdep_assert_held(&mixer->palette_lock);
+
+	/* The UI channels follow the VI ones. */
+	ch_base = DE2_CH_BASE + mixer->cfg->vi_num * DE2_CH_SIZE;
+
+	/*
+	 * A journaled ATTR is what the interrupt will have written by the
+	 * time the upload runs, so it beats the live register.
+	 */
+	if (!sun8i_mixer_stage_peek(mixer,
+				    SUN8I_MIXER_CHAN_UI_LAYER_ATTR(ch_base, 0),
+				    &attr))
+		regmap_read(mixer->engine.regs,
+			    SUN8I_MIXER_CHAN_UI_LAYER_ATTR(ch_base, 0), &attr);
+	enabled = attr & SUN8I_MIXER_CHAN_UI_LAYER_ATTR_EN;
+
+	if (mixer->palette_dirty && enabled &&
+	    drm_crtc_vblank_get(crtc) == 0) {
+		spin_lock_irqsave(&mixer->palette_hw_lock, flags);
+		memcpy(mixer->palette_hw, mixer->palette,
+		       sizeof(mixer->palette_hw));
+		if (mixer->palette_pending)
+			armed = true;	/* previous arm's reference stands */
+		else
+			mixer->palette_pending = true;
+		spin_unlock_irqrestore(&mixer->palette_hw_lock, flags);
+
+		/* The quirk puts exactly one reference per upload. */
+		if (armed)
+			drm_crtc_vblank_put(crtc);
+
+		if (mixer->palette_live)
+			mixer->palette_dirty = false;
+		else
+			schedule_delayed_work(&mixer->palette_work,
+					      SUN8I_MIXER_PALETTE_WORK_DELAY);
+	}
+
+	mixer->palette_live = enabled;
+}
+
+/*
+ * Provide a commit for a staged palette when nobody else does: an empty
+ * atomic commit serialises against every other committer and arms the
+ * upload the ordinary way. Runs delayed so that an app which follows its
+ * palette write with a real commit wins the race and finds nothing left to
+ * do here -- its own commit is the one the swap should ride.
+ */
+static void sun8i_mixer_palette_work(struct work_struct *work)
+{
+	struct sun8i_mixer *mixer =
+		container_of(work, struct sun8i_mixer, palette_work.work);
+	struct drm_modeset_acquire_ctx ctx;
+	struct drm_atomic_state *state;
+	struct drm_crtc *crtc;
+	int ret;
+
+	mutex_lock(&mixer->palette_lock);
+	crtc = mixer->palette_dirty && mixer->palette_live ?
+	       mixer->palette_crtc : NULL;
+	mutex_unlock(&mixer->palette_lock);
+
+	if (!crtc)
+		return;
+
+	state = drm_atomic_state_alloc(crtc->dev);
+	if (!state)
+		return;
+
+	drm_modeset_acquire_init(&ctx, 0);
+	state->acquire_ctx = &ctx;
+retry:
+	ret = PTR_ERR_OR_ZERO(drm_atomic_get_crtc_state(state, crtc));
+	if (!ret)
+		ret = drm_atomic_commit(state);
+	if (ret == -EDEADLK) {
+		drm_atomic_state_clear(state);
+		drm_modeset_backoff(&ctx);
+		goto retry;
+	}
+
+	drm_atomic_state_put(state);
+	drm_modeset_drop_locks(&ctx);
+	drm_modeset_acquire_fini(&ctx);
+}
+
 static void sun8i_mixer_commit(struct sunxi_engine *engine,
 			       struct drm_crtc *crtc,
 			       struct drm_atomic_state *state)
@@ -368,6 +704,17 @@ static void sun8i_mixer_commit(struct sunxi_engine *engine,
 		route |= i << SUN8I_MIXER_BLEND_ROUTE_PIPE_SHIFT(zpos);
 		pipe_en |= SUN8I_MIXER_BLEND_PIPE_CTL_EN(zpos);
 
+		if (ui_ovl > 1) {
+			/* No double buffering here: journal for the vblank. */
+			sun8i_mixer_stage_write(mixer,
+				SUN8I_MIXER_BLEND_ATTR_COORD(bld_base, zpos),
+				SUN8I_MIXER_COORD(c->x1, c->y1));
+			sun8i_mixer_stage_write(mixer,
+				SUN8I_MIXER_BLEND_ATTR_INSIZE(bld_base, zpos),
+				SUN8I_MIXER_SIZE(w, h));
+			continue;
+		}
+
 		regmap_write(bld_regs,
 			     SUN8I_MIXER_BLEND_ATTR_COORD(bld_base, zpos),
 			     SUN8I_MIXER_COORD(c->x1, c->y1));
@@ -376,9 +723,35 @@ static void sun8i_mixer_commit(struct sunxi_engine *engine,
 			     SUN8I_MIXER_SIZE(w, h));
 	}
 
-	regmap_write(bld_regs, SUN8I_MIXER_BLEND_ROUTE(bld_base), route);
-	regmap_write(bld_regs, SUN8I_MIXER_BLEND_PIPE_CTL(bld_base),
-		     pipe_en | SUN8I_MIXER_BLEND_PIPE_CTL_FC_EN(0));
+	if (ui_ovl > 1) {
+		sun8i_mixer_stage_write(mixer,
+					SUN8I_MIXER_BLEND_ROUTE(bld_base),
+					route);
+		sun8i_mixer_stage_write(mixer,
+					SUN8I_MIXER_BLEND_PIPE_CTL(bld_base),
+					pipe_en |
+					SUN8I_MIXER_BLEND_PIPE_CTL_FC_EN(0));
+	} else {
+		regmap_write(bld_regs, SUN8I_MIXER_BLEND_ROUTE(bld_base),
+			     route);
+		regmap_write(bld_regs, SUN8I_MIXER_BLEND_PIPE_CTL(bld_base),
+			     pipe_en | SUN8I_MIXER_BLEND_PIPE_CTL_FC_EN(0));
+	}
+
+	/*
+	 * The layer attributes are in place by now, so a staged palette can
+	 * be armed for the vblank interrupt alongside this commit's dbuff.
+	 */
+	if (sun8i_mixer_has_palette(mixer)) {
+		mutex_lock(&mixer->palette_lock);
+		mixer->palette_crtc = crtc;
+		sun8i_mixer_palette_arm(mixer, crtc);
+		mutex_unlock(&mixer->palette_lock);
+	}
+
+	/* Everything this commit journaled lands at the next vblank. */
+	if (ui_ovl > 1)
+		sun8i_mixer_stage_arm(mixer, crtc);
 
 	if (mixer->cfg->de_type != SUN8I_MIXER_DE33)
 		regmap_write(engine->regs, SUN8I_MIXER_GLOBAL_DBUFF,
@@ -432,6 +805,7 @@ static struct drm_plane **sun8i_layers_init(struct drm_device *drm,
 			return ERR_CAST(layer);
 		}
 
+		layer->mixer = mixer;
 		planes[i] = &layer->plane;
 	}
 
@@ -461,6 +835,7 @@ static struct drm_plane **sun8i_layers_init(struct drm_device *drm,
 			return ERR_CAST(layer);
 		}
 
+		layer->mixer = mixer;
 		planes[index] = &layer->plane;
 	}
 
@@ -505,6 +880,7 @@ static void sun8i_mixer_mode_set(struct sunxi_engine *engine,
 static const struct sunxi_engine_ops sun8i_engine_ops = {
 	.commit		= sun8i_mixer_commit,
 	.layers_init	= sun8i_layers_init,
+	.vblank_quirk	= sun8i_mixer_vblank_quirk,
 	.mode_set	= sun8i_mixer_mode_set,
 };
 
@@ -596,6 +972,70 @@ static void sun8i_mixer_init(struct sun8i_mixer *mixer)
 			   SUN8I_MIXER_BLEND_PIPE_CTL_EN_MSK, 0);
 }
 
+/*
+ * A UI channel owns 256 ARGB8888 entries that all of its overlays index
+ * into, so the palette belongs to the channel and not to any one plane --
+ * which is why this is a device attribute rather than a plane property, and
+ * why four planes sharing one table is the honest picture rather than a
+ * conflict to arbitrate.
+ *
+ * Reads come from the shadow copy: the RAM itself always reads back zero.
+ */
+static ssize_t sun8i_mixer_palette_read(struct file *file,
+					struct kobject *kobj,
+					const struct bin_attribute *attr,
+					char *buf, loff_t off, size_t count)
+{
+	struct sun8i_mixer *mixer = dev_get_drvdata(kobj_to_dev(kobj));
+
+	mutex_lock(&mixer->palette_lock);
+	memcpy(buf, (u8 *)mixer->palette + off, count);
+	mutex_unlock(&mixer->palette_lock);
+
+	return count;
+}
+
+static ssize_t sun8i_mixer_palette_write(struct file *file,
+					 struct kobject *kobj,
+					 const struct bin_attribute *attr,
+					 char *buf, loff_t off, size_t count)
+{
+	struct sun8i_mixer *mixer = dev_get_drvdata(kobj_to_dev(kobj));
+	bool live;
+	size_t i;
+
+	if ((off | count) & 3)
+		return -EINVAL;
+
+	mutex_lock(&mixer->palette_lock);
+
+	for (i = 0; i < count; i += 4)
+		mixer->palette[(off + i) / 4] = get_unaligned_le32(buf + i);
+	mixer->palette_dirty = true;
+	live = mixer->palette_live;
+
+	mutex_unlock(&mixer->palette_lock);
+
+	/*
+	 * Staging only: the commit path owns the hardware. With a layer
+	 * already up nothing else may commit for a while, so ask for one --
+	 * delayed, so a commit of the writer's own can claim the swap first.
+	 * With everything off the enabling commit will pick it up anyway.
+	 */
+	if (live)
+		schedule_delayed_work(&mixer->palette_work,
+				      SUN8I_MIXER_PALETTE_WORK_DELAY);
+
+	return count;
+}
+
+static const struct bin_attribute sun8i_mixer_palette_attr = {
+	.attr	= { .name = "palette", .mode = 0644 },
+	.size	= SUN8I_MIXER_PALETTE_ENTRIES * 4,
+	.read	= sun8i_mixer_palette_read,
+	.write	= sun8i_mixer_palette_write,
+};
+
 static int sun8i_mixer_bind(struct device *dev, struct device *master,
 			      void *data)
 {
@@ -667,6 +1107,9 @@ static int sun8i_mixer_bind(struct device *dev, struct device *master,
