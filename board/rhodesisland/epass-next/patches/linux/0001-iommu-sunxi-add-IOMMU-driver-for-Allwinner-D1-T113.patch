+struct fib_state {
+	unsigned long cur;
+	unsigned long prev;
+};
+
+static __maybe_unused void fib_init(struct fib_state *f)
+{
+	f->cur = f->prev = 1;
+}
+
+static __maybe_unused unsigned long get_next_fib(struct fib_state *f)
+{
+	int next = f->cur + f->prev;
+
+	f->prev = f->cur;
+	f->cur = next;
+	return next;
+}
