+					      struct iommu_domain *domain,
+					      void *priv),
+				    void *priv)
+{
+	struct iommu_debug_device *ddev = s->private;
+	struct device *dev = ddev->dev;
+	int ret = -EINVAL;
+
+	ret = fn(dev, s, global_iommu_domain, priv);
+	return ret;
+}
