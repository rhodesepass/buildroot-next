From: Shirogane Tsumugi <artoriapendragon123@gmail.com>
Subject: [PATCH] riscv: uaccess: use the "A" constraint for fixup asm memory
 operands

With XTheadMemIdx in -march, GCC considers register+register indexed
addresses legitimate and happily materializes them for inline asm "m"
operands.  The uaccess templates hard-code base mnemonics (sb/sh/sw/sd,
lb/lh/lw/ld), which have no indexed form -- only the th.{s,l}r*
instructions do -- so the assembler rejects the result, e.g.:

  fs/readdir.c:293: Error: illegal operands `sb zero,a0,s5,0'

The "o" (offsettable) constraint does not help for byte accesses: the
offsettability probe adds mode_size-1 = 0, which leaves the indexed
address intact.  Use the riscv-specific "A" constraint (memory with the
address in a single register, already used by atomics/cmpxchg) so the
address is always materialized as 0(reg).  Costs at most one extra
address computation per access; user pointers are usually plain
registers already.

Signed-off-by: Shirogane Tsumugi <artoriapendragon123@gmail.com>

---
diff --git a/arch/riscv/include/asm/uaccess.h b/arch/riscv/include/asm/uaccess.h
index 11c9886c3..c6d636d6a 100644
--- a/arch/riscv/include/asm/uaccess.h
+++ b/arch/riscv/include/asm/uaccess.h
@@ -111,7 +111,7 @@ do {								\
 		"	" insn " %0, %1\n"			\
 		_ASM_EXTABLE_UACCESS_ERR(1b, %l2, %0)		\
 		: "=&r" (__tmp)					\
-		: "m" (*(ptr)) : : label);			\
+		: "A" (*(ptr)) : : label);			\
 	(x) = (__typeof__(x))(unsigned long)__tmp;		\
 } while (0)
 #else /* !CONFIG_CC_HAS_ASM_GOTO_OUTPUT */
@@ -124,7 +124,7 @@ do {								\
 		"2:\n"						\
 		_ASM_EXTABLE_UACCESS_ERR_ZERO(1b, 2b, %0, %1)	\
 		: "+r" (__gua_err), "=&r" (x)			\
-		: "m" (*(ptr)));				\
+		: "A" (*(ptr)));				\
 	if (__gua_err)						\
 		goto label;					\
 } while (0)
@@ -148,7 +148,7 @@ do {								\
 		_ASM_EXTABLE_UACCESS_ERR(1b, %l4, %0)		\
 		_ASM_EXTABLE_UACCESS_ERR(2b, %l4, %0)		\
 		: "=&r" (__lo), "=r" (__hi)			\
-		: "m" (__ptr[__LSW]), "m" (__ptr[__MSW])	\
+		: "A" (__ptr[__LSW]), "A" (__ptr[__MSW])	\
 		: : label);                                     \
 	(x) = (__typeof__(x))((__typeof__((x) - (x)))(		\
 		(((u64)__hi << 32) | __lo)));			\
@@ -168,7 +168,7 @@ do {								\
 		_ASM_EXTABLE_UACCESS_ERR_ZERO(1b, 3b, %0, %1)	\
 		_ASM_EXTABLE_UACCESS_ERR_ZERO(2b, 3b, %0, %1)	\
 		: "+r" (__gu8_err), "=&r" (__lo), "=r" (__hi)	\
-		: "m" (__ptr[__LSW]), "m" (__ptr[__MSW]));	\
+		: "A" (__ptr[__LSW]), "A" (__ptr[__MSW]));	\
 	if (__gu8_err) {					\
 		__hi = 0;					\
 		goto label;					\
@@ -293,7 +293,7 @@ do {								\
 		"1:\n"						\
 		"	" insn " %z0, %1\n"			\
 		_ASM_EXTABLE(1b, %l2)				\
-		: : "rJ" (__x), "m"(*(ptr)) : : label);		\
+		: : "rJ" (__x), "A"(*(ptr)) : : label);		\
 } while (0)
 
 #ifdef CONFIG_64BIT
@@ -312,8 +312,8 @@ do {								\
 		_ASM_EXTABLE(1b, %l4)				\
 		_ASM_EXTABLE(2b, %l4)				\
 		: : "rJ" (__x), "rJ" (__x >> 32),		\
-			"m" (__ptr[__LSW]),			\
-			"m" (__ptr[__MSW]) : : label);		\
+			"A" (__ptr[__LSW]),			\
+			"A" (__ptr[__MSW]) : : label);		\
 } while (0)
 #endif /* CONFIG_64BIT */
 
diff --git a/arch/riscv/include/asm/word-at-a-time.h b/arch/riscv/include/asm/word-at-a-time.h
index 3802cda71..d2aefc5e3 100644
--- a/arch/riscv/include/asm/word-at-a-time.h
+++ b/arch/riscv/include/asm/word-at-a-time.h
@@ -66,7 +66,7 @@ static inline unsigned long load_unaligned_zeropad(const void *addr)
 	"2:\n"
 	_ASM_EXTABLE_LOAD_UNALIGNED_ZEROPAD(1b, 2b, %0, %1)
 	: "=&r" (ret)
-	: "r" (addr), "m" (*(unsigned long *)addr));
+	: "r" (addr), "A" (*(unsigned long *)addr));
 
 	return ret;
 }
