+#include <ch32_swio.h>
+#include <cyclic.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/string.h>
+#include <stdio.h>
+#include <asm/io.h>
+#include <asm/system.h>
+
+#define PG_CFG1 0x02000124UL
+#define PG_DATA 0x02000130UL
+#define PG_PULL 0x02000144UL
+#define SWIO (1U << 13)
+#define RST (1U << 15)
+#define PIN_CFG ((15U << 20) | (15U << 28))
+#define PIN_PULL ((3U << 26) | (3U << 30))
+#define FLASH_BASE 0x08000000U
+#define FLASH_REG 0x40022000U
+#define PAGE_SIZE 256U
+#define TRY(expr) do { int err_ = (expr); if (err_) return err_; } while (0)
+
+static u32 frame_low, frame_high, frame_input, frame_output;
+static u32 saved_cfg, saved_data, saved_pull;
+static unsigned long saved_irq;
+
+static inline u64 ticks(void)
+{
+	u64 value;
+
+	asm volatile("rdtime %0" : "=r"(value));
+	return value;
+}
+
+static __always_inline void wait_ticks(unsigned int count)
+{
+	u64 start = ticks();
+
+	while (ticks() - start < count)
+		;
+}
+
+static __always_inline void bit_store(ulong addr, u32 value)
+{
+	*(volatile u32 *)addr = value;
+	asm volatile("fence iorw, iorw" ::: "memory");
+}
+
+static bool line_high(void)
+{
+	return !!(readl((void *)PG_DATA) & SWIO);
+}
+
+static int wait_high(void)
+{
+	u64 start = ticks();
+
+	while (!line_high())
+		if (ticks() - start >= 24 * 50)
+			return -ETIMEDOUT;
+	return 0;
+}
+
+static void release(void)
+{
+	clrbits_le32((void *)PG_CFG1, PIN_CFG);
+	clrbits_le32((void *)PG_PULL, PIN_PULL);
+}
+
+static void reset_target(void)
+{
+	release();
+	clrbits_le32((void *)PG_DATA, RST);
+	setbits_le32((void *)PG_CFG1, 1U << 28);
+	udelay(1000);
+	clrbits_le32((void *)PG_CFG1, 15U << 28);
+}
+
+static void send_bit(bool bit)
+{
+	/* These are added 24 MHz waits, not desired physical pulse widths. */
+	bit_store(PG_DATA, frame_low);
+	wait_ticks(bit ? 3 : 18);
+	bit_store(PG_DATA, frame_high);
+	wait_ticks(4);
+}
+
+static int frame_begin(u8 reg, bool write)
+{
+	unsigned int mask;
+
+	clrbits_le32((void *)PG_CFG1, 15U << 20);
+	TRY(wait_high());
+	/* Per-bit read-modify-write makes the short pulse too long for V006. */
+	frame_low = readl((void *)PG_DATA) & ~SWIO;
+	frame_high = frame_low | SWIO;
+	frame_input = readl((void *)PG_CFG1) & ~(15U << 20);
+	frame_output = frame_input | (1U << 20);
+	bit_store(PG_DATA, frame_high);
+	bit_store(PG_CFG1, frame_output);
+	send_bit(true);
+	for (mask = 64; mask; mask >>= 1)
+		send_bit(reg & mask);
+	send_bit(write);
+	return 0;
+}
+
+static int dmi_write(u8 reg, u32 value)
+{
+	u32 mask;
+
+	TRY(frame_begin(reg, true));
+	for (mask = 1U << 31; mask; mask >>= 1)
+		send_bit(value & mask);
+	wait_ticks(24 * 8);
+	return 0;
+}
+
+static int dmi_read(u8 reg, u32 *value)
+{
+	u32 result = 0;
+	unsigned int i;
+
+	TRY(frame_begin(reg, false));
+	for (i = 0; i < 32; i++) {
+		bit_store(PG_DATA, frame_low);
+		wait_ticks(2);
+		bit_store(PG_CFG1, frame_input);
+		wait_ticks(4);
+		result = (result << 1) | line_high();
+		TRY(wait_high());
+		bit_store(PG_DATA, frame_high);
+		bit_store(PG_CFG1, frame_output);
+		wait_ticks(4);
+	}
+	wait_ticks(24 * 8);
+	*value = result;
+	return 0;
+}
+
+static int command(u32 cmd)
+{
+	u64 start;
+	u32 status;
+
+	TRY(dmi_write(0x17, cmd));
+	start = ticks();
+	do {
+		TRY(dmi_read(0x16, &status));
+		if (!(status & (1U << 12)))
+			return status & 0x700 ? -EIO : 0;
+	} while (ticks() - start < 24 * 100000);
+	return -ETIMEDOUT;
+}
+
+static int mem_read(u32 addr, u32 *value)
+{
+	TRY(dmi_write(0x20, 0x90024000)); /* c.lw x8,0(x8); c.ebreak */
+	TRY(dmi_write(0x04, addr));
+	TRY(command(0x00271008));
+	TRY(command(0x00221008));
+	return dmi_read(0x04, value);
+}
+
+static int mem_write(u32 addr, u32 value)
+{
+	TRY(dmi_write(0x20, 0x0084a023)); /* sw x8,0(x9) */
+	TRY(dmi_write(0x21, 0x00100073)); /* ebreak */
+	TRY(dmi_write(0x04, addr));
+	TRY(command(0x00231009));
+	TRY(dmi_write(0x04, value));
+	return command(0x00271008);
+}
+
+static int connect_target(void)
+{
+	u32 value;
+	int i;
+
+	reset_target();
+	udelay(16000);
+	TRY(wait_high());
+	for (i = 0; i < 2; i++) {
+		TRY(dmi_write(0x7e, 0x5aa50400));
+		TRY(dmi_write(0x7d, 0x5aa50400));
+	}
+	for (i = 0; i < 3; i++)
+		TRY(dmi_write(0x10, 0x80000001));
+	TRY(dmi_read(0x11, &value));
+	if (!value || value == ~0U || !(value & (1U << 9)))
+		return -ENODEV;
+	TRY(dmi_write(0x18, 0));
+	TRY(dmi_write(0x16, 0x08000700));
+	TRY(mem_read(0x1ffff704, &value));
+	if (value != 0x00620620) {
+		printf("CH32: unsupported chip %08x\n", value);
+		return -ENODEV;
+	}
+	TRY(mem_read(FLASH_REG + 0x1c, &value));
+	if (value & 2)
+		return -EACCES;
+	TRY(mem_read(FLASH_REG + 0x20, &value));
+	if (value != ~0U)
+		return -EACCES;
+	return 0;
+}
+
+static void session_begin(void)
+{
+	/* RISC-V disable_interrupts() is a stub; save the actual S-mode CSR. */
+	local_irq_save(saved_irq);
+	saved_cfg = readl((void *)PG_CFG1);
+	saved_data = readl((void *)PG_DATA);
+	saved_pull = readl((void *)PG_PULL);
+}
+
+static void session_end(void)
+{
+	int reset_ret, resume_ret;
+
+	/* NRST need not clear haltreq. Hold it while dropping the debug halt,
+	 * so a failed debug reset cannot resume an old PC with modified x8/x9.
+	 */
+	release();
+	clrbits_le32((void *)PG_DATA, RST);
+	setbits_le32((void *)PG_CFG1, 1U << 28);
+	udelay(1000);
+	reset_ret = dmi_write(0x10, 0x80000003);
+	resume_ret = dmi_write(0x10, 0x40000001);
+	udelay(1000);
+	release();
+	clrsetbits_le32((void *)PG_DATA, SWIO | RST, saved_data & (SWIO | RST));
+	clrsetbits_le32((void *)PG_PULL, PIN_PULL, saved_pull & PIN_PULL);
+	clrsetbits_le32((void *)PG_CFG1, PIN_CFG, saved_cfg & PIN_CFG);
+	local_irq_restore(saved_irq);
+	if (reset_ret || resume_ret)
+		printf("CH32: debug reset/resume failed; target restart unconfirmed\n");
+}
+
+static int flash_wait(void)
+{
+	u64 start = ticks();
+	u32 value;
+
+	do {
+		TRY(mem_read(FLASH_REG + 0x0c, &value));
+		if (!(value & 3))
+			return value & 0x14 ? -EIO : 0;
+	} while (ticks() - start < 24 * 100000);
+	return -ETIMEDOUT;
+}
+
+static int unlock_flash(void)
+{
+	u32 value;
+
+	/* Do not unlock option bytes or the boot area. */
+	TRY(mem_write(FLASH_REG + 4, 0x45670123));
+	TRY(mem_write(FLASH_REG + 4, 0xcdef89ab));
+	TRY(mem_write(FLASH_REG + 0x24, 0x45670123));
+	TRY(mem_write(FLASH_REG + 0x24, 0xcdef89ab));
+	TRY(mem_read(FLASH_REG + 0x10, &value));
+	if (value & 0x8080)
+		return -EACCES;
+	TRY(mem_write(FLASH_REG + 0x0c, 0x34));
+	return flash_wait();
+}
+
+static int program_page(u32 addr, const u8 *page)
+{
+	u32 i, value, expected;
+
+	TRY(mem_write(FLASH_REG + 0x10, 0x00020000));
+	TRY(mem_write(FLASH_REG + 0x14, addr));
+	TRY(mem_write(FLASH_REG + 0x10, 0x00020040));
+	TRY(flash_wait());
+	TRY(mem_write(FLASH_REG + 0x10, 0x00010000));
+	TRY(mem_write(FLASH_REG + 0x10, 0x00090000));
+	TRY(flash_wait());
+	for (i = 0; i < PAGE_SIZE; i += 4) {
+		memcpy(&value, page + i, 4);
+		TRY(mem_write(addr + i, value));
+		TRY(mem_write(FLASH_REG + 0x10, 0x00050000));
+		TRY(flash_wait());
+	}
+	TRY(mem_write(FLASH_REG + 0x14, addr));
+	TRY(mem_write(FLASH_REG + 0x10, 0x00010040));
+	TRY(flash_wait());
+	TRY(mem_write(FLASH_REG + 0x10, 0));
+	for (i = 0; i < PAGE_SIZE; i += 4) {
+		TRY(mem_read(addr + i, &value));
+		memcpy(&expected, page + i, 4);
+		if (value != expected) {
+			printf("CH32: verify failed at %08x\n", addr + i);
+			return -EIO;
+		}
+	}
+	return 0;
+}
+
+int ch32_swio_probe(void)
+{
+	int ret;
+
+	session_begin();
+	ret = connect_target();
+	session_end();
+	if (!ret)
+		printf("CH32V006 00620620, 62 KiB main flash, read protection off\n");
+	return ret;
+}
+
+int ch32_swio_read(void *data, size_t len)
+{
+	size_t offset, count;
+	u32 value;
+	int ret;
+
+	if (!data || !len || len > CH32_SWIO_FLASH_SIZE)
+		return -EINVAL;
+	session_begin();
+	ret = connect_target();
+	for (offset = 0; !ret && offset < len; offset += 4) {
+		if (!(offset % PAGE_SIZE)) schedule();
+		ret = mem_read(FLASH_BASE + offset, &value);
+		count = len - offset < 4 ? len - offset : 4;
+		if (!ret)
+			memcpy((u8 *)data + offset, &value, count);
+	}
+	session_end();
+	return ret;
+}
+
+int ch32_swio_flash(const void *data, size_t len)
+{
+	u8 page[PAGE_SIZE];
+	size_t offset, count, i;
+	u32 value;
+	int ret;
+
+	if (!data || !len || (len & 3) || len > CH32_SWIO_FLASH_SIZE)
+		return -EINVAL;
+	session_begin();
+	ret = connect_target();
+	if (!ret)
+		ret = unlock_flash();
+	for (offset = 0; !ret && offset < len; offset += PAGE_SIZE) {
+		schedule();
+		count = len - offset < PAGE_SIZE ? len - offset : PAGE_SIZE;
+		/* Preserve bytes outside the image in the final erase page. */
+		if (count < PAGE_SIZE) {
+			for (i = 0; i < PAGE_SIZE; i += 4) {
+				ret = mem_read(FLASH_BASE + offset + i, &value);
+				if (ret)
+					break;
+				memcpy(page + i, &value, 4);
+			}
+			if (ret)
+				break;
+		}
+		memcpy(page, (const u8 *)data + offset, count);
+		ret = program_page(FLASH_BASE + offset, page);
+		if (!ret && (!(offset % 4096) || offset + count == len))
+			printf("CH32 verified %zu/%zu bytes\n", offset + count, len);
+	}
+	session_end();
+	return ret;
+}
diff --git a/board/sunxi/spl_spinand_sunxi.c b/board/sunxi/spl_spinand_sunxi.c
new file mode 100644
index 00000000..a6184531
--- /dev/null
+++ b/board/sunxi/spl_spinand_sunxi.c
@@ -0,0 +1,413 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * SPL loader for SPI NAND on the RISC-V sunxi SoCs (Allwinner D1/D1s).
+ *
+ * The BROM can read the SPL out of a SPI NAND, but nothing in U-Boot can read
+ * anything else out of one from the SPL: spl_spi.c goes through
+ * spi_flash_probe(), which is the NOR framework and finds no JEDEC id on a
+ * NAND part, and arch/arm/mach-sunxi/spl_spi_sunxi.c handles NOR only (and is
+ * ARM-only besides). So a board whose only medium is SPI NAND -- which is what
+ * the D1s designs are -- cannot get past the SPL. This fills that in.
+ *
+ * Deliberately minimal. All it has to do is pull one image out of a fixed
+ * offset exactly once, so there is no write path, no ECC correction beyond
+ * what the chip does on its own, and no attempt at a generic geometry: the
+ * page and block size come from the parameter page every SPI NAND carries.
+ *
+ * The register sequences follow Allwinner's own boot0
+ * (brandy-2.0/spl/drivers/nand/sun20iw1p1/spinand/), which is the only
+ * documentation for this controller. Two things are dropped from it:
+ *
+ *   - Sample delay calibration. boot0 tunes the sample point against the SPI
+ *     clock, with a table per frequency range. Running the bus from the 24MHz
+ *     oscillator instead of PLL6 puts us in its "<= 24MHz" case, where the
+ *     answer is just SPI_SAMPLE_MODE and no tuning at all. Reading 741K takes
+ *     about a quarter of a second that way, which is nothing next to the DRAM
+ *     init that already happened.
+ *   - Quad and dual read, two-plane addressing, and the OperationOpt feature
+ *     flags that select between them. Plain x1 read works on every part.
+ */
+
+#include <config.h>
+#include <image.h>
+#include <spl.h>
+#include <spl_load.h>
+#include <asm/arch/spl.h>
+#include <asm/io.h>
+#include <linux/delay.h>
+
+/*
+ * The register addresses below are bare physical integers, which ARM's
+ * readl/writel take and RISC-V's do not. Same self-referential macro trick the
+ * sunxi DRAM driver uses: a function-like macro is not expanded again inside
+ * its own expansion.
+ */
+#define readl(a)	readl((const volatile void __iomem *)(ulong)(a))
+#define writel(v, a)	writel((v), (volatile void __iomem *)(ulong)(a))
+#define readb(a)	readb((const volatile void __iomem *)(ulong)(a))
+#define writeb(v, a)	writeb((v), (volatile void __iomem *)(ulong)(a))
+
+#if CONFIG_IS_ENABLED(SPINAND_SUNXI_SPI1)
+#define SPINAND_BUS 1
+#else
+#define SPINAND_BUS 0
+#endif
+
+/* CCU */
+#define CCU_BASE			0x02001000UL
+#define CCU_SPI_CLK_REG		(CCU_BASE + 0x940 + 4 * SPINAND_BUS)
+#define CCU_SPI_BGR_REG			(CCU_BASE + 0x96c)
+#define CCU_SPI_GATE			BIT(SPINAND_BUS)
+#define CCU_SPI_RST			BIT(16 + SPINAND_BUS)
+#define CCU_CLK_ENABLE			BIT(31)
+#define CCU_CLK_SRC_HOSC		(0 << 24)
+
+/* pinctrl: SPI0 is PC2..PC5, function 2 */
+#define PIO_BASE			0x02000000UL
+#define PIO_PC_CFG0_REG			(PIO_BASE + 0x60)
+#define PIO_PD_CFG1_REG			(PIO_BASE + 0x94)
+
+/* SPI0 */
+#define SPI_BASE			(0x04025000UL + 0x1000 * SPINAND_BUS)
+#define SPI_GCR				(SPI_BASE + 0x04)
+#define SPI_TCR				(SPI_BASE + 0x08)
+#define SPI_IER				(SPI_BASE + 0x10)
+#define SPI_ISR				(SPI_BASE + 0x14)
+#define SPI_FCR				(SPI_BASE + 0x18)
+#define SPI_FSR				(SPI_BASE + 0x1c)
+#define SPI_CCR				(SPI_BASE + 0x24)
+#define SPI_MBC				(SPI_BASE + 0x30)
+#define SPI_MTC				(SPI_BASE + 0x34)
+#define SPI_BCC				(SPI_BASE + 0x38)
+#define SPI_TXD				(SPI_BASE + 0x200)
+#define SPI_RXD				(SPI_BASE + 0x300)
+
+#define SPI_GCR_SOFT_RST		BIT(31)
+#define SPI_GCR_TXPAUSE_EN		BIT(7)
+#define SPI_GCR_MASTER			BIT(1)
+#define SPI_GCR_ENABLE			BIT(0)
+
+#define SPI_TCR_EXCHANGE		BIT(31)
+#define SPI_TCR_SAMPLE_MODE		BIT(13)
+#define SPI_TCR_DHB			BIT(8)
+#define SPI_TCR_SET_SS_1		BIT(7)
+#define SPI_TCR_SS_ACTIVE0		BIT(2)
+
+#define SPI_FCR_TXFIFO_RST		BIT(31)
+#define SPI_FCR_RXFIFO_RST		BIT(15)
+
+#define SPI_FIFO_DEPTH			64
+
+/* SPI NAND commands */
+#define SPINAND_CMD_RESET		0xff
+#define SPINAND_CMD_READ_ID		0x9f
+#define SPINAND_CMD_GET_FEATURE		0x0f
+#define SPINAND_CMD_SET_FEATURE		0x1f
+#define SPINAND_CMD_PAGE_READ		0x13
+#define SPINAND_CMD_READ_CACHE		0x03
+
+#define SPINAND_FEATURE_CONFIG		0xb0
+#define SPINAND_FEATURE_STATUS		0xc0
+#define SPINAND_CFG_ECC_EN		BIT(4)
+#define WINBOND_CFG_BUF_READ		BIT(3)
+#define SPINAND_STATUS_BUSY		BIT(0)
+
+/*
+ * Geometry. Everything this loader needs is a page size, a block size and the
+ * offset of the bad block marker. Reading the ONFI-ish parameter page would
+ * mean a second command path for a value that is the same on every part these
+ * boards use, so the sizes are fixed and only checked against the id.
+ */
+#define SPINAND_PAGE_SIZE		2048
+#define SPINAND_OOB_SIZE		64
+#define SPINAND_PAGES_PER_BLOCK		64
+#define SPINAND_BLOCK_SIZE		(SPINAND_PAGE_SIZE * SPINAND_PAGES_PER_BLOCK)
+
+/*
+ * Every wait here is bounded. An unbounded one costs more than a failed read:
+ * the SPL wedges, and a wedged SPL takes the BROM's FEL loop down with it, so
+ * the board stops responding to the host entirely and only a power cycle gets
+ * it back.
+ */
+#define SPI_WAIT_LOOPS		1000000
+
+static int spinand_xfer(const u8 *txbuf, u32 tcnt, u8 *rxbuf, u32 rcnt)
+{
+	int timeout;
+	u32 i;
+
+	writel(0, SPI_IER);
+	writel(0xffffffff, SPI_ISR);
+	writel(SPI_FCR_TXFIFO_RST | SPI_FCR_RXFIFO_RST | readl(SPI_FCR),
+	       SPI_FCR);
+
+	writel(tcnt, SPI_MTC);
+	writel(tcnt + rcnt, SPI_MBC);
+	/* single-wire for the whole burst: no dummy, no quad */
+	writel(tcnt, SPI_BCC);
+
+	for (i = 0; i < tcnt; i++)
+		writeb(txbuf[i], SPI_TXD);
+
+	writel(readl(SPI_TCR) | SPI_TCR_EXCHANGE, SPI_TCR);
+
+	for (i = 0; i < rcnt; i++) {
+		timeout = SPI_WAIT_LOOPS;
+		while (!(readl(SPI_FSR) & 0x7f))
+			if (--timeout <= 0) {
+				printf("SPI NAND: rx timeout at %u/%u, FSR=%08x ISR=%08x TCR=%08x\n",
+				       i, rcnt, readl(SPI_FSR), readl(SPI_ISR),
+				       readl(SPI_TCR));
+				return -ETIMEDOUT;
+			}
+		rxbuf[i] = readb(SPI_RXD);
+	}
+
+	timeout = SPI_WAIT_LOOPS;
+	while (readl(SPI_TCR) & SPI_TCR_EXCHANGE)
+		if (--timeout <= 0) {
+			printf("SPI NAND: xfer timeout, TCR=%08x ISR=%08x\n",
+			       readl(SPI_TCR), readl(SPI_ISR));
+			return -ETIMEDOUT;
+		}
+
+	writel(0xffffffff, SPI_ISR);
+
+	return 0;
+}
+
+static u8 spinand_get_feature(u8 reg)
+{
+	u8 tx[2] = { SPINAND_CMD_GET_FEATURE, reg };
+	u8 rx = 0;
+
+	if (spinand_xfer(tx, sizeof(tx), &rx, 1))
+		return 0xff;
+
+	return rx;
+}
+
+static void spinand_set_feature(u8 reg, u8 val)
+{
+	u8 tx[3] = { SPINAND_CMD_SET_FEATURE, reg, val };
+
+	spinand_xfer(tx, sizeof(tx), NULL, 0);
+}
+
+static int spinand_wait_ready(void)
+{
+	int timeout = 100000;
+
+	while (timeout--) {
+		if (!(spinand_get_feature(SPINAND_FEATURE_STATUS) &
+		      SPINAND_STATUS_BUSY))
+			return 0;
+		udelay(1);
+	}
+
+	return -ETIMEDOUT;
+}
+
+static int spinand_hw_init(void)
+{
+	int timeout;
+	u32 val;
+
+#if CONFIG_IS_ENABLED(SPINAND_SUNXI_SPI1)
+	/* The BROM's SPI0 link ends here; subsequent reads target the real NAND. */
+	val = readl(PIO_PD_CFG1_REG);
+	val = (val & ~0x00ffff00) | 0x00444400;
+	writel(val, PIO_PD_CFG1_REG);
+#else
+	val = readl(PIO_PC_CFG0_REG);
+	val = (val & ~0x00ffff00) | 0x00222200;
+	writel(val, PIO_PC_CFG0_REG);
+#endif
+
+	/* 24MHz straight off the oscillator: no PLL, and no sample tuning */
+	writel(CCU_CLK_ENABLE | CCU_CLK_SRC_HOSC, CCU_SPI_CLK_REG);
+
+	/* ungate and release reset */
+	val = readl(CCU_SPI_BGR_REG);
+	writel(val & ~CCU_SPI_RST, CCU_SPI_BGR_REG);
+	writel(val | CCU_SPI_GATE | CCU_SPI_RST, CCU_SPI_BGR_REG);
+
+	writel(SPI_GCR_SOFT_RST | SPI_GCR_TXPAUSE_EN | SPI_GCR_MASTER |
+	       SPI_GCR_ENABLE, SPI_GCR);
+	timeout = SPI_WAIT_LOOPS;
+	while (readl(SPI_GCR) & SPI_GCR_SOFT_RST)
+		if (--timeout <= 0) {
+			printf("SPI NAND: controller stuck in reset, GCR=%08x\n",
+			       readl(SPI_GCR));
+			return -ETIMEDOUT;
+		}
+
+	/*
+	 * SS idles high and is driven by the controller, discard the unused
+	 * part of a burst, and sample on the delayed edge -- the <= 24MHz
+	 * case in boot0's calibration, where nothing has to be measured.
+	 */
+	writel(SPI_TCR_SET_SS_1 | SPI_TCR_DHB | SPI_TCR_SS_ACTIVE0 |
+	       SPI_TCR_SAMPLE_MODE, SPI_TCR);
+
+	writel(SPI_FCR_TXFIFO_RST | SPI_FCR_RXFIFO_RST | (32 << 16) | 32,
+	       SPI_FCR);
+	writel(0, SPI_CCR);
+
+	return 0;
+}
+
+static int spinand_init(void)
+{
+	u8 tx[2] = { SPINAND_CMD_RESET, 0 };
+	u8 id[4] = { 0 };
+	u8 idcmd[2] = { SPINAND_CMD_READ_ID, 0 };
+
+	if (spinand_hw_init())
+		return -ETIMEDOUT;
+
+	if (spinand_xfer(tx, 1, NULL, 0))
+		return -ETIMEDOUT;
+	udelay(2000);
+	if (spinand_wait_ready())
+		return -ETIMEDOUT;
+
+	if (spinand_xfer(idcmd, sizeof(idcmd), id, 2))
+		return -ETIMEDOUT;
+	if (id[0] == 0x00 || id[0] == 0xff) {
+		printf("SPI NAND: no chip (id %02x %02x)\n", id[0], id[1]);
+		return -ENODEV;
+	}
+	printf("SPI%u NAND: id %02x %02x\n", SPINAND_BUS, id[0], id[1]);
+
+	/*
+	 * Leave the on-die ECC engine on. It is what makes a plain read
+	 * trustworthy without carrying a BCH implementation in the SPL, and
+	 * the BROM read this very chip the same way to get us here.
+	 */
+	spinand_set_feature(SPINAND_FEATURE_CONFIG,
+			    spinand_get_feature(SPINAND_FEATURE_CONFIG) |
+			    SPINAND_CFG_ECC_EN |
+			    (id[0] == 0xef ? WINBOND_CFG_BUF_READ : 0));
+
+	return 0;
+}
+
+/* Read one page into buf; column selects main area (0) or OOB. */
+static int spinand_read_page(u32 page, u32 column, u8 *buf, u32 len)
+{
+	u8 tx[4];
+
+	tx[0] = SPINAND_CMD_PAGE_READ;
+	tx[1] = (page >> 16) & 0xff;
+	tx[2] = (page >> 8) & 0xff;
+	tx[3] = page & 0xff;
+	if (spinand_xfer(tx, 4, NULL, 0))
+		return -ETIMEDOUT;
+
+	if (spinand_wait_ready())
+		return -ETIMEDOUT;
+
+	tx[0] = SPINAND_CMD_READ_CACHE;
+	tx[1] = (column >> 8) & 0xff;
+	tx[2] = column & 0xff;
+	tx[3] = 0x00;			/* one dummy byte */
+
+	return spinand_xfer(tx, 4, buf, len);
+}
+
+/*
+ * A block is bad when the first byte of the spare area of its first page is
+ * not 0xff. The marker is written by the factory and preserved by anything
+ * that erases responsibly, so this is the same test the BROM and boot0 use.
+ */
+static int spinand_block_is_bad(u32 block)
+{
+	u8 marker = 0xff;
+
+	if (spinand_read_page(block * SPINAND_PAGES_PER_BLOCK,
+			      SPINAND_PAGE_SIZE, &marker, 1))
+		return 1;
+
+	return marker != 0xff;
+}
+
+/* FIT callbacks use byte offsets, including offsets within a page. */
+static int spinand_read(u32 offs, void *dst, u32 len)
+{
+	u32 block = CONFIG_SYS_SPINAND_U_BOOT_OFFS / SPINAND_BLOCK_SIZE;
+	u32 skip;
+	u8 *out = dst;
+
+	if (offs < CONFIG_SYS_SPINAND_U_BOOT_OFFS)
+		return -EINVAL;
+	skip = offs - CONFIG_SYS_SPINAND_U_BOOT_OFFS;
+
+	/* Bad-block scanning must not consume the following partition. */
+	while (len && block < ((CONFIG_SYS_SPINAND_U_BOOT_OFFS +
+			       CONFIG_SYS_SPINAND_U_BOOT_SIZE) / SPINAND_BLOCK_SIZE)) {
+		u32 page, column;
+
+		if (spinand_block_is_bad(block)) {
+			block++;
+			continue;
+		}
+		if (skip >= SPINAND_BLOCK_SIZE) {
+			skip -= SPINAND_BLOCK_SIZE;
+			block++;
+			continue;
+		}
+
+		page = skip / SPINAND_PAGE_SIZE;
+		column = skip % SPINAND_PAGE_SIZE;
+		skip = 0;
+		for (; page < SPINAND_PAGES_PER_BLOCK && len; page++) {
+			u32 chunk = min_t(u32, SPINAND_PAGE_SIZE - column, len);
+
+			if (spinand_read_page(block * SPINAND_PAGES_PER_BLOCK +
+					      page, column, out, chunk))
+				return -EIO;
+			out += chunk;
+			len -= chunk;
+			column = 0;
+		}
+		block++;
+	}
+
+	return len ? -ENOSPC : 0;
+}
+
+static ulong spl_spinand_read(struct spl_load_info *load, ulong sector,
+			      ulong count, void *buf)
+{
+	if (spinand_read(sector, buf, count))
+		return 0;
+
+	return count;
+}
+
+static int spl_spinand_load_image(struct spl_image_info *spl_image,
+				  struct spl_boot_device *bootdev)
+{
+	struct legacy_img_hdr *header;
+	struct spl_load_info load;
+	int ret;
+
+	ret = spinand_init();
+	if (ret)
+		return ret;
+
+	header = spl_get_load_buffer(0, sizeof(*header));
+	ret = spinand_read(CONFIG_SYS_SPINAND_U_BOOT_OFFS, header,
+			   sizeof(*header));
+	if (ret)
+		return ret;
+
+	spl_load_init(&load, spl_spinand_read, NULL, 1);
+
+	return spl_load(spl_image, bootdev, &load,
+			0, CONFIG_SYS_SPINAND_U_BOOT_OFFS);
+}
+
+SPL_LOAD_IMAGE_METHOD("sunxi SPI NAND", 0, BOOT_DEVICE_NAND,
+		      spl_spinand_load_image);
