diff --git a/board/sunxi/bmc_ota.c b/board/sunxi/bmc_ota.c
new file mode 100644
index 00000000..4e9ce7fa
--- /dev/null
+++ b/board/sunxi/bmc_ota.c
@@ -0,0 +1,377 @@
+// SPDX-License-Identifier: GPL-2.0+
+#include <config.h>
+#include <image.h>
+#include <hang.h>
+#include <malloc.h>
+#include <time.h>
+#include <asm/io.h>
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <u-boot/crc.h>
+#include <u-boot/sha256.h>
+#ifdef CONFIG_XPL_BUILD
+#include <spl.h>
+#include <spl_load.h>
+#else
+#include <command.h>
+#include <console.h>
+#include <env.h>
+#include <mtd.h>
+#include <linux/mtd/mtd.h>
+#include <ch32_swio.h>
+#endif
+
+#define OTA_MAGIC 0x31555042
+#define OTA_RAM ((u8 *)0x41000000UL)
+#define OTA_MAX (4 * 1024 * 1024)
+#define OTA_SPI_CDR2 1
+#define OTA_CS_GAP_US 200
+#define OTA_PROBE_TIMEOUT_MS 500
+#define OTA_IDLE_TIMEOUT_MS 120000
+struct ota_frame {
+	u32 magic, op, session, seq, offset, length, arg, status;
+	u8 data[2016];
+	u32 crc;
+};
+static struct ota_frame tx, rx;
+static u32 total, consumed, durable, target, session, seq;
+static u8 expected[32];
+static sha256_context hash;
+#define REG(a) ((void __iomem *)(ulong)(a))
+#define SPI(r) REG(0x04025000 + (r))
+
+static int ota_spi_init(void)
+{
+	u32 v = readl(REG(0x02000060));
+	int n = 100000;
+	writel((v & ~0x00ffff00) | 0x00222200, REG(0x02000060));
+	writel(BIT(31), REG(0x02001940));
+	v = readl(REG(0x0200196c));
+	writel(v & ~BIT(16), REG(0x0200196c));
+	writel(v | BIT(16) | BIT(0), REG(0x0200196c));
+	writel(BIT(31) | BIT(7) | BIT(1) | BIT(0), SPI(4));
+	while (readl(SPI(4)) & BIT(31))
+		if (!--n) return -ETIMEDOUT;
+	writel(BIT(7) | BIT(6) | BIT(2), SPI(8));
+	writel(BIT(12) | OTA_SPI_CDR2, SPI(0x24));
+	return 0;
+}
+
+static int ota_xfer(void)
+{
+	u8 *out = (u8 *)&tx, *in = (u8 *)&rx;
+	unsigned int sent = 0, got = 0, n = 10000000;
+	tx.magic = OTA_MAGIC;
+	tx.crc = crc32(0, out, 2048);
+	udelay(OTA_CS_GAP_US);
+	writel(BIT(31) | BIT(15), SPI(0x18));
+	writel(~0U, SPI(0x14));
+	writel(sizeof(tx), SPI(0x30));
+	writel(sizeof(tx), SPI(0x34));
+	writel(sizeof(tx), SPI(0x38));
+	while (sent < 64) writeb(out[sent++], SPI(0x200));
+	writel((readl(SPI(8)) & ~BIT(7)) | BIT(31), SPI(8));
+	while (got < sizeof(rx)) {
+		u32 fsr = readl(SPI(0x1c));
+		unsigned int r = fsr & 0x7f, room = 64 - ((fsr >> 16) & 0x7f);
+		while (r-- && got < sizeof(rx)) in[got++] = readb(SPI(0x300));
+		while (room-- && sent < sizeof(tx)) writeb(out[sent++], SPI(0x200));
+		if (!--n) goto timeout;
+	}
+	while (readl(SPI(8)) & BIT(31)) if (!--n) goto timeout;
+	writel(readl(SPI(8)) | BIT(7), SPI(8));
+	if (rx.magic != OTA_MAGIC || rx.length > sizeof(rx.data) ||
+					crc32(0, in, 2048) != rx.crc) return -EBADMSG;
+	return 0;
+timeout:
+	writel(readl(SPI(8)) | BIT(7), SPI(8));
+	return -ETIMEDOUT;
+}
+
+#ifndef CONFIG_XPL_BUILD
+static struct mtd_info *nand;
+static u8 *block, *verify, *touch_image;
+static u32 fill;
+static u64 physical;
+static u32 saved_flags;
+
+static void nand_close(void)
+{
+	if (nand) { nand->flags = saved_flags; put_mtd_device(nand); nand = NULL; }
+	free(block); free(verify); block = verify = NULL;
+	free(touch_image); touch_image = NULL;
+}
+
+static int nand_begin(void)
+{
+	const char *name = target == 1 ? "boot" : target == 2 ? "rootfs" : "uboot";
+	u64 good = 0, pos;
+	int ret;
+	if (target == 5) return total <= 32 * 1024 * 1024 ? 0 : -EFBIG;
+	if (target == 6) {
+		if (total > CH32_SWIO_FLASH_SIZE || total % 4) return -EINVAL;
+		touch_image = malloc(total);
+		return touch_image ? 0 : -ENOMEM;
+	}
+	if (target < 1 || target > 3) return -EINVAL;
+	if (target == 2 && total % 131072) return -EINVAL;
+	mtd_probe_devices();
+	nand = get_mtd_device_nm(name);
+	if (IS_ERR(nand)) { ret = PTR_ERR(nand); nand = NULL; return ret; }
+	saved_flags = nand->flags;
+	if (nand->type != MTD_NANDFLASH || !nand->erasesize ||
+					nand->size % nand->erasesize || total > nand->size) return -EINVAL;
+	for (pos = 0; pos < nand->size; pos += nand->erasesize) {
+		ret = mtd_block_isbad(nand, pos);
+		if (ret < 0) return ret;
+		if (!ret) good += nand->erasesize;
+	}
+	if (total > good) return -ENOSPC;
+	block = malloc(nand->erasesize); verify = malloc(nand->erasesize);
+	if (!block || !verify) return -ENOMEM;
+	memset(block, 0xff, nand->erasesize); fill = 0; physical = 0;
+	return 0;
+}
+
+static int next_good(void)
+{
+	int ret;
+	while (physical < nand->size) {
+		ret = mtd_block_isbad(nand, physical);
+		if (ret <= 0) return ret;
+		physical += nand->erasesize;
+	}
+	return -ENOSPC;
+}
+
+static int flush_block(bool erase_only)
+{
+	struct erase_info erase = {0};
+	size_t done, len;
+	int ret = next_good();
+	if (ret) return ret;
+	erase.addr = physical; erase.len = nand->erasesize;
+	/* Only this whitelisted partition is writable, only during the operation. */
+	nand->flags |= MTD_WRITEABLE;
+	ret = mtd_erase(nand, &erase);
+	if (!ret && !erase_only) {
+		len = ALIGN(fill, nand->writesize);
+		ret = mtd_write(nand, physical, len, &done, block);
+		if (!ret && done != len) ret = -EIO;
+		if (!ret) {
+			ret = mtd_read(nand, physical, len, &done, verify);
+			if (mtd_is_bitflip(ret)) ret = 0;
+			if (!ret && (done != len || memcmp(block, verify, len))) ret = -EIO;
+		}
+	}
+	nand->flags = saved_flags;
+	if (ret) return ret;
+	physical += nand->erasesize;
+	if (!erase_only) { durable += fill; fill = 0; memset(block, 0xff, nand->erasesize); }
+	return 0;
+}
+#endif
+
+static int accept_begin(void)
+{
+	if (rx.seq != 1 || rx.offset || rx.length != 40 || !rx.session) return -EINVAL;
+	memcpy(&total, rx.data, 4); memcpy(&target, rx.data + 4, 4);
+	if (!total) return -EINVAL;
+	memcpy(expected, rx.data + 8, 32);
+	session = rx.session; consumed = durable = 0; seq = 0;
+	sha256_starts(&hash);
+#ifdef CONFIG_XPL_BUILD
+	return target == 4 && total <= OTA_MAX ? 0 : -EINVAL;
+#else
+	return nand_begin();
+#endif
+}
+
+static int accept_data(void)
+{
+	if (!rx.length || rx.offset != consumed || rx.length > total - consumed) return -EINVAL;
+#ifdef CONFIG_XPL_BUILD
+	memcpy(OTA_RAM + consumed, rx.data, rx.length);
+#else
+	if (target == 6) {
+		memcpy(touch_image + consumed, rx.data, rx.length);
+	} else if (target != 5) {
+		u32 off = 0;
+		while (off < rx.length) {
+			u32 n = min_t(u32, rx.length - off, nand->erasesize - fill);
+			memcpy(block + fill, rx.data + off, n); fill += n; off += n;
+			if (fill == nand->erasesize) { int ret = flush_block(false); if (ret) return ret; }
+		}
+	}
+#endif
+	sha256_update(&hash, rx.data, rx.length);
+	consumed += rx.length;
+	return 0;
+}
+
+static int accept_end(void)
+{
+	u8 digest[32];
+	int ret = 0;
+	if (rx.length || rx.offset != total || consumed != total) return -EINVAL;
+	sha256_finish(&hash, digest);
+	if (memcmp(digest, expected, 32)) return -EBADMSG;
+#ifdef CONFIG_XPL_BUILD
+	if (total < sizeof(struct fdt_header) || fdt_check_header(OTA_RAM) ||
+					fdt_totalsize(OTA_RAM) > total) return -EINVAL;
+#endif
+#ifndef CONFIG_XPL_BUILD
+	if (target == 6) {
+		ret = ch32_swio_flash(touch_image, total);
+		if (!ret) durable = total;
+		return ret;
+	}
+	if (nand && fill) ret = flush_block(false);
+	while (!ret && target == 2 && physical < nand->size) {
+		ret = flush_block(true);
+		if (ret == -ENOSPC && physical == nand->size) ret = 0;
+	}
+#endif
+	return ret;
+}
+
+/* A repeated response is ACKed again; it never advances the NAND cursor. */
+static int ota_receive(bool probe)
+{
+	unsigned long progress;
+	bool active = false, completed = false;
+	u32 last_crc = 0;
+	int ret;
+	session = seq = consumed = durable = 0;
+	ret = ota_spi_init(); if (ret) return ret;
+	memset(&tx, 0, sizeof(tx)); tx.op = 1;
+	tx.arg = IS_ENABLED(CONFIG_XPL_BUILD) ? 1 : 2;
+	progress = get_timer(0);
+	for (;;) {
+		if (get_timer(progress) >= (probe && !active ?
+				OTA_PROBE_TIMEOUT_MS : OTA_IDLE_TIMEOUT_MS)) {
+			ret = -ETIMEDOUT;
+			break;
+		}
+		ret = ota_xfer();
+		if (ret)
+			continue;
+#ifndef CONFIG_XPL_BUILD
+		if (ctrlc()) { ret = -ECANCELED; break; }
+#endif
+		if (rx.op == 13) { ret = -ECANCELED; break; }
+		if (rx.op == 0) {
+			if (rx.arg > 1 || rx.length || rx.session || rx.seq ||
+			    rx.offset || rx.status) { ret = -EINVAL; break; }
+			if (probe && !active && !rx.arg) {
+				ret = IS_ENABLED(CONFIG_XPL_BUILD) ? -ENOENT : 0;
+				break;
+			}
+			if (rx.arg == 1 && !active) {
+				active = true; probe = false;
+				progress = get_timer(0);
+			}
+			if (tx.op != 3) tx.op = 1;
+			continue;
+		}
+		if (active && session && rx.session == session && rx.seq == seq) {
+			if (rx.crc != last_crc) { ret = -EINVAL; break; }
+			continue;
+		}
+		if (rx.op == 10 && (!session || (completed && rx.session != session))) {
+#ifndef CONFIG_XPL_BUILD
+			nand_close();
+#endif
+			active = true; completed = false; probe = false; ret = accept_begin();
+		} else if (completed || rx.session != session || rx.seq != seq + 1 || !session) {
+			ret = -EINVAL;
+		} else if (rx.op == 11) ret = accept_data();
+		else if (rx.op == 12) ret = accept_end();
+		else ret = -EINVAL;
+		if (ret) break;
+		progress = get_timer(0); seq = rx.seq; last_crc = rx.crc;
+		memset(&tx, 0, sizeof(tx)); tx.op = 3; tx.session = session;
+		tx.seq = seq; tx.offset = consumed; tx.arg = durable;
+		if (rx.op == 12) {
+			completed = true;
+			/* Push END ACK physically before SPL can jump or U-Boot returns. */
+			ret = ota_xfer();
+#ifndef CONFIG_XPL_BUILD
+			if (ret == -EBADMSG) ret = 0;
+#endif
+#ifdef CONFIG_XPL_BUILD
+			/* IDLE proves the peer consumed END ACK before we change boot stage. */
+			while ((ret || rx.op != 0) &&
+			       get_timer(progress) < OTA_IDLE_TIMEOUT_MS)
+				ret = ota_xfer();
+			if (ret || rx.op != 0) ret = -ETIMEDOUT;
+			break;
+#else
+			if (ret) break;
+			printf("BMC OTA verified: target %u, %u bytes\n", target, total);
+			nand_close();
+			/* END is still replayable while the host prepares the next image. */
+#endif
+		}
+	}
+	if (ret && !(IS_ENABLED(CONFIG_XPL_BUILD) && ret == -ENOENT)) {
+		memset(&tx, 0, sizeof(tx)); tx.op = 4; tx.session = session;
+		tx.seq = seq; tx.offset = consumed; tx.arg = durable; tx.status = -ret;
+		if (rx.session && rx.op >= 10 && rx.op <= 13) {
+			tx.session = rx.session;
+			tx.seq = rx.seq;
+		}
+		ota_xfer();
+	}
+#ifndef CONFIG_XPL_BUILD
+	nand_close();
+	env_set("bmcota_active", active ? "1" : "0");
+#endif
+	return ret;
+}
+
+#ifdef CONFIG_XPL_BUILD
+static ulong ota_read(struct spl_load_info *load, ulong offset, ulong count, void *buf)
+{
+	ulong available, padded;
+
+	if (total > OTA_MAX || offset > total) return 0;
+	padded = ((ulong)total + 3) & ~3UL;
+	if (count > padded - offset) return 0;
+	available = total - offset;
+	if (available > count) available = count;
+	memcpy(buf, OTA_RAM + offset, available);
+	/* The FIT loader rounds its metadata read to four bytes. */
+	memset((u8 *)buf + available, 0, count - available);
+	return count;
+}
+static int ota_load(struct spl_image_info *image, struct spl_boot_device *bootdev)
+{
+	struct spl_load_info load;
+	int ret = ota_receive(true);
+
+	if (ret == -ENOENT)
+		return ret;
+	if (!ret) {
+		spl_load_init(&load, ota_read, NULL, 1);
+		ret = spl_load(image, bootdev, &load, total, 0);
+	}
+	/* An update must never continue through an old or partially written NAND. */
+	if (ret) {
+		printf("BMC update failed: %d; refusing NAND fallback\n", ret);
+		hang();
+	}
+	return 0;
+}
+SPL_LOAD_IMAGE_METHOD("BMC update probe", 0, BOOT_DEVICE_BOARD, ota_load);
+#else
+static int do_bmcota(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	int ret;
+	if (argc > 2 || (argc == 2 && strcmp(argv[1], "probe"))) return CMD_RET_USAGE;
+	ret = ota_receive(argc == 2);
+	if (ret) printf("BMC OTA stopped: %d; restart upload from offset zero\n", ret);
+	return ret ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+U_BOOT_CMD(bmcota, 2, 0, do_bmcota, "receive BMC SPI0 firmware update", "[probe]");
+#endif
diff --git a/board/sunxi/board-riscv.c b/board/sunxi/board-riscv.c
new file mode 100644
index 00000000..b9a14142
--- /dev/null
+++ b/board/sunxi/board-riscv.c
@@ -0,0 +1,818 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Board code for the RISC-V sunxi SoCs (Allwinner D1/D1s).
+ *
+ * (C) Copyright 2012-2013 Henrik Nordstrom <henrik@henriknordstrom.net>
+ * (C) Copyright 2013 Luke Kenneth Casson Leighton <lkcl@lkcl.net>
+ * (C) Copyright 2007-2011 Allwinner Technology Co., Ltd. <www.allwinnertech.com>
+ *
+ * Counterpart of board/sunxi/board.c, which is ARM-only: it reaches into
+ * asm/arch/{clock,cpu,dram,prcm,display}.h, none of which exist here, and
+ * drives the DRAM controller and pinmux directly. On the D1 all of that comes
+ * from the device tree via DM instead, so this file only carries what is left:
+ * decoding the BROM's SPL header and bringing DRAM up in the SPL.
+ */
+
+#include <cpu.h>
+#include <dm.h>
+#include <env.h>
+#include <env_internal.h>
+#include <fdt_support.h>
+#include <generic-phy.h>
+#include <image.h>
+#include <init.h>
+#include <mmc.h>
+#include <net.h>
+#include <phy-sun4i-usb.h>
+#include <ram.h>
+#include <spl.h>
+#include <usb.h>
+#include <asm/arch/clock.h>
+#include <asm/arch/cpu.h>
+#include <asm/arch/spl.h>
+#include <asm/csr.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <u-boot/crc.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define SUNXI_INVALID_BOOT_SOURCE	-1
+#define SUNXI_RTC_GP_DATA		0x100
+#define SUNXI_RTC_MSTM_FEL_INDEX	7
+#define SUNXI_RTC_MSTM_FEL_MAGIC	0x4d53544d
+
+/*
+ * The CCU driver has no consumer for PLL6 in the SPL, but the shared MMC
+ * driver needs its rate to compute the mod clock divider, and reaches for it
+ * through this legacy non-DM entry point.
+ */
+unsigned int clock_get_pll6(void)
+{
+	u32 rval = readl((void *)(ulong)(SUNXI_CCM_BASE + CCU_PLL6_CFG));
+	int n = ((rval & CCM_PLL6_CTRL_N_MASK) >> CCM_PLL6_CTRL_N_SHIFT) + 1;
+	int div1 = ((rval & CCM_PLL6_CTRL_P0_MASK) >>
+		    CCM_PLL6_CTRL_P0_SHIFT) + 1;
+	int div2 = ((rval & CCM_PLL6_CTRL_DIV2_MASK) >>
+		    CCM_PLL6_CTRL_DIV2_SHIFT) + 1;
+
+	/* the register describes PLL6-2X, not plain PLL6 */
+	return 24000000U * n / 2 / div1 / div2;
+}
+
+int sunxi_get_sid(unsigned int *sid)
+{
+	int i;
+
+	for (i = 0; i < 4; i++)
+		sid[i] = readl((void *)(ulong)(SUNXI_SID_BASE + 4 * i));
+
+	return 0;
+}
+
+static int sunxi_egon_valid(struct boot_file_head *egon_head)
+{
+	return !memcmp(egon_head->magic, BOOT0_MAGIC, 8); /* eGON.BT0 */
+}
+
+static int sunxi_toc0_valid(struct toc0_main_info *toc0_info)
+{
+	return !memcmp(toc0_info->name, TOC0_MAIN_INFO_NAME, 8); /* TOC0.GLH */
+}
+
+static int sunxi_get_boot_source(void)
+{
+	struct boot_file_head *egon_head = (void *)SPL_ADDR;
+	struct toc0_main_info *toc0_info = (void *)SPL_ADDR;
+
+	if (sunxi_egon_valid(egon_head))
+		return readb(&egon_head->boot_media);
+	if (sunxi_toc0_valid(toc0_info))
+		return readb(&toc0_info->platform[0]);
+
+	/* Not a valid image, so we must have been booted via FEL. */
+	return SUNXI_INVALID_BOOT_SOURCE;
+}
+
+/*
+ * The sunxi BROM tries to load the external bootloader from mmc0, NAND flash
+ * or mmc2. When booting over USB in FEL mode the 'eGON.BT0' signature is
+ * patched out by the host-side 'fel'/'xfel' tool, which is how we tell the
+ * two apart.
+ */
+uint32_t sunxi_get_boot_device(void)
+{
+	int boot_source = sunxi_get_boot_source();
+
+	/* SPI NAND backup copies encode their index above the low media nibble. */
+	if ((boot_source & 0xf) == SUNXI_BOOTED_FROM_SPI_NAND)
+		boot_source = SUNXI_BOOTED_FROM_SPI_NAND;
+
+	switch (boot_source) {
+	case SUNXI_INVALID_BOOT_SOURCE:
+		return BOOT_DEVICE_BOARD;
+	case SUNXI_BOOTED_FROM_MMC0:
+	case SUNXI_BOOTED_FROM_MMC0_HIGH:
+		return BOOT_DEVICE_MMC1;
+	case SUNXI_BOOTED_FROM_NAND:
+		return BOOT_DEVICE_NAND;
+	case SUNXI_BOOTED_FROM_MMC2:
+	case SUNXI_BOOTED_FROM_MMC2_HIGH:
+		return BOOT_DEVICE_MMC2;
+	case SUNXI_BOOTED_FROM_SPI:
+		return BOOT_DEVICE_SPI;
+	case SUNXI_BOOTED_FROM_SPI_NAND:
+		/*
+		 * Deliberately not BOOT_DEVICE_SPI: that one belongs to the
+		 * NOR loader, which probes for a JEDEC SPI flash and finds
+		 * nothing on a NAND part.
+		 */
+		return BOOT_DEVICE_NAND;
+	}
+
+	panic("Unknown boot source %d\n", boot_source);
+	return -1;		/* Never reached */
+}
+
+#ifdef CONFIG_XPL_BUILD
+
+uint32_t sunxi_get_spl_size(void)
+{
+	struct boot_file_head *egon_head = (void *)SPL_ADDR;
+	struct toc0_main_info *toc0_info = (void *)SPL_ADDR;
+
+	if (sunxi_egon_valid(egon_head))
+		return readl(&egon_head->length);
+	if (sunxi_toc0_valid(toc0_info))
+		return readl(&toc0_info->length);
+
+	/* Not a valid image, so use the default U-Boot offset. */
+	return 0;
+}
+
+/*
+ * The eGON SPL image can be located at 8KB or at 128KB into an SD card or an
+ * eMMC device. The boot source has bit 4 set in the latter case; add 120KB to
+ * the normal offset to cover both. U-Boot proper is located at least 32KB
+ * after the SPL, but immediately follows it if the SPL is bigger than that.
+ */
+unsigned long board_spl_mmc_get_uboot_raw_sector(struct mmc *mmc,
+						 unsigned long raw_sect)
+{
+	unsigned long spl_size = sunxi_get_spl_size();
+	unsigned long sector;
+
+	sector = max(raw_sect, spl_size / 512);
+
+	switch (sunxi_get_boot_source()) {
+	case SUNXI_BOOTED_FROM_MMC0_HIGH:
+	case SUNXI_BOOTED_FROM_MMC2_HIGH:
+		sector += (128 - 8) * 2;
+		break;
+	}
+
+	return sector;
+}
+
+u32 spl_boot_device(void)
+{
+	return sunxi_get_boot_device();
+}
+
+void board_boot_order(u32 *spl_boot_list)
+{
+	u32 boot = spl_boot_device();
+
+	if (IS_ENABLED(CONFIG_SPL_BMC_OTA) && boot == BOOT_DEVICE_NAND) {
+		spl_boot_list[0] = BOOT_DEVICE_BOARD;
+		spl_boot_list[1] = BOOT_DEVICE_NAND;
+	} else {
+		spl_boot_list[0] = boot;
+	}
+}
+
+/*
+ * C906 extension CSRs. The values come from the Allwinner BSP; the register
+ * layout is only documented in the T-Head C906 manual.
+ *
+ * MXSTATUS 0x638000: THEADISAEE | MAEE | CLINTEE | UCME | MM
+ * MCOR     0x70013:  invalidate and enable both caches plus the branch
+ *                    predictors
+ * MHCR     0x11ff:   caches on, write-back, write-allocate, RS/BP/BTB on,
+ *                    write burst on
+ * MHINT    0x16e30c: i/dcache prefetch, way prediction, AMR limit 3
+ */
+#define CSR_MXSTATUS		0x7c0
+#define CSR_MHCR		0x7c1
+#define CSR_MCOR		0x7c2
+#define CSR_MHINT		0x7c5
+
+#ifdef CONFIG_SUNXI_DRAM_VCC_AXP209_DCDC2
+/*
+ * VCC-DRAM comes from AXP209 DCDC2, which powers up at ~1.25V. That suits the
+ * T113-s3's in-package DDR3, but the D1s carries DDR2 and needs 1.8V; without
+ * this the DRAM training never completes and the board wedges hard enough to
+ * take the BROM's FEL loop with it.
+ *
+ * This has to happen before the DRAM controller is touched, so it cannot wait
+ * for the I2C/PMIC uclasses -- poke TWI0 directly. The ARM sunxi board code
+ * does the equivalent from sunxi_board_init() via axp_init(), but that path
+ * does not exist here.
+ */
+#define CCU_TWI_BGR_REG		0x0200191c
+#define CCU_TWI0_GATE		BIT(0)
+#define CCU_TWI0_RST		BIT(16)
+
+#define PIO_PB_CFG0_REG		0x02000030
+#define PB2_PB3_I2C0		((4 << 8) | (4 << 12))
+
+#define TWI0_BASE		0x02502000UL
+#define TWI_DATA		(TWI0_BASE + 0x08)
+#define TWI_CNTR		(TWI0_BASE + 0x0c)
+#define TWI_STAT		(TWI0_BASE + 0x10)
+#define TWI_CCR			(TWI0_BASE + 0x14)
+#define TWI_SRST		(TWI0_BASE + 0x18)
+
+#define CNTR_BUS_EN		BIT(6)
+#define CNTR_M_STA		BIT(5)
+#define CNTR_M_STP		BIT(4)
+#define CNTR_INT_FLAG		BIT(3)
+
+/* mv64xxx-style status codes */
+#define STAT_START_SENT		0x08
+#define STAT_ADDR_W_ACK		0x18
+#define STAT_DATA_W_ACK		0x28
+
+#define AXP209_ADDR		0x34
+#define AXP209_DCDC2_REG	0x23
+#define AXP209_DCDC2_1V8	((1800 - 700) / 25)	/* 0.7V + N*25mV */
+
+#define TWI_TIMEOUT		1000000
+
+static inline u32 sunxi_rd(ulong addr)
+{
+	return readl((void *)addr);
+}
+
+static inline void sunxi_wr(ulong addr, u32 val)
+{
+	writel(val, (void *)addr);
+}
+
+static int twi_wait(void)
+{
+	int t = TWI_TIMEOUT;
+
+	while (!(sunxi_rd(TWI_CNTR) & CNTR_INT_FLAG))
+		if (--t <= 0)
+			return -ETIMEDOUT;
+
+	return sunxi_rd(TWI_STAT);
+}
+
+/* sun6i and later clear INT_FLAG by writing a 1 to it */
+static void twi_next(u32 extra)
+{
+	sunxi_wr(TWI_CNTR, CNTR_BUS_EN | CNTR_INT_FLAG | extra);
+}
+
+static void twi_stop(void)
+{
+	int t = TWI_TIMEOUT;
+
+	twi_next(CNTR_M_STP);
+	while ((sunxi_rd(TWI_CNTR) & CNTR_M_STP) && --t > 0)
+		;
+}
+
+static int pmic_write_reg(u8 dev, u8 reg, u8 val)
+{
+	int t = 1000;
+
+	sunxi_wr(TWI_SRST, 1);
+	while ((sunxi_rd(TWI_SRST) & 1) && --t > 0)
+		;
+
+	sunxi_wr(TWI_CCR, (11 << 3) | 1);	/* 24MHz/(10*2*12) = 100kHz */
+	sunxi_wr(TWI_CNTR, CNTR_BUS_EN);
+
+	sunxi_wr(TWI_CNTR, CNTR_BUS_EN | CNTR_M_STA);
+	if (twi_wait() != STAT_START_SENT)
+		goto fail;
+
+	sunxi_wr(TWI_DATA, dev << 1);
+	twi_next(0);
+	if (twi_wait() != STAT_ADDR_W_ACK)
+		goto fail;
+
+	sunxi_wr(TWI_DATA, reg);
+	twi_next(0);
+	if (twi_wait() != STAT_DATA_W_ACK)
+		goto fail;
+
+	sunxi_wr(TWI_DATA, val);
+	twi_next(0);
+	if (twi_wait() != STAT_DATA_W_ACK)
+		goto fail;
+
+	twi_stop();
+	return 0;
+
+fail:
+	twi_stop();
+	return -EIO;
+}
+
+static void sunxi_raise_vcc_dram(void)
+{
+	u32 cfg;
+
+	sunxi_wr(CCU_TWI_BGR_REG,
+		 sunxi_rd(CCU_TWI_BGR_REG) | CCU_TWI0_RST | CCU_TWI0_GATE);
+
+	cfg = sunxi_rd(PIO_PB_CFG0_REG);
+	cfg &= ~0x0000ff00;
+	cfg |= PB2_PB3_I2C0;
+	sunxi_wr(PIO_PB_CFG0_REG, cfg);
+
+	if (pmic_write_reg(AXP209_ADDR, AXP209_DCDC2_REG, AXP209_DCDC2_1V8))
+		printf("PMIC: failed to raise VCC-DRAM to 1.8V\n");
+	else
+		printf("PMIC: VCC-DRAM (DCDC2) -> 1.8V for DDR2\n");
+}
+#else
+static void sunxi_raise_vcc_dram(void) {}
+#endif /* CONFIG_SUNXI_DRAM_VCC_AXP209_DCDC2 */
+
+int spl_board_init_f(void)
+{
+	struct ram_info info;
+	struct udevice *dev;
+	int ret;
+
+	ret = cpu_probe_all();
+	if (ret)
+		debug("CPU init failed: %d\n", ret);
+
+	/* must happen before the DRAM controller is brought up */
+	sunxi_raise_vcc_dram();
+
+	ret = uclass_get_device(UCLASS_RAM, 0, &dev);
+	if (ret) {
+		debug("DRAM init failed: %d\n", ret);
+		return ret;
+	}
+
+	if (!ram_get_info(dev, &info))
+		printf("DRAM: %lu MiB at 0x%lx\n",
+		       (ulong)(info.size >> 20), (ulong)info.base);
+
+	if (IS_ENABLED(CONFIG_SPL_RETURN_TO_FEL) &&
+	    readl((void *)(ulong)(SUNXI_RTC_BASE + SUNXI_RTC_GP_DATA +
+				       SUNXI_RTC_MSTM_FEL_INDEX * sizeof(u32))) ==
+	    SUNXI_RTC_MSTM_FEL_MAGIC) {
+		writel(0, (void *)(ulong)(SUNXI_RTC_BASE + SUNXI_RTC_GP_DATA +
+					  SUNXI_RTC_MSTM_FEL_INDEX * sizeof(u32)));
+		printf("MSTM FEL request: DRAM ready, entering FEL\n");
+		enter_fel();
+	}
+
+	/*
+	 * Booted over FEL there is no boot medium to load U-Boot proper from,
+	 * but DRAM is up by now. Hand control back to the BROM's FEL loop and
+	 * let the host push the next stage straight into DRAM over USB. Any
+	 * other boot source falls through to the normal SPL path.
+	 */
+	if (IS_ENABLED(CONFIG_SPL_RETURN_TO_FEL) &&
+	    sunxi_get_boot_device() == BOOT_DEVICE_BOARD) {
+		printf("FEL boot: DRAM ready, returning to FEL\n");
+		return_to_fel();
+	}
+
+
+
+	csr_set(CSR_MXSTATUS, 0x638000);
+	csr_write(CSR_MCOR, 0x70013);
+	csr_write(CSR_MHCR, 0x11ff);
+	csr_write(CSR_MHINT, 0x16e30c);
+
+	return 0;
+}
