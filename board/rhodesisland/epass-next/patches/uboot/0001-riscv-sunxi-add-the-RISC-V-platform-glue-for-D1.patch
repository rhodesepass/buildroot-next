diff --git a/arch/riscv/dts/sunxi-u-boot.dtsi b/arch/riscv/dts/sunxi-u-boot.dtsi
new file mode 100644
index 00000000..964d0cf6
--- /dev/null
+++ b/arch/riscv/dts/sunxi-u-boot.dtsi
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Picked up automatically for any sunxi board, because CONFIG_SYS_SOC is
+ * "sunxi" (see u_boot_dtsi_options in scripts/Makefile.lib).
+ *
+ * The SPL device tree is built by keeping only the nodes marked bootph-all,
+ * so everything the SPL touches before DRAM is up has to be listed here:
+ * the CCU, the DRAM controller, the pinctrl and the console UART.
+ */
+
+#include "binman.dtsi"
+
+/ {
+	cpus {
+		bootph-all;
+	};
+
+	soc {
+		bootph-all;
+	};
+};
+
+&binman {
+	u-boot-sunxi-with-spl {
+		filename = "u-boot-sunxi-with-spl.bin";
+		pad-byte = <0xff>;
+
+		blob@0 {
+			/*
+			 * This value matches SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR
+			 * and SYS_SPI_U_BOOT_OFFS if those are defined.
+			 */
+			min-size = <0x8000>;
+			filename = "spl/sunxi-spl.bin";
+		};
+
+		blob@1 {
+			filename = "u-boot.itb";
+		};
+	};
+};
+
+&ccu {
+	bootph-all;
+};
+
+&cpu0 {
+	bootph-all;
+};
+
+&dcxo {
+	bootph-all;
+};
+
+&mbus {
+	bootph-all;
+};
+
+&mmc0 {
+	bootph-all;
+};
+
+&mmc0_pins {
+	bootph-all;
+};
+
+&pio {
+	bootph-all;
+};
+
+&uart3_pb_pins {
+	bootph-all;
+};
+
+&rtc {
+	bootph-all;
+};
+
+&uart3 {
+	bootph-all;
+};
diff --git a/arch/riscv/include/asm/arch-sunxi/clock.h b/arch/riscv/include/asm/arch-sunxi/clock.h
new file mode 100644
index 00000000..3a96fad3
--- /dev/null
+++ b/arch/riscv/include/asm/arch-sunxi/clock.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Clock bits the shared sunxi drivers reach for through <asm/arch/clock.h>.
+ *
+ * On ARM this resolves to clock_sun50i_h6.h, which also carries the whole
+ * legacy non-DM clock API. Here everything but the MMC mod clock comes from
+ * the CCU driver via DM, so only that is defined.
+ */
+#ifndef _SUNXI_CLOCK_H
+#define _SUNXI_CLOCK_H
+
+#include <asm/arch/cpu.h>
+
+#define CCU_PLL6_CFG			0x020
+
+#define CCM_PLL6_CTRL_P0_SHIFT		16
+#define CCM_PLL6_CTRL_P0_MASK		(0x7 << CCM_PLL6_CTRL_P0_SHIFT)
+#define CCM_PLL6_CTRL_N_SHIFT		8
+#define CCM_PLL6_CTRL_N_MASK		(0xff << CCM_PLL6_CTRL_N_SHIFT)
+#define CCM_PLL6_CTRL_DIV2_SHIFT	1
+#define CCM_PLL6_CTRL_DIV2_MASK		(0x1 << CCM_PLL6_CTRL_DIV2_SHIFT)
+
+/* MMC clock bit field */
+#define CCM_MMC_CTRL_M(x)		((x) - 1)
+#define CCM_MMC_CTRL_N(x)		((x) << 8)
+#define CCM_MMC_CTRL_OSCM24		(0x0 << 24)
+#define CCM_MMC_CTRL_PLL6		(0x1 << 24)
+#define CCM_MMC_CTRL_PLL_PERIPH2X2	(0x2 << 24)
+#define CCM_MMC_CTRL_ENABLE		(0x1 << 31)
+/* No output/sample clock delays on this generation */
+#define CCM_MMC_CTRL_OCLK_DLY(a)	((void)(a), 0)
+#define CCM_MMC_CTRL_SCLK_DLY(a)	((void)(a), 0)
+
+#ifndef __ASSEMBLY__
+unsigned int clock_get_pll6(void);
+#endif
+
+#endif /* _SUNXI_CLOCK_H */
diff --git a/arch/riscv/include/asm/arch-sunxi/cpu.h b/arch/riscv/include/asm/arch-sunxi/cpu.h
new file mode 100644
index 00000000..04c831eb
--- /dev/null
+++ b/arch/riscv/include/asm/arch-sunxi/cpu.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Memory map for the RISC-V sunxi SoCs (D1/D1s).
+ *
+ * The D1 shares its peripheral layout with the ARM R528/T113 (SUNXI_GEN_NCAT2),
+ * so these match arch/arm/include/asm/arch-sunxi/cpu_sunxi_ncat2.h. Only the
+ * bases actually referenced from shared driver or board code are listed;
+ * everything else comes from the device tree.
+ */
+#ifndef _SUNXI_CPU_H
+#define _SUNXI_CPU_H
+
+#define SUNXI_SRAM_A1_BASE		0x00020000
+
+#define SUNXI_SRAMC_BASE		0x03000000
+
+#define SUNXI_PIO_BASE			0x02000000
+#define SUNXI_CCM_BASE			0x02001000
+#define SUNXI_UART0_BASE		0x02500000
+#define SUNXI_TWI0_BASE			0x02502000
+#define SUNXI_SID_BASE			0x03006200
+#define SUNXI_RTC_BASE			0x07090000
+#define SUNXI_MMC0_BASE			0x04020000
+#define SUNXI_MMC1_BASE			0x04021000
+#define SUNXI_MMC2_BASE			0x04022000
+#define SUNXI_SPI0_BASE			0x04025000
+
+#endif /* _SUNXI_CPU_H */
diff --git a/arch/riscv/include/asm/arch-sunxi/fel.h b/arch/riscv/include/asm/arch-sunxi/fel.h
new file mode 100644
index 00000000..512c2899
--- /dev/null
+++ b/arch/riscv/include/asm/arch-sunxi/fel.h
@@ -0,0 +1,173 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Assembly hooks the D1 SPL needs before anything else runs, kept out of
+ * arch/riscv/cpu/start.S so the generic startup path stays generic.
+ *
+ * Only included from start.S, and only when the matching Kconfig option is
+ * set, so everything here is a macro rather than code.
+ */
+#ifndef _ASM_ARCH_FEL_H_
+#define _ASM_ARCH_FEL_H_
+
+#if defined(CONFIG_SUNXI_SPL_EARLY_UART) && defined(CONFIG_XPL_BUILD)
+/*
+ * Bring up uart3 (PB6/PB7 or PG8/PG9) before anything else, so CONFIG_DEBUG_UART works
+ * from the very first instruction. This also lets the SPL be the first thing
+ * executed over FEL after a reset: xfel writes SRAM as data and never
+ * invalidates the icache, so running a helper payload to configure the UART
+ * beforehand would leave stale instructions cached at 0x20000.
+ *
+ * 0x0200190c: CCU UART_BGR, gate + reset for uart3
+ * 0x02000030: PIO PB_CFG0, PB6/PB7 -> uart3 (function 7)
+ * 0x02500c00: uart3 registers, 8n1 at 24MHz/16/13 = 115200
+ */
+#if defined(CONFIG_SUNXI_SPL_UART3_PG)
+#define SUNXI_UART3_PINCFG 0x02000124
+#define SUNXI_UART3_PINMASK 0xffffff00
+#define SUNXI_UART3_PINMUX 0x00000055
+#else
+#define SUNXI_UART3_PINCFG 0x02000030
+#define SUNXI_UART3_PINMASK 0x00ffffff
+#define SUNXI_UART3_PINMUX 0x77000000
+#endif
+#define SUNXI_EARLY_UART_INIT		\
+	li	t0, 0x0200190c;		\
+	lw	t1, 0(t0);		\
+	li	t2, 0x00080008;		\
+	or	t1, t1, t2;		\
+	sw	t1, 0(t0);		\
+	li	t0, SUNXI_UART3_PINCFG;		\
+	lw	t1, 0(t0);		\
+	li	t2, SUNXI_UART3_PINMASK;		\
+	and	t1, t1, t2;		\
+	li	t2, SUNXI_UART3_PINMUX;		\
+	or	t1, t1, t2;		\
+	sw	t1, 0(t0);		\
+	li	t0, 0x02500c00;		\
+	li	t1, 0x83;		\
+	sw	t1, 0x0c(t0);		\
+	li	t1, 13;			\
+	sw	t1, 0x00(t0);		\
+	sw	zero, 0x04(t0);		\
+	li	t1, 0x03;		\
+	sw	t1, 0x0c(t0);		\
+	li	t1, 0x07;		\
+	sw	t1, 0x08(t0)
+#else
+#define SUNXI_EARLY_UART_INIT
+#endif
+
+#if defined(CONFIG_SPL_RETURN_TO_FEL) && defined(CONFIG_XPL_BUILD)
+
+/*
+ * Storage for the BROM's state, so the SPL can hand control back to the FEL
+ * loop once DRAM is up. The ARM sunxi code has return_to_fel() for this;
+ * RISC-V never got one.
+ *
+ * This lives in .data (SRAM), not .bss: the SPL's BSS sits in DRAM and is not
+ * cleared until after board_init_f() returns.
+ */
+#define SUNXI_FEL_STASH_DEFINE			\
+	.section .data;				\
+	.align 3;				\
+	.globl fel_stash;			\
+fel_stash:					\
+	.rept 19; /* ra sp gp tp s0-s11 tvec ie status */ \
+	.dword 0;				\
+	.endr;					\
+	.section .text
+
+/*
+ * Save everything the BROM expects to survive a call. The SPL does not honour
+ * the calling convention at all -- it uses tp as the hart id and s0 as the
+ * global data pointer -- so returning to FEL needs the full callee-saved set
+ * restored, not just ra/sp.
+ *
+ * The BROM's FEL loop is also interrupt driven, and the SPL is about to point
+ * tvec at its own handler and mask every interrupt, which would leave USB dead
+ * on return. Stash the three CSRs as well.
+ */
+#define SUNXI_FEL_STASH_SAVE		\
+	la	t0, fel_stash;		\
+	sd	ra, 0(t0);		\
+	sd	sp, 8(t0);		\
+	sd	gp, 16(t0);		\
+	sd	tp, 24(t0);		\
+	sd	s0, 32(t0);		\
+	sd	s1, 40(t0);		\
+	sd	s2, 48(t0);		\
+	sd	s3, 56(t0);		\
+	sd	s4, 64(t0);		\
+	sd	s5, 72(t0);		\
+	sd	s6, 80(t0);		\
+	sd	s7, 88(t0);		\
+	sd	s8, 96(t0);		\
+	sd	s9, 104(t0);		\
+	sd	s10, 112(t0);		\
+	sd	s11, 120(t0);		\
+	csrr	t1, MODE_PREFIX(tvec);	\
+	sd	t1, 128(t0);		\
+	csrr	t1, MODE_PREFIX(ie);	\
+	sd	t1, 136(t0);		\
+	csrr	t1, MODE_PREFIX(status);\
+	sd	t1, 144(t0)
+
+/*
+ * Hand control back to the BROM's FEL loop, with DRAM already initialised.
+ * Caches are dropped first: the SPL turned them on, and the BROM's USB
+ * transfers write memory behind our back.
+ */
+#define SUNXI_FEL_RETURN_DEFINE		\
+	.globl return_to_fel;		\
+return_to_fel:				\
+	addi	sp, sp, -16;		\
+	sd	ra, 8(sp);		\
+	jal	dcache_disable;		\
+	fence.i;			\
+	ld	ra, 8(sp);		\
+	addi	sp, sp, 16;		\
+	la	t0, fel_stash;		\
+	ld	ra, 0(t0);		\
+	ld	sp, 8(t0);		\
+	ld	gp, 16(t0);		\
+	ld	tp, 24(t0);		\
+	ld	s0, 32(t0);		\
+	ld	s1, 40(t0);		\
+	ld	s2, 48(t0);		\
+	ld	s3, 56(t0);		\
+	ld	s4, 64(t0);		\
+	ld	s5, 72(t0);		\
+	ld	s6, 80(t0);		\
+	ld	s7, 88(t0);		\
+	ld	s8, 96(t0);		\
+	ld	s9, 104(t0);		\
+	ld	s10, 112(t0);		\
+	ld	s11, 120(t0);		\
+	ld	t1, 128(t0);		\
+	csrw	MODE_PREFIX(tvec), t1;	\
+	ld	t1, 136(t0);		\
+	csrw	MODE_PREFIX(ie), t1;	\
+	ld	t1, 144(t0);		\
+	csrw	MODE_PREFIX(status), t1;\
+	ret
+
+#else /* !CONFIG_SPL_RETURN_TO_FEL */
+#define SUNXI_FEL_STASH_DEFINE
+#define SUNXI_FEL_STASH_SAVE
+#define SUNXI_FEL_RETURN_DEFINE
+#endif
+
+/* The normal boot path has no saved FEL call frame to restore. */
+#if defined(CONFIG_XPL_BUILD)
+#define SUNXI_FEL_ENTER_DEFINE		\
+	.globl enter_fel;		\
+enter_fel:				\
+	jal	dcache_disable;		\
+	fence.i;			\
+	li	t0, 0x20;		\
+	jr	t0
+#else
+#define SUNXI_FEL_ENTER_DEFINE
+#endif
+
+#endif /* _ASM_ARCH_FEL_H_ */
diff --git a/arch/riscv/include/asm/arch-sunxi/spl.h b/arch/riscv/include/asm/arch-sunxi/spl.h
new file mode 100644
index 00000000..d899d061
--- /dev/null
+++ b/arch/riscv/include/asm/arch-sunxi/spl.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * RISC-V counterpart of arch/arm/include/asm/arch-sunxi/spl.h.
+ *
+ * The eGON/TOC0 header layout is a property of the BROM, not of the CPU, so
+ * these match the ARM definitions. Only the ARMv5-era SUNIV boot sources are
+ * left out; no such part exists on the RISC-V side.
+ */
+#ifndef _ASM_ARCH_SPL_H_
+#define _ASM_ARCH_SPL_H_
+
+#include <sunxi_image.h>
+
+#define SPL_ADDR		CONFIG_SUNXI_SRAM_ADDRESS
+
+/* The low 8-bits of the 'boot_media' field in the SPL header */
+#define SUNXI_BOOTED_FROM_MMC0	0
+#define SUNXI_BOOTED_FROM_NAND	1
+#define SUNXI_BOOTED_FROM_MMC2	2
+#define SUNXI_BOOTED_FROM_SPI	3
+/*
+ * D1 BROM uses low nibble 4 for SPI NAND and the high nibble for the backup
+ * copy index: 0x04, 0x14, ... . This encoding does not change the NAND FIT
+ * partition offset. MMC0_HIGH/MMC2_HIGH retain their separate meanings.
+ */
+#define SUNXI_BOOTED_FROM_SPI_NAND	4
+#define SUNXI_BOOTED_FROM_MMC0_HIGH	0x10
+#define SUNXI_BOOTED_FROM_MMC2_HIGH	0x12
+
+uint32_t sunxi_get_boot_device(void);
+uint32_t sunxi_get_spl_size(void);
+
+/* arch/riscv/cpu/start.S */
+void return_to_fel(void);
+void enter_fel(void);
+
+#endif
diff --git a/arch/riscv/include/asm/processor.h b/arch/riscv/include/asm/processor.h
index fe357529..60a73c9b 100644
--- a/arch/riscv/include/asm/processor.h
+++ b/arch/riscv/include/asm/processor.h
@@ -23,4 +23,14 @@
  *     no one uses the macros defined in this head file.
  **************************************************************/
 
+#include <linux/compiler.h>
+
+/*
+ * Busy-wait hint, as arch/{arm,mips}/include/asm/processor.h define it.
+ * Drivers shared with Linux (musb, and the polling loops in linux/compat.h)
+ * expect it to exist. There is no RISC-V equivalent of ARM's YIELD in the
+ * base ISA, so a compiler barrier is all this can be.
+ */
+#define cpu_relax()	barrier()
+
 #endif /* __ASM_RISCV_PROCESSOR_H */
diff --git a/board/sunxi/Kconfig.riscv b/board/sunxi/Kconfig.riscv
new file mode 100644
index 00000000..1566b4a0
--- /dev/null
+++ b/board/sunxi/Kconfig.riscv
@@ -0,0 +1,244 @@
+# SPDX-License-Identifier: GPL-2.0+
+#
+# Sunxi (Allwinner) support for the RISC-V SoCs: D1 and D1s (sun20i).
+#
+# Everything the ARM sunxi boards need lives in arch/arm/mach-sunxi/Kconfig,
+# inside "if ARCH_SUNXI", so none of it is reachable from a RISC-V build.
+# Rather than move symbols the ARM boards depend on, the subset the D1 needs
+# is redeclared here. Types must match the ARM definitions exactly, or Kconfig
+# reports a type clash while parsing both trees.
+#
+# BOARD_SUNXI is the RISC-V counterpart of ARCH_SUNXI. The SPL needs full DM
+# here: unlike the ARM SPL, which pokes the DRAM controller directly, the D1
+# brings DRAM up through a UCLASS_RAM driver described by the device tree.
+
+config BOARD_SUNXI
+	bool
+	select BINMAN
+	select CLK
+	select CMD_GPIO if GPIO
+	select CMD_MMC if MMC
+	select DM
+	select DM_GPIO if GPIO
+	select DM_I2C if I2C
+	select DM_SERIAL if SERIAL
+	select DM_SPI if SPI
+	select DM_SPI_FLASH if SPI
+	select OF_BOARD_SETUP
+	select OF_CONTROL
+	select PINCTRL
+	select RAM
+	select SPECIFY_CONSOLE_INDEX
+	select SPL_CLK
+	select SPL_DM if SPL
+	select SPL_DM_SPI if SPL_DM && SPL_SPI
+	select SPL_DM_SPI_FLASH if SPL_DM && SPL_SPI
+	select SPL_OF_CONTROL if SPL_DM
+	select SPL_PINCTRL if SPL_DM
+	select SPL_PINCONF if SPL_DM
+	select SPL_RAM if SPL_DM
+	select SPL_SEPARATE_BSS if SPL
+	select SUNXI_GPIO
+	select SUPPORT_SPL
+	select ENV_RELOC_GD_ENV_ADDR
+	select USE_PREBOOT
+	imply BOARD_LATE_INIT
+	imply CMD_DM
+	imply CMD_GPT
+	imply DM_REGULATOR
+	imply DM_REGULATOR_FIXED
+	imply FAT_WRITE
+	imply FIT
+	imply MMC
+	imply OF_LIBFDT_OVERLAY
+	imply PRE_CONSOLE_BUFFER
+	imply SPL
+	imply SPL_GPIO
+	imply SPL_LIBCOMMON_SUPPORT
+	imply SPL_LIBGENERIC_SUPPORT
+	imply SPL_LOAD_FIT
+	imply SPL_MMC if MMC
+	imply SPL_POWER
+	imply SPL_SERIAL
+	imply SYS_I2C_MVTWSI
+	imply SYS_NS16550
+	imply SYSRESET
+	imply SYSRESET_SBI
+	imply SYSRESET_WATCHDOG
+	imply SYSRESET_WATCHDOG_AUTO
+	imply USB
+	imply USB_GADGET
+	imply WDT
+
+if BOARD_SUNXI
+
+config SUNXI_GEN_NCAT2
+	bool
+	select MMC_SUNXI_HAS_NEW_MODE
+	help
+	  Select this for sunxi SoCs which have D1-like peripherals, clocks
+	  and memory map.
+
+config SUNXI_SRAM_ADDRESS
+	hex
+	default 0x20000
+	help
+	  The D1 maps its boot ROM at address 0 and SRAM A1 at 0x20000, so the
+	  SPL is entered there rather than at address 0 as on the older,
+	  ARMv5-era parts.
+
+config SUNXI_MINIMUM_DRAM_MB
+	int
+	default 64
+	help
+	  Minimum DRAM size expected on the board. With co-packaged DRAM this
+	  is well below the 256 MB the older boards assumed, so U-Boot's own
+	  load address and the default payload addresses must be shifted down.
+
+config MMC_SUNXI_SLOT_EXTRA
+	int
+	default -1
+	help
+	  Extra MMC slot number, or -1 for none. Only used to pick the device
+	  the environment lives on; the controllers themselves come from DT.
+
+config SPL_RETURN_TO_FEL
+	bool "Return to the BROM's FEL loop when booted over USB"
+	depends on SPL
+	help
+	  When the SPL was pushed in over FEL there is no boot medium to load
+	  U-Boot proper from, but DRAM is up by the time the SPL is done with
+	  it. Say y to hand control back to the BROM's FEL loop at that point,
+	  so the host can push the next stage straight into DRAM over USB.
+
+	  This is what you want while bringing a board up with no boot media
+	  populated. Any other boot source is unaffected.
+
+config SUNXI_SPL_EARLY_UART
+	bool "Configure uart3 at the top of the SPL"
+	depends on SPL && DEBUG_UART
+	help
+	  Set up uart3 in the first instructions of the SPL, before anything
+	  else runs, so CONFIG_DEBUG_UART produces output from the very start.
+
+	  This matters when loading the SPL over FEL: xfel writes SRAM as data
+	  and never invalidates the icache, so running a separate helper
+	  payload to configure the UART beforehand would leave stale
+	  instructions cached at the SPL's entry point.
+
+	  The register addresses are hardcoded for the D1/D1s. Say n if the
+	  console is on a different UART.
+
+config SUNXI_SPL_UART3_PG
+	bool "Route SPL UART3 to PG8/PG9"
+	depends on SUNXI_SPL_EARLY_UART
+	help
+	  Use the ePass BMC UART pins instead of the default PB6/PB7.
+	  The board device tree must select the same pins for later stages.
+
+config SUNXI_DRAM_VCC_AXP209_DCDC2
+	bool "Raise AXP209 DCDC2 to 1.8V before DRAM init"
+	help
+	  On boards where VCC-DRAM is supplied by an AXP209 DCDC2 that powers
+	  up at ~1.25V, in-package DDR2 needs it raised to 1.8V before the DRAM
+	  controller is touched, or training never completes. Enabling this
+	  pokes TWI0 directly from the SPL, well before the I2C and PMIC
+	  uclasses are available.
+
+# The ARM side offers a choice between eGON and the secure-boot TOC0 in
+# board/sunxi/Kconfig, which only arch/arm/mach-sunxi/Kconfig sources. There is
+# no TOC0 support for these parts, so just pin the type.
+config SPL_IMAGE_TYPE
+	default "sunxi_egon"
+
+config IDENT_STRING
+	default " Allwinner Technology"
+
+config SYS_BOARD
+	default "sunxi"
+
+config SYS_SOC
+	default "sunxi"
+
+config SYS_CPU
+	default "thead"
+
+config SYS_CONFIG_NAME
+	default "sun20i"
+
+config SYS_CLK_FREQ
+	default 1008000000
+
+config SYS_LOAD_ADDR
+	default 0x41000000
+
+config PRE_CON_BUF_ADDR
+	default 0x43000000
+
+config SPL_TEXT_BASE
+	default 0x20060
+
+config SPL_MAX_SIZE
+	# SRAM A1 is 160 KB at 0x20000, less the 0x60 eGON header.
+	default 0x27fa0
+
+config SPL_STACK
+	default 0x48000
+
+config SPL_BSS_START_ADDR
+	default 0x43f80000
+
+config SPL_STACK_R_ADDR
+	default 0x43e00000
+
+config SPL_OPENSBI_LOAD_ADDR
+	default 0x40000000
+
+config SPL_SPINAND_SUNXI
+	bool "SPL support for SPI NAND on RISC-V sunxi"
+	depends on SPL
+	default y
+	help
+	  Let the SPL read the next stage out of a SPI NAND. The BROM can
+	  already load the SPL itself from one, but nothing else in U-Boot
+	  can read further: spl_spi.c probes for a JEDEC SPI NOR and
+	  spl_spi_sunxi.c is both NOR-only and ARM-only. Boards whose only
+	  medium is SPI NAND -- which is what the D1s designs are -- cannot
+	  boot without this.
+
+config SPL_SPINAND_SUNXI_SPI1
+	bool "Read the physical NAND on SPI1 PD10-PD15"
+	depends on SPL_SPINAND_SUNXI
+	help
+	  Use SPI1 after the BROM loads SPL from the BMC on SPI0.
+	  The physical NAND remains the source of U-Boot and the OS.
+
+config SYS_SPINAND_U_BOOT_OFFS
+	hex "Offset of U-Boot proper in the SPI NAND"
+	depends on SPL_SPINAND_SUNXI
+	default 0x40000
+	help
+	  Where the SPL looks for u-boot.itb. Must be erase block aligned and
+	  must agree with the partition table in the board device tree.
+
+config SYS_SPINAND_U_BOOT_SIZE
+	hex "Size of the U-Boot SPI NAND partition"
+	depends on SPL_SPINAND_SUNXI
+	default 0x100000
+	help
+	  Bound bad-block scanning to this partition; must match the board DTS.
+
+endif
+
+config BMC_OTA
+ bool "ePass BMC SPI0 updater"
+ depends on TARGET_SUN20I_D1
+ select SHA256
+ select CH32_SWIO
+
+config SPL_BMC_OTA
+ bool "Probe ePass BMC for an external update FIT before NAND boot"
+ depends on TARGET_SUN20I_D1 && SPL
+ default y
+ select SPL_SHA256
+ select SPL_CRC32
