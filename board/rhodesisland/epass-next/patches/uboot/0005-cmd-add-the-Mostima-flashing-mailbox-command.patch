 # Wolfgang Denk, DENX Software Engineering, wd@denx.de.
@@ -119,6 +120,7 @@ obj-$(CONFIG_CMD_MISC) += misc.o
 obj-$(CONFIG_CMD_MDIO) += mdio.o
 obj-$(CONFIG_CMD_PAUSE) += pause.o
 obj-$(CONFIG_CMD_SLEEP) += sleep.o
+obj-$(CONFIG_CMD_MSTMCHK) += mstmchk.o
 obj-$(CONFIG_CMD_MMC) += mmc.o
 obj-$(CONFIG_CMD_OPTEE_RPMB) += optee_rpmb.o
 obj-$(CONFIG_CMD_OPTEE) += optee.o
diff --git a/cmd/ch32.c b/cmd/ch32.c
new file mode 100644
index 00000000..ec85a195
--- /dev/null
+++ b/cmd/ch32.c
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: MIT
+#include <ch32_swio.h>
+#include <command.h>
+#include <mapmem.h>
+#include <linux/string.h>
+#include <vsprintf.h>
+
+static int do_ch32(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	ulong addr, len;
+	void *data;
+	int ret;
+
+	if (argc == 2 && !strcmp(argv[1], "info")) {
+		ret = ch32_swio_probe();
+	} else if (argc == 4 && (!strcmp(argv[1], "read") ||
+				 !strcmp(argv[1], "write"))) {
+		if (strict_strtoul(argv[2], 16, &addr) ||
+		    strict_strtoul(argv[3], 16, &len) || !len ||
+		    len > CH32_SWIO_FLASH_SIZE || addr + len < addr)
+			return CMD_RET_USAGE;
+		data = map_sysmem(addr, len);
+		if (!strcmp(argv[1], "read"))
+			ret = ch32_swio_read(data, len);
+		else
+			ret = ch32_swio_flash(data, len);
+		unmap_sysmem(data);
+	} else {
+		return CMD_RET_USAGE;
+	}
+	if (ret)
+		printf("CH32 operation failed: %d\n", ret);
+	else
+		printf("CH32 operation complete\n");
+	return ret ? CMD_RET_FAILURE : CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(ch32, 4, 0, do_ch32, "CH32V006 touch-controller programmer",
+	"info\n"
+	"ch32 read <RAM-address> <length>\n"
+	"ch32 write <RAM-address> <length>\n"
+	"  Main flash starts at 08000000; maximum length f800; values are hex.\n"
+	"  Every operation resets the target; writes verify every page.");
diff --git a/cmd/mstmchk.c b/cmd/mstmchk.c
new file mode 100644
index 00000000..a20457fd
--- /dev/null
+++ b/cmd/mstmchk.c
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Read the Mostima flashing mailbox out of DRAM.
+ *
+ * The host flasher initialises DRAM over FEL, drops a header plus an env
+ * fragment at a fixed address, then loads and runs U-Boot from DRAM. This
+ * command is how bootcmd finds out it was started to flash the board rather
+ * than to boot it.
+ *
+ *   0x00  8  magic "Mostima_"
+ *   0x08  1  boot type: 1 = NAND flow, 2 = SD flow      -> ${mstm_ret}
+ *   0x09  1  flags                                      -> ${mstm_flags}
+ *   0x0a  2  padding
+ *   0x0c  4  u32 LE length of the env payload, incl NUL -> read by the env
+ *   0x10  n  env text for "env import -t"
+ *
+ * The result comes back in environment variables, not in the command's exit
+ * status: hush only records success/failure, so a status byte cannot survive
+ * the trip. Same reason the previous generation ended up here.
+ */
+
+#include <command.h>
+#include <env.h>
+#include <mapmem.h>
+#include <vsprintf.h>
+#include <linux/types.h>
+
+#define MSTMCHK_MAGIC	0x5f616d6974736f4dULL	/* "Mostima_" */
+
+static int do_mstmchk(struct cmd_tbl *cmdtp, int flag, int argc,
+		      char *const argv[])
+{
+	void *buf;
+	u64 magic;
+	u8 next, flags;
+	char val[8];
+
+	if (argc != 1)
+		return CMD_RET_USAGE;
+
+	env_set("mstm_ret", "0");
+	env_set("mstm_flags", "0");
+
+	buf = map_sysmem(CONFIG_MSTMCHK_ADDR, 10);
+	if (!buf)
+		return CMD_RET_SUCCESS;
+
+	magic = *(u64 *)buf;
+	if (magic != MSTMCHK_MAGIC) {
+		unmap_sysmem(buf);
+		return CMD_RET_SUCCESS;
+	}
+
+	next = *((u8 *)buf + 8);
+	flags = *((u8 *)buf + 9);
+	unmap_sysmem(buf);
+
+	snprintf(val, sizeof(val), "%u", next);
+	env_set("mstm_ret", val);
+
+	/* setexpr takes its operands as hex, so hand it something unambiguous */
+	snprintf(val, sizeof(val), "0x%x", flags);
+	env_set("mstm_flags", val);
+
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(
+	mstmchk, 1, 0, do_mstmchk,
+	"read the Mostima flashing mailbox into mstm_ret/mstm_flags",
+	""
+);
