From: shirogane <artoriapendragon123@gmail.com>
Subject: [PATCH 5/5] cmd: add the Mostima flashing mailbox command

The host flasher brings up DRAM over FEL, leaves a header there saying which
board this is and what to wipe, and then runs U-Boot out of that same DRAM.
mstmchk is how bootcmd finds the header: without it a U-Boot started this way
is indistinguishable from one that booted normally, and there is nowhere else
to put the information -- the board has no storage that is guaranteed
readable at that point, which is usually the reason it is being flashed.

The answer comes back in mstm_ret and mstm_flags rather than in the command's
exit status, because hush only preserves success/failure and the boot type
needs more range than that. The previous generation learned this the hard way
and its first version, which returned the type as the exit code, is still in
its tree as a fossil.

The address is a Kconfig option rather than a constant: it has to be
somewhere the firmware loaded alongside it does not land and somewhere U-Boot
does not relocate onto, which makes it a property of the board's memory map.

Format, matching the F1C generation byte for byte so that one host-side
flasher drives both:

  0x00  8  magic "Mostima_"
  0x08  1  boot type: 1 = NAND flow, 2 = SD flow
  0x09  1  flags
  0x0a  2  padding
  0x0c  4  u32 LE length of the env payload, including its NUL
  0x10  n  env text, for "env import -t"
---
diff --git a/cmd/Kconfig b/cmd/Kconfig
index c71c6824..2cfd7b1a 100644
--- a/cmd/Kconfig
+++ b/cmd/Kconfig
@@ -1,3 +1,10 @@
+config CH32_SWIO
+	bool "D1 CH32V006 touch-controller SWIO programmer"
+	depends on TARGET_SUN20I_D1 && RISCV
+	help
+	  Program the CH32V006 main flash through PG13 SWIO and PG15 reset.
+	  Uses the fixed 24 MHz D1 timebase. Option bytes are never modified.
+
 menuconfig CMDLINE
 	bool "Command line interface"
 	default y
@@ -11,6 +18,13 @@ menuconfig CMDLINE
 
 if CMDLINE
 
+config CMD_CH32
+	bool "ch32 - inspect/read/program CH32V006 touch firmware"
+	depends on CH32_SWIO
+	help
+	  Provides ch32 info, ch32 read <addr> <len>, and
+	  ch32 write <addr> <len>. Length and RAM addresses are hexadecimal.
+
 config HUSH_PARSER
 	bool "Use hush shell"
 	help
@@ -1477,6 +1491,25 @@ config CMD_MISC
 	  a MISC uclass driver. The command provides listing all MISC devices
 	  as well as read and write functionalities via their drivers.
 
+config CMD_MSTMCHK
+	bool "mstmchk"
+	help
+	  Read the Mostima flashing mailbox left in DRAM by the host flasher
+	  and report it in the mstm_ret and mstm_flags environment variables.
+	  bootcmd dispatches on those to decide whether it was started to
+	  flash the board or to boot it.
+
+config MSTMCHK_ADDR
+	hex "Address of the Mostima mailbox"
+	depends on CMD_MSTMCHK
+	default 0x40100000
+	help
+	  Where the host flasher puts the mailbox. It has to be somewhere the
+	  firmware being loaded alongside it does not land, and somewhere U-Boot
+	  does not relocate onto, so it is board specific -- set it in the board
+	  defconfig next to the rest of the memory map rather than trusting the
+	  default.
+
 config CMD_MMC
 	bool "mmc"
 	depends on MMC
diff --git a/cmd/Makefile b/cmd/Makefile
index bbbdfcc4..e0f8b8ab 100644
--- a/cmd/Makefile
+++ b/cmd/Makefile
@@ -1,4 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0+
+obj-$(CONFIG_CMD_CH32) += ch32.o
 #
