+		USBC_ConfigFIFO_Base();
 	USBC_EnableDpDmPullUp(musb->mregs);
 	USBC_EnableIdPullUp(musb->mregs);
 
@@ -517,18 +532,32 @@ static int musb_usb_remove(struct udevice *dev)
