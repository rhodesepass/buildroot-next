+		else
+			chk = CFG_SYS_SDRAM_BASE + (1U << 22);
 		ptr = CFG_SYS_SDRAM_BASE;
 		for (i = 0, j = 0; i < 64; i++) {
 			if (readl(chk) != get_payload(i & 1, ptr)) {
@@ -1122,13 +1147,7 @@ static int auto_scan_dram_size(const dram_para_t *para, dram_config_t *config)
 		}
 
 		debug("rank %d bank = %d\n", rank, (j + 1) << 2); /* 4 or 8 */
-
-		/* Store banks in para 1 */
-		shft = 12 + offs;
-		rval = config->dram_para1;
-		rval &= ~(0xf << shft);
-		rval |= j << shft;
-		config->dram_para1 = rval;
+		config->ranks[rank].bank_bits = j;
 
