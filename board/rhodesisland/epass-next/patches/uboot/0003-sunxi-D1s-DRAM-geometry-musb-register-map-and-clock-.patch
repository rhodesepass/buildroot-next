+		val |= (rank->bank_bits << 2) & 0x4; // bank - 2
+		val |= ((rank->row_bits - 1) << 4) & 0xff; // row - 1
 
 		// convert from page size to column addr width - 3
-		switch ((config->dram_para1 >> i) & 0xf) {
+		switch (rank->page_size & 0xf) {
 		case 8: val |= 0xa00; break;
 		case 4: val |= 0x900; break;
 		case 2: val |= 0x800; break;
@@ -675,7 +692,11 @@ static void mctl_phy_ac_remapping(const dram_para_t *para,
 		return;
 
 	if (para->dram_type == SUNXI_DRAM_TYPE_DDR2) {
-		if (fuse == 15)
