-/* SUNXI has different reg addresses, but identical r/w functions */
-#ifndef CONFIG_ARCH_SUNXI
+/*
+ * SUNXI has different reg addresses, but identical r/w functions.
+ *
+ * ARCH_SUNXI is ARM-only: the RISC-V sunxi SoCs (D1/D1s) declare BOARD_SUNXI
+ * instead. Testing only the former silently gives them the generic register
+ * map, so every access lands at the wrong offset -- POWER writes go to 0x01
+ * rather than 0x40 and read back as zero, the controller is never actually
+ * configured, and the gadget enumerates at full speed and then answers
