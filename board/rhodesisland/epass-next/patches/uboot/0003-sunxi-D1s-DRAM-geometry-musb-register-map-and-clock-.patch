+		config->ranks[rank].row_bits = i;
 
 		if (rank == 1)		/* Set bank mode for rank0 */
 			clrsetbits_le32(0x3102000, 0xffc, 0x6a4);
@@ -1108,9 +1123,19 @@ static int auto_scan_dram_size(const dram_para_t *para, dram_config_t *config)
 		/* Set bank mode for current rank */
 		clrsetbits_le32(mc_work_mode, 0xffc, 0x6a4);
 		udelay(1);
-
-		// Test if bit A23 is BA2 or mirror XXX A22?
-		chk = CFG_SYS_SDRAM_BASE + (1U << 22);
+		/* the probe below reads back what was written above */
+		flush_dcache_all();
+
+		/*
+		 * Test whether the line above the column address is BA2 or a
