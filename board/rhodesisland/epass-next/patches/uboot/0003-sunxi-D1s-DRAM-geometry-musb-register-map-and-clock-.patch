diff --git a/drivers/ram/sunxi/dram_sun20i_d1.h b/drivers/ram/sunxi/dram_sun20i_d1.h
index 83ae7eb3..73624e6c 100644
--- a/drivers/ram/sunxi/dram_sun20i_d1.h
+++ b/drivers/ram/sunxi/dram_sun20i_d1.h
@@ -66,9 +66,21 @@ typedef struct dram_para {
 	const u32	dram_tpr12;
 } dram_para_t;
 
+/*
+ * Autodetected geometry, one entry per rank. Allwinner's boot0 packs this
+ * into the dram_para1 bitfield (page size in bits 0-3, rows in 4-11, banks in
+ * 12-15, second rank in the upper half); unpacking it makes the scanning code
+ * in auto_scan_dram_size() readable and the rank comparison exact.
+ */
+struct rank_para {
+	u16 page_size;
+	u8 row_bits;
+	u8 bank_bits;
+};
+
 typedef struct dram_config {
 	/* control configuration */
-	u32	dram_para1;
+	struct rank_para ranks[2];
 	u32	dram_para2;
 	/* contains a bitfield of DRAM setup settings */
 	u32	dram_tpr13;
diff --git a/drivers/usb/musb-new/musb_regs.h b/drivers/usb/musb-new/musb_regs.h
