diff --git a/drivers/ram/sunxi/Kconfig b/drivers/ram/sunxi/Kconfig
index 1775cb0d..d0240c07 100644
--- a/drivers/ram/sunxi/Kconfig
+++ b/drivers/ram/sunxi/Kconfig
@@ -1,17 +1,41 @@
+# No prompt: on ARM this is selected by MACH_SUN8I_R528, on RISC-V it is the
+# only DRAM controller there is.
 config DRAM_SUN20I_D1
 	bool
-	depends on ARCH_SUNXI
+	depends on ARCH_SUNXI || BOARD_SUNXI
+	default BOARD_SUNXI
 	help
 	  This enables support for the DRAM controller driver covering
-	  the Allwinner D1/R528/T113s SoCs.
+	  the Allwinner D1/D1s/R528/T113s SoCs.
 
 if DRAM_SUN20I_D1
 
+# arch/arm/mach-sunxi/Kconfig defines both of these, but only under ARCH_SUNXI,
+# so they are invisible to the RISC-V build. Keep the type (int) identical to
+# that definition, otherwise Kconfig reports a type clash while parsing.
+config DRAM_CLK
+	int "DRAM clock frequency in MHz"
+	depends on BOARD_SUNXI
+	default 792
+
+config DRAM_ZQ
+	int "DRAM ZQ calibration value"
+	depends on BOARD_SUNXI
+	# 0x007b7bfb, matching the driver's own fallback
+	default 8092667
+
 config DRAM_SUNXI_ODT_EN
 	hex "DRAM ODT EN parameter"
 	help
 	  ODT EN value from vendor DRAM settings.
 
+config DRAM_SUNXI_MR1
+	hex "DRAM MR1 parameter"
+	default 0x42
+	help
+	  MR1 value from vendor DRAM settings. The DDR3 default (0x42) is what
+	  the driver used to hardcode; in-package DDR2 typically wants 0x2.
+
 config DRAM_SUNXI_TPR0
 	hex "DRAM TPR0 parameter"
 	help
