From: shirogane <artoriapendragon123@gmail.com>
Subject: [PATCH 2/5] sunxi: allow the drivers to build on BOARD_SUNXI

Fourteen driver Kconfigs gate sunxi support on ARCH_SUNXI, which is an ARM
symbol. Accept BOARD_SUNXI as well so the RISC-V build can reach the same
drivers. No behavioural change for ARM: mangopi_mq_r and Cubietruck both
show zero savedefconfig drift.
---
diff --git a/drivers/clk/sunxi/Kconfig b/drivers/clk/sunxi/Kconfig
index 1c1cc827..b9127236 100644
--- a/drivers/clk/sunxi/Kconfig
+++ b/drivers/clk/sunxi/Kconfig
@@ -1,6 +1,6 @@
 config CLK_SUNXI
 	bool "Clock support for Allwinner SoCs"
-	depends on CLK && ARCH_SUNXI
+	depends on CLK && (ARCH_SUNXI || BOARD_SUNXI)
 	select DM_RESET
 	select SPL_DM_RESET if SPL_CLK
 	default y
@@ -89,7 +89,7 @@ config CLK_SUN8I_H3
 
 config CLK_SUN20I_D1
 	bool "Clock driver for Allwinner D1"
-	default MACH_SUN8I_R528
+	default MACH_SUN8I_R528 || TARGET_SUN20I_D1
 	help
 	  This enables common clock driver support for platforms based
 	  on Allwinner D1 SoC.
