From: shirogane <artoriapendragon123@gmail.com>
Subject: [PATCH 6/6] spi: sunxi: read the SPI NAND on four lanes

The boot partition read is the single biggest item in the boot: 8M at the
2.7MB/s a single lane at 50MHz delivers is three seconds of staring at the
UART. The controller has had quad support all along -- Linux drives it that
way on this very board -- but U-Boot's driver only implements xfer(), so the
spi-mem core flattens every operation into single-lane transfers and the
spinand layer never selects the x4 variants.

Give the driver mem_ops: supports_op admits single-lane and quad-data
operations (dual would need the DRM bit, nothing asks for it), and exec_op
runs the header single-lane and the data phase with BCC's quad-enable bit
set, counters programmed per burst exactly the way Linux's spi-sun6i does.
The whole op runs with DHB set: the controller captures MISO into the RX
FIFO even during a transmit burst (which is why the xfer path drains after
every burst, send-only ones included), so without DHB the header's echo
lands in front of the data bytes and every read comes back shifted.
Variants without a burst control register (sun4i) keep an all-zero quad bit
and therefore refuse quad ops; their single-lane exec_op path programs the
same registers the old xfer path did.

The dts side of this -- the quad pin groups (PC6/PC7 joining as IO2/IO3)
and the 40MHz cap -- lives in the board directory dts, not in this patch;
the reasoning is commented there. The SPL is unaffected -- its loader muxes
PC2..PC5 itself and reads single-lane.
---
diff --git a/drivers/spi/spi-sunxi.c b/drivers/spi/spi-sunxi.c
index 7702f85e..e28103b2 100644
--- a/drivers/spi/spi-sunxi.c
+++ b/drivers/spi/spi-sunxi.c
@@ -22,6 +22,7 @@
 #include <dm.h>
 #include <log.h>
 #include <spi.h>
+#include <spi-mem.h>
 #include <errno.h>
 #include <fdt_support.h>
 #include <reset.h>
@@ -82,6 +83,9 @@
 #define SUN4I_SPI_DEFAULT_RATE		1000000
 #define SUN4I_SPI_TIMEOUT_MS		1000
 
+/* opcode, up to 8 address bytes, up to 8 dummy bytes */
+#define SUN4I_SPI_HDR_BYTES		(1 + 8 + 8)
+
 /*
  * Mod clock register, for the variants whose divider sits in the CCU rather
  * than in the SPI block. Same layout as every other sunxi peripheral clock:
@@ -134,9 +138,11 @@ enum sun4i_spi_bits {
 	SPI_TCR_CS_LEVEL,
 	SPI_TCR_SDC,
 	SPI_TCR_SDM,
+	SPI_TCR_DHB,
 	SPI_FCR_TF_RST,
 	SPI_FCR_RF_RST,
 	SPI_FSR_RF_CNT_MASK,
+	SPI_BCTL_QUAD_EN,
 };
 
 struct sun4i_spi_variant {
@@ -515,6 +521,167 @@ static int sun4i_spi_xfer(struct udevice *dev, unsigned int bitlen,
 	return 0;
 }
 
+/*
+ * spi-mem, which is what the SPI NAND actually talks. Without exec_op the
+ * core flattens every operation into single-lane spi_xfer()s, so the read
+ * path never leaves one bit per clock no matter what the flash, the pads and
+ * the dts offer. This exec_op programs the burst counters the way Linux's
+ * spi-sun6i does per transfer: MBC counts every byte on the wire, MTC the
+ * ones transmitted, and BCC either the single-lane transmit count or the
+ * quad-enable bit -- the controller then runs the whole burst on four lanes,
+ * which is why the header and the data go out as separate bursts.
+ */
+
+/*
+ * One burst of at most fifo_depth-1 bytes, polled, CS untouched -- the same
+ * counter discipline as sun4i_spi_xfer, but run with DHB set: the controller
+ * captures MISO into the RX FIFO during a transmit burst (that is why the
+ * xfer path drains after every burst, even send-only ones), and here a header
+ * burst's echo would sit in front of the data burst's bytes. DHB makes the
+ * hardware discard the echo instead. A receive burst keeps MTC at zero so the
+ * controller does not drive MOSI while the flash owns the lanes.
+ */
+static int sun4i_spi_mem_burst(struct udevice *bus, u32 nbytes, bool quad)
+{
+	struct sun4i_spi_priv *priv = dev_get_priv(bus);
+	u32 bctl;
+	int ret;
+
+	writel(SUN4I_BURST_CNT(nbytes), SPI_REG(priv, SPI_BC));
+	writel(SUN4I_XMIT_CNT(priv->tx_buf ? nbytes : 0), SPI_REG(priv, SPI_TC));
+
+	if (priv->variant->has_burst_ctl) {
+		if (quad)
+			bctl = SPI_BIT(priv, SPI_BCTL_QUAD_EN);
+		else
+			bctl = SUN4I_BURST_CNT(priv->tx_buf ? nbytes : 0);
+		writel(bctl, SPI_REG(priv, SPI_BCTL));
+	}
+
+	if (priv->tx_buf)
+		sun4i_spi_fill_fifo(priv, nbytes);
+
+	setbits_le32(SPI_REG(priv, SPI_TCR), SPI_BIT(priv, SPI_TCR_XCH));
+
+	ret = wait_for_bit_le32((const void *)SPI_REG(priv, SPI_TCR),
+				SPI_BIT(priv, SPI_TCR_XCH),
+				false, SUN4I_SPI_TIMEOUT_MS, false);
+	if (ret < 0)
+		return ret;
+
+	if (priv->rx_buf)
+		sun4i_spi_drain_fifo(priv, nbytes);
+
+	return 0;
+}
+
+static int sun4i_spi_mem_phase(struct udevice *bus, const u8 *tx, u8 *rx,
+			       u32 len, bool quad)
+{
+	struct sun4i_spi_priv *priv = dev_get_priv(bus);
+	u32 nbytes;
+	int ret;
+
+	priv->tx_buf = tx;
+	priv->rx_buf = rx;
+
+	while (len) {
+		nbytes = min(len, priv->variant->fifo_depth - 1);
+
+		ret = sun4i_spi_mem_burst(bus, nbytes, quad);
+		if (ret)
+			return ret;
+
+		len -= nbytes;
+	}
+
+	return 0;
+}
+
+static int sun4i_spi_mem_exec_op(struct spi_slave *slave,
+				 const struct spi_mem_op *op)
+{
+	struct udevice *bus = slave->dev->parent;
+	struct sun4i_spi_priv *priv = dev_get_priv(bus);
+	struct dm_spi_slave_plat *slave_plat = dev_get_parent_plat(slave->dev);
+	bool quad = op->data.buswidth == 4;
+	u8 hdr[SUN4I_SPI_HDR_BYTES];
+	u32 rst, val, hlen = 0;
+	int ret;
+	int i;
+
+	hdr[hlen++] = op->cmd.opcode;
+	for (i = op->addr.nbytes - 1; i >= 0; i--)
+		hdr[hlen++] = op->addr.val >> (8 * i);
+	for (i = 0; i < op->dummy.nbytes; i++)
+		hdr[hlen++] = 0xff;
+
+	/* Reset FIFOs */
+	rst = SPI_BIT(priv, SPI_FCR_RF_RST) | SPI_BIT(priv, SPI_FCR_TF_RST);
+	setbits_le32(SPI_REG(priv, SPI_FCR), rst);
+	ret = readl_poll_timeout(SPI_REG(priv, SPI_FCR), val, !(rst & val), 20);
+	if (ret)
+		return -EBUSY;
+
+	/* Half-duplex for the whole op; the xfer path stays full-duplex. */
+	setbits_le32(SPI_REG(priv, SPI_TCR), SPI_BIT(priv, SPI_TCR_DHB));
+
+	sun4i_spi_set_cs(bus, slave_plat->cs[0], true);
+
+	/* The command, address and dummy bytes always go out single-lane. */
+	ret = sun4i_spi_mem_phase(bus, hdr, NULL, hlen, false);
+
+	if (!ret && op->data.nbytes) {
+		if (op->data.dir == SPI_MEM_DATA_IN)
+			ret = sun4i_spi_mem_phase(bus, NULL, op->data.buf.in,
+						  op->data.nbytes, quad);
+		else
+			ret = sun4i_spi_mem_phase(bus, op->data.buf.out, NULL,
+						  op->data.nbytes, quad);
+	}
+
+	sun4i_spi_set_cs(bus, slave_plat->cs[0], false);
+
+	clrbits_le32(SPI_REG(priv, SPI_TCR), SPI_BIT(priv, SPI_TCR_DHB));
+
+	if (ret < 0)
+		printf("ERROR: sun4i_spi: Timeout transferring data\n");
+
+	return ret;
+}
+
+static bool sun4i_spi_mem_supports_op(struct spi_slave *slave,
+				      const struct spi_mem_op *op)
+{
+	struct sun4i_spi_priv *priv = dev_get_priv(slave->dev->parent);
+
+	if (!spi_mem_default_supports_op(slave, op))
+		return false;
+
+	if (op->cmd.buswidth != 1 ||
+	    (op->addr.nbytes && op->addr.buswidth != 1) ||
+	    (op->dummy.nbytes && op->dummy.buswidth != 1))
+		return false;
+
+	if (1 + op->addr.nbytes + op->dummy.nbytes > SUN4I_SPI_HDR_BYTES)
+		return false;
+
+	/* Dual would need the DRM bit programmed; nothing here asks for it. */
+	if (op->data.nbytes && op->data.buswidth != 1 &&
+	    op->data.buswidth != 4)
+		return false;
+
+	if (op->data.buswidth == 4 && !SPI_BIT(priv, SPI_BCTL_QUAD_EN))
+		return false;
+
+	return true;
+}
+
+static const struct spi_controller_mem_ops sun4i_spi_mem_ops = {
+	.supports_op		= sun4i_spi_mem_supports_op,
+	.exec_op		= sun4i_spi_mem_exec_op,
+};
+
 static int sun4i_spi_set_speed(struct udevice *dev, uint speed)
 {
 	struct sun4i_spi_priv *priv = dev_get_priv(dev);
@@ -544,6 +711,7 @@ static const struct dm_spi_ops sun4i_spi_ops = {
 	.claim_bus		= sun4i_spi_claim_bus,
 	.release_bus		= sun4i_spi_release_bus,
 	.xfer			= sun4i_spi_xfer,
+	.mem_ops		= &sun4i_spi_mem_ops,
 	.set_speed		= sun4i_spi_set_speed,
 	.set_mode		= sun4i_spi_set_mode,
 };
@@ -610,9 +778,12 @@ static const u32 sun4i_spi_bits[] = {
 	[SPI_TCR_CS_MASK]	= 0x3000,
 	[SPI_TCR_CS_MANUAL]	= BIT(16),
 	[SPI_TCR_CS_LEVEL]	= BIT(17),
+	[SPI_TCR_DHB]		= BIT(15),
 	[SPI_FCR_TF_RST]	= BIT(8),
 	[SPI_FCR_RF_RST]	= BIT(9),
 	[SPI_FSR_RF_CNT_MASK]	= GENMASK(6, 0),
+	/* no burst control register, so no quad mode either */
+	[SPI_BCTL_QUAD_EN]	= 0,
 };
 
 static const unsigned long sun6i_spi_regs[] = {
@@ -640,10 +811,12 @@ static const u32 sun6i_spi_bits[] = {
 	[SPI_TCR_CS_LEVEL]	= BIT(7),
 	[SPI_TCR_SDC]		= BIT(11),
 	[SPI_TCR_SDM]		= BIT(13),
+	[SPI_TCR_DHB]		= BIT(8),
 	[SPI_TCR_XCH]		= BIT(31),
 	[SPI_FCR_RF_RST]	= BIT(15),
 	[SPI_FCR_TF_RST]	= BIT(31),
 	[SPI_FSR_RF_CNT_MASK]	= GENMASK(7, 0),
+	[SPI_BCTL_QUAD_EN]	= BIT(29),
 };
 
 static const struct sun4i_spi_variant sun4i_a10_spi_variant = {
@@ -679,17 +852,7 @@ static const struct sun4i_spi_variant sun50i_r329_spi_variant = {
 	.has_burst_ctl		= true,
 };
 
-/*
- * Same block as the R329, but with the mod clock filled in. Kept as its own
- * entry rather than added to the R329 variant because the CCU layout around
- * it is per-SoC, and D1 is the one that has been measured.
- *
- * 0x940 is SPI0's mod clock specifically, so this variant must never bind to
- * SPI1 (whose clock is 0x944). It does not: D1's SPI1 is the DBI-capable
- * block, and its dts node is compatible with "allwinner,sun20i-d1-spi-dbi"
- * and the R329 strings, never with the "allwinner,sun20i-d1-spi" matched
- * below. Adding an instance here means revisiting that.
- */
+/* D1 module clocks are instance-specific; SPI1 also exposes DBI. */
 static const struct sun4i_spi_variant sun20i_d1_spi_variant = {
 	.regs			= sun6i_spi_regs,
 	.bits			= sun6i_spi_bits,
@@ -700,6 +863,16 @@ static const struct sun4i_spi_variant sun20i_d1_spi_variant = {
 	.max_rate		= 100000000,
 };
 
+static const struct sun4i_spi_variant sun20i_d1_spi1_variant = {
+	.regs			= sun6i_spi_regs,
+	.bits			= sun6i_spi_bits,
+	.fifo_depth		= 64,
+	.has_soft_reset		= true,
+	.has_burst_ctl		= true,
+	.mod_clk_off		= 0x944,
+	.max_rate		= 100000000,
+};
+
 static const struct udevice_id sun4i_spi_ids[] = {
 	{
 	  .compatible = "allwinner,sun4i-a10-spi",
@@ -717,6 +890,10 @@ static const struct udevice_id sun4i_spi_ids[] = {
 	  .compatible = "allwinner,sun20i-d1-spi",
 	  .data = (ulong)&sun20i_d1_spi_variant,
 	},
+	{
+	  .compatible = "allwinner,sun20i-d1-spi-dbi",
+	  .data = (ulong)&sun20i_d1_spi1_variant,
+	},
 	{
 	  .compatible = "allwinner,sun50i-r329-spi",
 	  .data = (ulong)&sun50i_r329_spi_variant,
