# U-Boot environment for the Arknights ePass Next (D1s).
#
# Compiled in, never written back: CONFIG_ENV_IS_NOWHERE. What makes one board
# different from another comes from the bootenv partition instead -- a short
# env.txt naming the revision and the panel, imported below. Keeping the real
# environment read-only means a board's identity lives in one place and a
# stray "saveenv" cannot damage it.

# Widen the bootm arena to the full 64MB so lmb relocates the dtb to the top
# of DRAM, leaving one contiguous hole big enough for the kernel's cma=40M.
# Only half the fix: CONFIG_STACK_SIZE in uboot.config is the other half --
# with its 16MB default the top of DRAM is walled off as U-Boot stack and the
# dtb still ends up mid-DRAM (~0x42cb5000), splitting the free memory.
bootm_size=0x4000000

# Structure follows the prev-generation F1C boards, minus the SD path (no
# card slot fitted, though the boot type is reserved for it).

# One scratch address for both FITs, as on the F1C boards: the dtbs bundle is
# read there, the trees are extracted out of it to dtbaddr, and then the
# kernel FIT is read over the top. That makes the order in bootcmd load
# bearing -- loaddtbs must finish extracting before loadkernel runs.
fitaddr=0x41000000
dtbaddr=0x42000000
dtboaddr=0x42200000
envtxtaddr=0x42400000

# The splash framebuffer: 720x1280 RGB565 is 0x1c8000 bytes, ending at
# 0x43cc8000 -- below U-Boot's relocation area at the top of DRAM and above
# everything bootm writes. srgn_splash reserves it in lmb (so the relocated
# dtb avoids it) and as /reserved-memory (so the kernel does), then describes
# it in /chosen as a simple-framebuffer; simpledrm keeps the logo on screen
# for the whole boot, until preinit loads the sun4i DRM modules right before
# the app starts. The 1.8M stays reserved after that -- the price of doing
# the handover with zero kernel patches.
fbaddr=0x43b00000

# Where the two FITs sit inside the boot partition. Offsets are relative to
# the partition, so the MTD layer's bad-block skipping keeps them true --
# unlike the F1C boards, which address the raw device and therefore have to
# scan for the kernel FIT header.
dtbsoff=0x0
kerneloff=0x100000

# Driver model probes on demand, and nothing has asked for the SPI NAND by the
# time bootcmd runs, so the partitions do not exist yet -- "MTD device boot not
# found". Listing them is what forces the probe.
#
# Not "mtd list > /dev/null": U-Boot has no redirection, so the > and the path
# are just two more arguments, argc exceeds the subcommand's maxargs, and the
# whole thing turns into a usage dump before it probes anything. It printed a
# screenful every boot and did nothing. There is no way to silence a U-Boot
# command, and the device list is worth reading during bring-up anyway.
mtdinit=mtd list

# --- the Mostima flashing mailbox -------------------------------------------
#
# The host flasher inits DRAM over FEL, leaves a header here, then loads and
# runs this U-Boot from DRAM. mstmchk reads it into mstm_ret (boot type) and
# mstm_flags. Layout is in cmd/mstmchk.c; keep this address in step with
# CONFIG_MSTMCHK_ADDR, which is where the reasoning for the value lives.
mstmaddr=0x40100000

# Header fields are addressed off mstmaddr rather than spelled out again:
# +0xc is the u32 env length, +0x10 the env text.
mstm_env=setexpr mstm_a ${mstmaddr} + c; \
    setexpr.l mstm_envlen *${mstm_a}; \
    setexpr mstm_p ${mstmaddr} + 10; \
    if itest ${mstm_envlen} -gt 0x2000; then \
        echo "mstm: env payload is ${mstm_envlen} bytes, refusing"; \
    else \
        mw.b ${envtxtaddr} 0xff 0x2000; \
        cp.b ${mstm_p} ${envtxtaddr} ${mstm_envlen}; \
        mtd erase bootenv; \
        mtd write bootenv ${envtxtaddr} 0x0 0x2000; \
        env import -t ${envtxtaddr} 0x2000; \
    fi

# flags byte (mailbox +0x9):
#   bit0  wipe user data -- normal flashing leaves the data partition alone,
#         which is what makes a full reflash a data-preserving upgrade.
#   bit1  full-chip force erase and bad block rescan. Wipes factory bad block
#         markers along with everything else and lets them be rediscovered
#         from the erase results. Implies bit0, so the two are exclusive here.
#         Unlike the F1C generation this needs no patch: 2026.07's
#         nanddev_erase() already drops the BBT entry and erases anyway, and a
#         block whose erase fails keeps its on-chip marker, so the table
#         rebuilds itself correctly on the next attach.
# hush has no elif, hence the nesting.
mstm_prep=setexpr mstm_f ${mstm_flags} '&' 2; \
    if itest ${mstm_f} -eq 2; then \
        echo "mstm: full-chip force erase, bad blocks will be rediscovered"; \
        mtd erase.dontskipbad spi-nand0; \
    else \
        setexpr mstm_f ${mstm_flags} '&' 1; \
        if itest ${mstm_f} -eq 1; then \
            echo "mstm: erasing the data partition"; \
            mtd erase data; \
        fi; \
    fi

# Clearing just the magic is enough, and it is what stops a plain reboot from
# walking back into the flashing path. Two stores because mw has no 64-bit
# form here.
mstm_clear=mw.l ${mstmaddr} 0; \
    setexpr mstm_a ${mstmaddr} + 4; \
    mw.l ${mstm_a} 0

# Partition numbers, not names: dfu_fill_entity_mtd() indexes the partition
# list. 1 boot0, 2 uboot, 3 bootenv, 4 boot, 5 rootfs, 6 data. bootenv is not
# offered -- it comes from the mailbox, so the flasher cannot disagree with
# the identity it just declared. data is not offered either: it belongs to the
# user, and mstm_prep is the only thing allowed to touch it.
enterdfu=setenv dfu_alt_info "spl part 1;uboot part 2;boot part 4;rootfs partubi 5"; \
    dfu 0 mtd spi-nand0

# No pre-erase: the MTD backend erases each block before writing it, and for
# the partubi entry it erases the rest of the partition on flush. Erasing here
# as well would just double the wear and the wait.
rundfu=echo "mstm: DFU up -- expecting spl, uboot, boot, rootfs"; \
    run enterdfu; \
    echo "mstm: DFU done"

# Reset rather than carrying on into the system that was just written. The
# U-Boot running here came in over FEL, and that leaves the SoC measurably
# different from a normal boot: with identical CCU registers (PLL_CPU
# 0xfa002900, CPU_AXI_CFG 0x300) a 300M memcpy takes 0.75s here against 0.29s
# after a cold boot, which is the signature of DRAM running uncached -- the
# return-to-FEL path restores mstatus and friends, and the C906's cache and
# memory-attribute CSRs are not ordinary architectural state. Booting on from
# here would hand the user a system running at a third of its speed until the
# first power cycle. The reset costs about two seconds.
mstmflash=run mstm_prep; run mstm_env; run mstm_clear; run rundfu; \
    echo "mstm: flashed, restarting"; reset

# The identity blob. Not fatal if it is missing: a freshly flashed board with
# an erased bootenv still has to reach a prompt so it can be told who it is.
loadenvtxt=if mtd read bootenv ${envtxtaddr}; then \
        env import -t ${envtxtaddr} 0x2000; \
    fi; \
    if test -z "${device_rev}"; then \
        echo "no device_rev in bootenv, using default"; \
        setenv device_rev n0.2; \
    fi; \
    if test -z "${screen}"; then setenv screen boe_035; fi

# Boot type 1 is the NAND flow. 2 is reserved for the SD flow and deliberately
# keeps the number the F1C generation gave it, so one flasher speaks to both
# generations; this board has no card slot fitted yet. 0, or no mailbox at
# all, is an ordinary boot -- so the mailbox costs a normal boot one memory
# read.
#
# mstmflash returns after DFU rather than resetting, and bootcmd carries on
# into the tree it just wrote: the board comes up on the new system without a
# power cycle, and the env it boots with is the one out of the mailbox.
load1env=mstmchk; \
    if itest ${mstm_ret} -eq 1; then run mstmflash; fi; \
    if itest ${mstm_ret} -eq 2; then \
        echo "mstm: SD flashing not implemented on this board"; \
    fi; \
    run loadenvtxt

# --- booting ----------------------------------------------------------------

# Both FITs are read in two steps: one page for the header, then exactly
# totalsize bytes. mkimage without -E keeps the payloads inside the blob, so
# totalsize is the whole file (the boot log confirms it: data starts at
# fitaddr+0xc0), and "mtd read" rounds an odd length up to a page by itself.
# Reading the slot instead would cost real time at NAND speed: the kernel FIT
# is ~3M in a 9M slot, so the fixed-size read spent two thirds of its three
# seconds on blank flash. The size is clamped to the slot so a corrupt header
# that still passes the magic check cannot send the read past it -- the
# fixed-size read could never do that, and this keeps it true.
#
# Pull the base tree for this revision out of the bundle, then layer the
# screen over it, then any interface and extension overlays the identity asks
# for. fdt apply needs __symbols__ in the base, which mkdt.sh puts there.
loaddtbs=mtd read boot ${fitaddr} ${dtbsoff} 0x800; \
    if fdt addr ${fitaddr}; then true; else \
        echo "dtbs bundle unreadable"; run failsafe; \
    fi; \
    fdt header get fitsize totalsize; \
    if itest ${fitsize} -gt 0x100000; then \
        echo "dtbs bundle claims ${fitsize} bytes, over its 1M slot"; \
        run failsafe; \
    else \
        mtd read boot ${fitaddr} ${dtbsoff} ${fitsize}; \
    fi; \
    if imxtract ${fitaddr} fdt-base-${device_rev} ${dtbaddr}; then true; else \
        echo "no base tree for revision ${device_rev}"; run failsafe; \
    fi; \
    fdt addr ${dtbaddr}; fdt resize 65536

applyscreen=if imxtract ${fitaddr} fdt-screen-${screen} ${dtboaddr}; then \
        fdt apply ${dtboaddr}; \
    else \
        echo "no overlay for screen ${screen}, leaving headless"; \
    fi

# Space-separated lists, normally set from env.txt. Absent means none.
applyiface=for ov in ${interface}; do \
        echo "interface ${ov}"; \
        imxtract ${fitaddr} fdt-iface-${ov} ${dtboaddr}; \
        fdt apply ${dtboaddr}; \
    done
applyext=for ov in ${ext}; do \
        echo "ext ${ov}"; \
        imxtract ${fitaddr} fdt-ext-${ov} ${dtboaddr}; \
        fdt apply ${dtboaddr}; \
    done

# The boot logo. Runs while the dtbs bundle is still at fitaddr (loadkernel
# reads over it), and after the overlays -- srgn_splash reads the panel
# timing and init sequence the screen overlay just merged into the tree at
# dtbaddr. imxtract gunzips the RGB565 logo straight to fbaddr. Any failure
# (no logo for this screen, no panel properties) just skips the splash; the
# command also writes the simple-framebuffer handover nodes into dtbaddr.
splash=if imxtract ${fitaddr} logo-${screen} ${fbaddr}; then \
        srgn_splash ${dtbaddr} ${fbaddr}; \
    fi

# Same two-step read as loaddtbs. The slot runs from kerneloff to the end of
# the 10M boot partition, hence the 0x900000 ceiling.
loadkernel=mtd read boot ${fitaddr} ${kerneloff} 0x800; \
    if fdt addr ${fitaddr}; then true; else \
        echo "kernel FIT unreadable"; run failsafe; \
    fi; \
    fdt header get fitsize totalsize; \
    if itest ${fitsize} -gt 0x900000; then \
        echo "kernel FIT claims ${fitsize} bytes, over its slot"; \
        run failsafe; \
    else \
        mtd read boot ${fitaddr} ${kerneloff} ${fitsize}; \
    fi

# ro root: the rootfs volume is a read-only UBIFS, and preinit turns it into
# the lower half of an overlay whose upper lives on the data partition. The
# order of the two ubi.mtd= is what makes rootfs ubi0 and data ubi1.
setbootargs=setenv bootargs "earlycon=sbi console=ttyS3,115200n8 \
clk_ignore_unused pd_ignore_unused cma=36M panic=0 rootwait ro \
root=ubi0:rootfs rootfstype=ubifs ubi.mtd=rootfs ubi.mtd=data \
ubi.fm_autoconvert=1 init=/preinit ${extracmd}"

# Anything that fails on the way to a kernel lands here. Dropping to the
# prompt rather than resetting is deliberate: a board that reboot-loops is
# harder to rescue than one sitting still, and this one has a FEL button.
failsafe=echo "*** boot failed -- stopping at the prompt ***"; exit 1

bootcmd=run mtdinit; run load1env; \
    echo "ePass Next rev ${device_rev}, screen ${screen}"; \
    run loaddtbs; run applyscreen; run applyiface; run applyext; \
    run splash; \
    run loadkernel; run setbootargs; \
    bootm ${fitaddr} - ${dtbaddr}

# No countdown. abortboot() still polls for a pending character once even at
# zero, so holding a key from power-on drops to the prompt as before -- and
# failing that there is the FEL button. The second the countdown spent doing
# nothing was the single largest non-I/O item in the boot.
bootdelay=0
