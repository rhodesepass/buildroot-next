# CONFIG_AIO is not set
# CONFIG_IO_URING is not set
# CONFIG_CACHESTAT_SYSCALL is not set
CONFIG_KALLSYMS=y
CONFIG_PROFILING=y
CONFIG_ARCH_SUNXI=y
CONFIG_NONPORTABLE=y
CONFIG_RISCV_TUNE_THEAD_C906=y
CONFIG_RISCV_ISA_V=y
# We knowingly ship GhostWrite-vulnerable userspace vector (single-user
# device, no untrusted code); keeping the errata off preserves xtheadvector.
# CONFIG_ERRATA_THEAD_GHOSTWRITE is not set
# CONFIG_RISCV_ISA_VENDOR_EXT_ANDES is not set
# CONFIG_RISCV_ISA_VENDOR_EXT_MIPS is not set
# CONFIG_RISCV_ISA_VENDOR_EXT_SIFIVE is not set
# CONFIG_COMPAT is not set
# CONFIG_EFI is not set
CONFIG_CPU_IDLE=y
CONFIG_RISCV_SBI_CPUIDLE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPUFREQ_DT=y
CONFIG_JUMP_LABEL=y
# CONFIG_STRICT_KERNEL_RWX is not set
# CONFIG_GCC_PLUGINS is not set
# CONFIG_MQ_IOSCHED_KYBER is not set
# CONFIG_IOSCHED_BFQ is not set
CONFIG_CMA=y
# CONFIG_SECRETMEM is not set
CONFIG_NET=y
CONFIG_UNIX=y
